#!/usr/bin/awk -f
# Claude: this script is largely written by Claude (24 September 2026).
#
# gen-arm64-cpucaps-for-lem.awk: from the kernel's arch/arm64/tools/cpucaps (one
# capability name per line, in numbering order, comments and blanks
# ignored; the kernel's own gen-cpucaps.awk numbers them the same way)
# generate a Lem module with an enumerated type of the cpucaps and the
# functions to map them to and from their numbers and names, and to and
# from the kernel's bitmap representation.
#
# Usage: awk -f gen-arm64-cpucaps-for-lem.awk -v source="<commit or path>" cpucaps > generated_arm64_cpucaps.lem

/^$/ { next }
/^#/ { next }

BEGIN {
  n = 0
}

/^[vA-Z0-9_]+$/ {
  caps[n++] = $0
  next
}

{
  print "gen-arm64-cpucaps-for-lem.awk: unexpected line " NR ": " $0 > "/dev/stderr"
  exit 1
}

END {
  print "(* Claude: generated by linksem/etc_linux/gen-arm64-cpucaps-for-lem/gen-arm64-cpucaps-for-lem.awk"
  print "   from the Linux kernel's arch/arm64/tools/cpucaps" (source != "" ? " (" source ")" : "") "; do not edit."
  print ""
  print "   The arm64 CPU capabilities (cpucaps): the kernel numbers them in the"
  print "   order of that file (gen-cpucaps.awk), keeps the detected set in the bitmap"
  print "   system_cpucaps of ARM64_NCAPS bits, and names them ARM64_<name>.  Here:"
  print "   an enumerated type, the number and name of each, the kernel bitmap as a"
  print "   list of 64-bit words, and cpucaps as an association list of (cap, bool). *)"
  print ""
  print "open import Basic_classes"
  print "open import Bool"
  print "open import Maybe"
  print "open import Num"
  print "open import String"
  print "open import List"
  print "open import Elf_types_native_uint"
  print ""
  print "type cpucap ="
  for (i = 0; i < n; i++) printf("  %s ARM64_%s\n", (i == 0 ? " " : "|"), caps[i])
  print ""
  printf("val arm64_ncaps : natural\nlet arm64_ncaps = %d\n\n", n)
  print "val all_cpucaps : list cpucap"
  print "let all_cpucaps ="
  printf("  [")
  for (i = 0; i < n; i++) printf("%sARM64_%s", (i == 0 ? "" : "; "), caps[i])
  print "]"
  print ""
  print "val cpucap_number : cpucap -> natural"
  print "let cpucap_number c ="
  print "  match c with"
  for (i = 0; i < n; i++) printf("  | ARM64_%s -> %d\n", caps[i], i)
  print "  end"
  print ""
  print "val string_of_cpucap : cpucap -> string"
  print "let string_of_cpucap c ="
  print "  match c with"
  for (i = 0; i < n; i++) printf("  | ARM64_%s -> \"ARM64_%s\"\n", caps[i], caps[i])
  print "  end"
  print ""
  print "val cpucap_of_number : natural -> maybe cpucap"
  print "let cpucap_of_number n = List.index all_cpucaps (natFromNatural n)"
  print ""
  print "val cpucap_of_string : string -> maybe cpucap"
  print "let cpucap_of_string s = List.find (fun c -> string_of_cpucap c = s) all_cpucaps"
  print ""
  print "(* the detected set, as an association list over every cpucap *)"
  print "type cpucaps = list (cpucap * bool)"
  print ""
  print "val cpucap_present : cpucaps -> cpucap -> bool"
  print "let cpucap_present cs c = match List.lookup c cs with Just b -> b | Nothing -> false end"
  print ""
  print "(* the kernel's DECLARE_BITMAP(system_cpucaps, ARM64_NCAPS): unsigned long words, bit n is cap n *)"
  print "val cpucaps_of_bitmap : list elf64_xword -> cpucaps"
  print "let cpucaps_of_bitmap words ="
  print "  List.map (fun c ->"
  print "      let n = cpucap_number c in"
  print "      let bit = match List.index words (natFromNatural (n / 64)) with"
  print "                | Just w -> (natural_of_elf64_xword w / (2 ** natFromNatural (n mod 64))) mod 2"
  print "                | Nothing -> 0"
  print "                end in"
  print "      (c, bit = 1)) all_cpucaps"
  print ""
  print "val bitmap_of_cpucaps : cpucaps -> list elf64_xword"
  print "let bitmap_of_cpucaps cs ="
  print "  List.map (fun w ->"
  print "      elf64_xword_of_natural"
  print "        (List.foldl (fun acc c -> if cpucap_present cs c && cpucap_number c / 64 = w"
  print "                                  then acc + 2 ** natFromNatural (cpucap_number c mod 64) else acc)"
  print "                    0 all_cpucaps))"
  print "    (List.genlist naturalFromNat (natFromNatural ((arm64_ncaps + 63) / 64)))"
  print ""
  print "(* the flag name under which a cpucap appears in a Symbolic_resolution environment *)"
  print "val cpucap_flag_name : cpucap -> string"
  print "let cpucap_flag_name c = \"cpucap:\" ^ string_of_cpucap c"
  print ""
  print "val boot_cpucap_flag_name : cpucap -> string"
  print "let boot_cpucap_flag_name c = \"boot_cpucap:\" ^ string_of_cpucap c"
}

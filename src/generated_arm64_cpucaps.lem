val cpucap_of_number : natural -> maybe cpucap
let cpucap_of_number n = List.index all_cpucaps (natFromNatural n)

val cpucap_of_string : string -> maybe cpucap
let cpucap_of_string s = List.find (fun c -> string_of_cpucap c = s) all_cpucaps

(* the detected set, as an association list over every cpucap *)
type cpucaps = list (cpucap * bool)

val cpucap_present : cpucaps -> cpucap -> bool
let cpucap_present cs c = match List.lookup c cs with Just b -> b | Nothing -> false end

(* the kernel's DECLARE_BITMAP(system_cpucaps, ARM64_NCAPS): unsigned long words, bit n is cap n *)
val cpucaps_of_bitmap : list elf64_xword -> cpucaps
let cpucaps_of_bitmap words =
  List.map (fun c ->
      let n = cpucap_number c in
      let bit = match List.index words (natFromNatural (n / 64)) with
                | Just w -> (natural_of_elf64_xword w / (2 ** natFromNatural (n mod 64))) mod 2
                | Nothing -> 0
                end in
      (c, bit = 1)) all_cpucaps

val bitmap_of_cpucaps : cpucaps -> list elf64_xword
let bitmap_of_cpucaps cs =
  List.map (fun w ->
      elf64_xword_of_natural
        (List.foldl (fun acc c -> if cpucap_present cs c && cpucap_number c / 64 = w
                                  then acc + 2 ** natFromNatural (cpucap_number c mod 64) else acc)
                    0 all_cpucaps))
    (List.genlist naturalFromNat (natFromNatural ((arm64_ncaps + 63) / 64)))

(* the flag name under which a cpucap appears in a Symbolic_resolution environment *)
val cpucap_flag_name : cpucap -> string
let cpucap_flag_name c = "cpucap:" ^ string_of_cpucap c

val boot_cpucap_flag_name : cpucap -> string
let boot_cpucap_flag_name c = "boot_cpucap:" ^ string_of_cpucap c

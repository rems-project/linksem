(* Claude: DWARF 5 unit types (table 7.2) *)
let unit_type_encodings : list (string * sym_natural) = [
  ("DW_UT_compile",       sym_natural_of_hex "0x01");
  ("DW_UT_type",          sym_natural_of_hex "0x02");
  ("DW_UT_partial",       sym_natural_of_hex "0x03");
  ("DW_UT_skeleton",      sym_natural_of_hex "0x04");
  ("DW_UT_split_compile", sym_natural_of_hex "0x05");
  ("DW_UT_split_type",    sym_natural_of_hex "0x06")
]
let vDW_UT_type = sym_natural_of_hex "0x02"
let vDW_UT_skeleton = sym_natural_of_hex "0x04"
let vDW_UT_split_compile = sym_natural_of_hex "0x05"
let vDW_UT_split_type = sym_natural_of_hex "0x06"

let pp_unit_type_encoding (ut: sym_natural) : string =
  match List.find (fun (_, n) -> n = ut) unit_type_encodings with
  | Just (s, _) -> s
  | Nothing -> "unknown unit type " ^ show ut
  end


(* operation encoding *)

(* Claude: helpers for the signed operations of DWARF 4 section 2.5.1.4/5: a stack
   value viewed as a two's complement integer, and truncating signed division on
   stack values.  Signed comparison results and quotients are pushed back as
   stack values (unsigned, modulo 2^bitwidth). *)
let stack_value_signed (ac: arithmetic_context) (v: sym_natural) : sym_integer =
  if v < ac.ac_half || not ac.ac_signed then symIntegerFromNatural v else symIntegerFromNatural v - symIntegerFromNatural ac.ac_all

let stack_value_of_bool (b: bool) : sym_natural = if b then 1 else 0

(* Claude: the C remainder (the sign of the dividend), for DW_OP_mod on a signed base
   type: DWARF 5 does not specify the signedness of DW_OP_mod, and gdb computes the
   type's remainder there (the generic type's modulus stays unsigned) *)
let stack_value_signed_rem (ac: arithmetic_context) (v1: sym_natural) (v2: sym_natural) : maybe sym_natural =
  if v2 = 0 then Nothing else
  let neg1 = v1 >= ac.ac_half in
  let neg2 = v2 >= ac.ac_half in
  let a1 = if neg1 then ac.ac_all - v1 else v1 in
  let a2 = if neg2 then ac.ac_all - v2 else v2 in
  let r = a1 mod a2 in
  Just (if neg1 && r <> 0 then ac.ac_all - r else r)

(* v1 / v2 truncating toward zero, as gdb and C do; Nothing for division by zero *)
let stack_value_signed_div (ac: arithmetic_context) (v1: sym_natural) (v2: sym_natural) : maybe sym_natural =
  if v2 = 0 then Nothing else
  if not ac.ac_signed then Just (v1 / v2) else   (* Claude: unsigned base types divide unsigned *)
  let neg1 = v1 >= ac.ac_half in
  let neg2 = v2 >= ac.ac_half in
  let a1 = if neg1 then ac.ac_all - v1 else v1 in
  let a2 = if neg2 then ac.ac_all - v2 else v2 in
  let q = a1 / a2 in
  Just (if neg1 <> neg2 then (ac.ac_all - q) mod ac.ac_all else q)

let operation_encodings = [
("DW_OP_addr",                sym_natural_of_hex "0x03", [OAT_addr]                 , OpSem_lit); (*1*) (*constant address (size target specific)*)
("DW_OP_deref",               sym_natural_of_hex "0x06", []                         , OpSem_deref); (*0*)
("DW_OP_const1u",             sym_natural_of_hex "0x08", [OAT_uint8]                , OpSem_lit); (*1*) (* 1-byte constant  *)
("DW_OP_const1s",             sym_natural_of_hex "0x09", [OAT_sint8]                , OpSem_lit); (*1*) (* 1-byte constant  *)
("DW_OP_const2u",             sym_natural_of_hex "0x0a", [OAT_uint16]               , OpSem_lit); (*1*) (* 2-byte constant  *)
("DW_OP_const2s",             sym_natural_of_hex "0x0b", [OAT_sint16]               , OpSem_lit); (*1*) (* 2-byte constant  *)
("DW_OP_const4u",             sym_natural_of_hex "0x0c", [OAT_uint32]               , OpSem_lit); (*1*) (* 4-byte constant  *)
("DW_OP_const4s",             sym_natural_of_hex "0x0d", [OAT_sint32]               , OpSem_lit); (*1*) (* 4-byte constant  *)
("DW_OP_const8u",             sym_natural_of_hex "0x0e", [OAT_uint64]               , OpSem_lit); (*1*) (* 8-byte constant  *)
("DW_OP_const8s",             sym_natural_of_hex "0x0f", [OAT_sint64]               , OpSem_lit); (*1*) (* 8-byte constant  *)
("DW_OP_constu",              sym_natural_of_hex "0x10", [OAT_ULEB128]              , OpSem_lit); (*1*) (* ULEB128 constant *)
("DW_OP_consts",              sym_natural_of_hex "0x11", [OAT_SLEB128]              , OpSem_lit); (*1*) (* SLEB128 constant *)
("DW_OP_dup",                 sym_natural_of_hex "0x12", []                         , OpSem_stack (fun ac vs args -> match vs with v::vs -> Just (v::v::vs) | _ -> Nothing end)); (*0*)
("DW_OP_drop",                sym_natural_of_hex "0x13", []                         , OpSem_stack (fun ac vs args -> match vs with v::vs -> Just vs | _ -> Nothing end)); (*0*)
("DW_OP_over",                sym_natural_of_hex "0x14", []                         , OpSem_stack (fun ac vs args -> match vs with v::v'::vs -> Just (v'::v::v'::vs) | _ -> Nothing end)); (*0*)
("DW_OP_pick",                sym_natural_of_hex "0x15", [OAT_uint8]                , OpSem_stack (fun ac vs args -> match args with [OAV_natural n] -> match index_sym_natural vs n with Just v -> Just (v::vs) | Nothing -> Nothing end | _ -> Nothing end)); (*1*) (* 1-byte stack index *)
("DW_OP_swap",                sym_natural_of_hex "0x16", []                         , OpSem_stack (fun ac vs args -> match vs with v::v'::vs -> Just (v'::v::vs) | _ -> Nothing end)); (*0*)
("DW_OP_rot",                 sym_natural_of_hex "0x17", []                         , OpSem_stack (fun ac vs args -> match vs with v::v'::v''::vs -> Just (v'::v''::v::vs) | _ -> Nothing end)); (*0*)
("DW_OP_xderef",              sym_natural_of_hex "0x18", []                         , OpSem_not_supported); (*0*)
("DW_OP_abs",                 sym_natural_of_hex "0x19", []                         , OpSem_unary (fun ac v -> if v < ac.ac_half || not ac.ac_signed then Just v else Just (ac.ac_all-v))); (*0*) (* Claude: the absolute value of the most negative value is unrepresentable (DWARF 4: undefined); like gdb and lldb we wrap, giving the value itself *)
("DW_OP_and",                 sym_natural_of_hex "0x1a", []                         , OpSem_binary (fun ac v1 v2 -> Just (sym_natural_land v1 v2))); (*0*)
("DW_OP_div",                 sym_natural_of_hex "0x1b", []                         , OpSem_binary (fun ac v1 v2 -> stack_value_signed_div ac v1 v2)); (*0*) (* Claude: signed, truncating; division by zero fails, as in gdb and lldb *)
("DW_OP_minus",               sym_natural_of_hex "0x1c", []                         , OpSem_binary (fun ac v1 v2 -> Just (partialSymNaturalFromInteger ((symIntegerFromNatural v1 - symIntegerFromNatural v2) mod (symIntegerFromNatural ac.ac_all))))); (*0*)
("DW_OP_mod",                 sym_natural_of_hex "0x1d", []                         , OpSem_binary (fun ac v1 v2 -> if v2 = 0 then Just v1 else if ac.ac_signed && not ac.ac_generic then stack_value_signed_rem ac v1 v2 else Just (v1 mod v2))); (*0*) (* Claude: unsigned (section 2.5.1.4's default arithmetic); DWARF 4 does not specify modulo by zero and gdb returns the dividend, which we follow (lldb fails) *)
("DW_OP_mul",                 sym_natural_of_hex "0x1e", []                         , OpSem_binary (fun ac v1 v2 -> Just (partialSymNaturalFromInteger ((symIntegerFromNatural v1 * symIntegerFromNatural v2) mod (symIntegerFromNatural ac.ac_all))))); (*0*)
("DW_OP_neg",                 sym_natural_of_hex "0x1f", []                         , OpSem_unary (fun ac v -> Just ((ac.ac_all - v) mod ac.ac_all))); (*0*) (* Claude: two's complement negation; for 0 and for the most negative value (DWARF 4: undefined) this wraps to the value itself, as gdb and lldb do *)
("DW_OP_not",                 sym_natural_of_hex "0x20", []                         , OpSem_unary (fun ac v -> Just (sym_natural_lxor v ac.ac_max))); (*0*)
("DW_OP_or",                  sym_natural_of_hex "0x21", []                         , OpSem_binary (fun ac v1 v2 -> Just (sym_natural_lor v1 v2))); (*0*)
("DW_OP_plus",                sym_natural_of_hex "0x22", []                         , OpSem_binary (fun ac v1 v2 -> Just ((v1 + v2) mod ac.ac_all))); (*0*)
("DW_OP_plus_uconst",         sym_natural_of_hex "0x23", [OAT_ULEB128]              , OpSem_stack (fun ac vs args -> match args with [OAV_natural n] -> match vs with (v,t)::vs' -> let v' = (v+n) mod ac.ac_all in Just ((v',t)::vs')  | [] -> Nothing end  | _ -> Nothing end)); (*1*) (* ULEB128 addend *)
("DW_OP_shl",                 sym_natural_of_hex "0x24", []                         , OpSem_binary (fun ac v1 v2 -> if v2 >= ac.ac_bitwidth then Just 0 else Just ((sym_natural_nat_shift_left v1 (natFromSymNatural v2)) mod ac.ac_all))); (*0*)
("DW_OP_shr",                 sym_natural_of_hex "0x25", []                         , OpSem_binary (fun ac v1 v2 -> if v2 >= ac.ac_bitwidth then Just 0 else Just (sym_natural_nat_shift_right v1 (natFromSymNatural v2)))); (*0*)
("DW_OP_shra",                sym_natural_of_hex "0x26", []                         , OpSem_binary (fun ac v1 v2 -> if v1 < ac.ac_half then (if v2 >= ac.ac_bitwidth then Just 0 else Just (sym_natural_nat_shift_right v1 (natFromSymNatural v2))) else (if v2 >= ac.ac_bitwidth then Just ac.ac_max  else Just (ac.ac_max - (sym_natural_nat_shift_right (ac.ac_max - v1) (natFromSymNatural v2)))))); (*0*)
("DW_OP_xor",                 sym_natural_of_hex "0x27", []                         , OpSem_binary (fun ac v1 v2 -> Just (sym_natural_lxor v1 v2))); (*0*)
("DW_OP_skip",                sym_natural_of_hex "0x2f", [OAT_sint16]               , OpSem_skip); (*1*) (* signed 2-byte constant *)
("DW_OP_bra",                 sym_natural_of_hex "0x28", [OAT_sint16]               , OpSem_bra); (*1*) (* signed 2-byte constant *)
("DW_OP_eq",                  sym_natural_of_hex "0x29", []                         , OpSem_binary (fun ac v1 v2 -> Just (stack_value_of_bool (stack_value_signed ac v1 = stack_value_signed ac v2)))); (*0*) (* Claude: the six comparisons are signed (section 2.5.1.5) *)
("DW_OP_ge",                  sym_natural_of_hex "0x2a", []                         , OpSem_binary (fun ac v1 v2 -> Just (stack_value_of_bool (stack_value_signed ac v1 >= stack_value_signed ac v2)))); (*0*)
("DW_OP_gt",                  sym_natural_of_hex "0x2b", []                         , OpSem_binary (fun ac v1 v2 -> Just (stack_value_of_bool (stack_value_signed ac v1 > stack_value_signed ac v2)))); (*0*)
("DW_OP_le",                  sym_natural_of_hex "0x2c", []                         , OpSem_binary (fun ac v1 v2 -> Just (stack_value_of_bool (stack_value_signed ac v1 <= stack_value_signed ac v2)))); (*0*)
("DW_OP_lt",                  sym_natural_of_hex "0x2d", []                         , OpSem_binary (fun ac v1 v2 -> Just (stack_value_of_bool (stack_value_signed ac v1 < stack_value_signed ac v2)))); (*0*)
("DW_OP_ne",                  sym_natural_of_hex "0x2e", []                         , OpSem_binary (fun ac v1 v2 -> Just (stack_value_of_bool (stack_value_signed ac v1 <> stack_value_signed ac v2)))); (*0*)
("DW_OP_lit0",                sym_natural_of_hex "0x30", []                         , OpSem_opcode_lit (sym_natural_of_hex "0x30")); (*0*) (* literals 0..31 =(DW_OP_lit0 + literal) *)

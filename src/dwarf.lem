val bigunionListMap : forall 'a 'b. SetType 'b => ('a -> set 'b) -> list 'a -> set 'b
let rec bigunionListMap f xs =
  match xs with
  | [] -> {}
  | x::xs' -> Set.(union) (f x)  (bigunionListMap f xs')
  end

let rec mytake' (n:natural) acc xs =
  match (n,xs) with
  | (0, _) -> Just (List.reverse acc, xs)
  | (_, []) -> Nothing
  | (_, x::xs') -> mytake' (n-1) (x::acc) xs'
  end

val mytake : forall 'a.  sym_natural -> (list 'a) -> maybe (list 'a * list 'a)
let mytake n xs = mytake' (sym_natural_expect_const n (*"mytake"*)) [] xs

val mynth : forall 'a.  sym_natural -> (list 'a) -> maybe 'a
let rec mynth (n:sym_natural) xs =
  match (sym_natural_expect_const n (*"mynth"*),xs) with
  | (0, x::xs') -> Just x
  | (0, []) -> Nothing (*Assert_extra.failwith "mynth"*)
  | (_, x::xs') -> mynth (n-1) xs'
  end


(** basic pretty printing *)

let pphexplain n = unsafe_hex_string_of_natural 0 n
let pphex n = "0x" ^ pphexplain n

let pphexplain_sym = sym_natural_pp pphexplain
let pphex_sym = sym_natural_pp pphex

val abs : integer -> natural
(*declare hol      target_rep function abs = `int_of_num` *)
declare ocaml    target_rep function abs = `Nat_big_num.abs`
(*declare isabelle target_rep function abs = `int`
declare coq      target_rep function abs n = (`Zpred` (`Zpos` (`P_of_succ_nat` n))) (* TODO: check*)
*)

let pphex_integer n = if n<0 then "-" ^ pphex (abs n) else pphex (abs n)

let ppbytes = sym_ppbytes

let rec ppbytes2 n bs =
  match sym_read_char bs with
    | Fail _ -> ""
    | Success (x,xs') -> "<" ^ pphex n ^ ">  " ^ show x ^ "\n" ^ ppbytes2 (n+1) xs'
  end

let rec ppbytesplain (c:p_context) (n:sym_natural) bs = show (natural_of_bytes c.endianness bs)
(*
  unsafe_hex_string_of_uc_list (List.map unsigned_char_of_byte xs) (*match xs with | [] -> "" | x::xs' -> pphexplain x ^ ppbytesplain (n+1) xs' end*)
*)
  
(* workaround: from String *)
val mytoString : list char -> string
declare ocaml    target_rep function mytoString = `Xstring.implode`

let string_of_bytes bs = mytoString (List.map Missing_pervasives.char_of_byte bs)


let just_one s xs =
  match xs with
  | [] -> Assert_extra.failwith ("no " ^ s)
  | x1::x2::_ -> Assert_extra.failwith ("more than one " ^ s)
  | [x] -> x
  end




let max_address (as': sym_natural) : sym_natural =
  match sym_natural_expect_const as' (*"max_addres"*) with
  | 4 -> sym_natural_of_hex "0xffffffff"
  | 8 -> sym_natural_of_hex "0xffffffffffffffff"
  | _ -> Assert_extra.failwith "max_address size not 4 or 8"
  end

let range_address (as': sym_natural) : sym_natural =
  match sym_natural_expect_const as' (*"max_addres"*) with
  | 4 -> sym_natural_of_hex "0x100000000"
  | 8 -> sym_natural_of_hex "0x10000000000000000"
  | _ -> Assert_extra.failwith "range_address size not 4 or 8"
  end

   

(** lookup of encodings *)

val lookup_Ab_b : forall 'a 'b. Eq 'a => 'a -> list ('a * 'b) -> maybe 'b
let rec lookup_Ab_b x0 xys =
  match xys with
  | [] -> Nothing
  | (x,y)::xys' -> if x=x0 then Just y else lookup_Ab_b x0 xys'
  end

val lookup_aB_a : forall 'a 'b. Eq 'b => 'b -> list ('a * 'b) -> maybe 'a
let rec lookup_aB_a y0 xys =
  match xys with
  | [] -> Nothing
  | (x,y)::xys' -> if y=y0 then Just x else lookup_aB_a y0 xys'
  end


val lookup_aBc_a : forall 'a 'b 'c. Eq 'b => 'b -> list ('a * 'b * 'c) -> maybe 'a
let rec lookup_aBc_a y0 xyzs =
  match xyzs with
  | [] -> Nothing
  | (x,y,_)::xyzs' -> if y=y0 then Just x else lookup_aBc_a y0 xyzs'
  end

val lookup_aBc_ac : forall 'a 'b 'c. Eq 'b => 'b -> list ('a * 'b * 'c) -> maybe ('a*'c)
let rec lookup_aBc_ac y0 xyzs =
  match xyzs with
  | [] -> Nothing
  | (x,y,z)::xyzs' -> if y=y0 then Just (x,z) else lookup_aBc_ac y0 xyzs'
  end

val lookup_Abc_b : forall 'a 'b 'c. Eq 'a => 'a -> list ('a * 'b * 'c) -> maybe 'b
let rec lookup_Abc_b x0 xyzs =
  match xyzs with
  | [] -> Nothing
  | (x,y,_)::xyzs' -> if x=x0 then Just y else lookup_Abc_b x0 xyzs'
  end



val lookup_aBcd_a : forall 'a 'b 'c 'd. Eq 'b => 'b -> list ('a * 'b * 'c * 'd) -> maybe 'a
let rec lookup_aBcd_a y0 xyzws =
  match xyzws with
  | [] -> Nothing
  | (x,y,_,_)::xyzws' -> if y=y0 then Just x else lookup_aBcd_a y0 xyzws'
  end

val lookup_aBcd_acd : forall 'a 'b 'c 'd. Eq 'b => 'b -> list ('a * 'b * 'c * 'd) -> maybe ('a * 'c * 'd)
let rec lookup_aBcd_acd y0 xyzws =
  match xyzws with
  | [] -> Nothing
  | (x,y,z,w)::xyzws' -> if y=y0 then Just (x,z,w) else lookup_aBcd_acd y0 xyzws'
  end

val lookup_abCde_de : forall 'a 'b 'c 'd 'e. Eq 'c => 'c -> list ('a * 'b * 'c * 'd * 'e) -> maybe ('d * 'e)
let rec lookup_abCde_de z0 xyzwus =
  match xyzwus with
  | [] -> Nothing
  | (x,y,z,w,u)::xyzwus' -> if z=z0 then Just (w,u) else lookup_abCde_de z0 xyzwus'
  end


let pp_maybe ppf n = match ppf n with Just s -> s | Nothing -> "Unknown AT value: " ^ pphexplain_sym n (*encoding not found: "" ^ pphex n*) end

let pp_tag_encoding n = pp_maybe (fun n -> lookup_aB_a n tag_encodings) n
let pp_attribute_encoding n = pp_maybe (fun n -> lookup_aBc_a n attribute_encodings) n
let pp_attribute_form_encoding n = pp_maybe (fun n -> lookup_aBc_a n attribute_form_encodings) n
let pp_operation_encoding n = pp_maybe (fun n -> lookup_aBcd_a n operation_encodings) n

let tag_encode (s: string) : sym_natural =
  match lookup_Ab_b s tag_encodings with
  | Just n -> n
  | Nothing -> Assert_extra.failwith ("tag_encode: \""^s^"\"")
  end

let attribute_encode (s: string) : sym_natural =
  match lookup_Abc_b s attribute_encodings with
  | Just n -> n
  | Nothing -> Assert_extra.failwith ("attribute_encode: \""^s^"\"")
  end

let attribute_form_encode (s: string) : sym_natural =
  match lookup_Abc_b s attribute_form_encodings with
  | Just n -> n
  | Nothing -> Assert_extra.failwith "attribute_form_encode"
  end

let base_type_attribute_encode (s: string) : sym_natural =
  match lookup_Ab_b s base_type_attribute_encodings with
  | Just n -> n
  | Nothing -> Assert_extra.failwith "base_type_attribute_encode"
  end
   


(** ************************************************************ *)
(** **  parser combinators and primitives  ********************* *)
(** ************************************************************ *)

(* parsing combinators *)

type parse_context = <| pc_bytes: sym_byte_sequence; pc_offset: natural |>

type parse_result 'a =
  | PR_success of 'a * parse_context
  | PR_fail of string * parse_context

type parser 'a = parse_context -> parse_result 'a

let pp_parse_context pc = "pc_offset = " ^ pphex pc.pc_offset

let pp_parse_fail s pc =
  "Parse fail\n" ^ s ^ " at " ^ pp_parse_context pc ^ "\n"

let pp_parse_result ppa pr =
  match pr with
  | PR_success x pc -> "Parse success\n" ^ ppa x ^ "\n" ^ pp_parse_context pc ^ "\n"
  | PR_fail s pc -> pp_parse_fail s pc
  end

(* [(>>=)] should be the monadic binding function for [parse_result].  *)
(* but there's a type clash if we use >>=, and lem seems to output bad ocaml for >>>=. So we just use a non-infix version for now *)

val pr_bind : forall 'a 'b. parse_result 'a -> ('a -> parser 'b) -> parse_result 'b
let pr_bind x f =
  match x with
  | PR_success v pc -> f v pc
  | PR_fail err pc  -> PR_fail err pc
  end

val pr_return : forall 'a. 'a -> (parser 'a)
let pr_return x pc = PR_success x pc

val pr_map : forall 'a 'b. ('a -> 'b) -> parse_result 'a -> parse_result 'b
let pr_map f x =
  match x with
  | PR_success v pc -> PR_success (f v) pc
  | PR_fail err pc  -> PR_fail err pc
  end

val pr_map2 : forall 'a 'b. ('a -> 'b) -> (parser 'a) -> (parser 'b)
let pr_map2 f p = fun pc -> pr_map f (p pc)

val pr_post_map1 : forall 'a 'b. (parse_result 'a) -> ('a -> 'b) -> (parse_result 'b)
let pr_post_map1 x f = pr_map f x

(*
val pr_post_map : forall 'a 'b 'c. ('c -> parse_result 'a) -> ('a -> 'b) -> ('c -> parse_result 'b)
let pr_post_map g f = fun x ->  pr_map f (g x)
*)
val pr_post_map : forall 'a 'b. (parser 'a) -> ('a -> 'b) -> (parser 'b)
let pr_post_map p f = fun (pc: parse_context) -> pr_map f (p pc)


val pr_with_pos : forall 'a. (parser 'a) -> (parser (sym_natural * 'a))
let pr_with_pos p = fun pc -> pr_map (fun x -> (sym_natural_const pc.pc_offset,x)) (p pc)

(* Claude: n successive instances of a parser *)
let rec parse_replicate (n: natural) (p: parser 'a) : parser (list 'a) =
  fun (pc: parse_context) ->
    if n = 0 then PR_success [] pc
    else pr_bind (p pc) (fun x pc' -> pr_map (fun xs -> x :: xs) (parse_replicate (n - 1) p pc'))


val parse_pair : forall 'a 'b. (parser 'a) -> (parser 'b) -> (parser ('a * 'b))
let parse_pair p1 p2 =
  fun pc ->
    let _ = my_debug "pair " in
    pr_bind (p1 pc) (fun x pc' -> match p2 pc' with
    | PR_success y pc'' -> PR_success (x,y) pc''
    | PR_fail s pc'' -> PR_fail s pc''
    end)

val parse_triple : forall 'a 'b 'c. (parser 'a) -> (parser 'b) -> (parser 'c) -> parser ('a * ('b * 'c))
let parse_triple p1 p2 p3 =
  parse_pair p1 (parse_pair p2 p3)

val parse_quadruple : forall 'a 'b 'c 'd. (parser 'a) -> (parser 'b) -> (parser 'c) -> (parser 'd) -> parser ('a * ('b * ('c * 'd)))
let parse_quadruple p1 p2 p3 p4 =
  parse_pair p1 (parse_pair p2 (parse_pair p3 p4))

val parse_pentuple : forall 'a 'b 'c 'd 'e. (parser 'a) -> (parser 'b) -> (parser 'c) -> (parser 'd) -> (parser 'e) -> parser ('a * ('b * ('c * ('d * 'e))))
let parse_pentuple p1 p2 p3 p4 p5 =
  parse_pair p1 (parse_pair p2 (parse_pair p3 (parse_pair p4 p5)))

val parse_sextuple : forall 'a 'b 'c 'd 'e 'f. (parser 'a) -> (parser 'b) -> (parser 'c) -> (parser 'd) -> (parser 'e) -> (parser 'f) -> parser ('a * ('b * ('c * ('d * ('e * 'f)))))
let parse_sextuple p1 p2 p3 p4 p5 p6 =
  parse_pair p1 (parse_pair p2 (parse_pair p3 (parse_pair p4 (parse_pair p5 p6))))

val parse_dependent_pair : forall 'a 'b. (parser 'a) -> ('a -> parser 'b) -> (parser ('a * 'b))
let parse_dependent_pair p1 p2 =
  fun pc ->
    pr_bind (p1 pc) (fun x pc' -> match p2 x pc' with
    | PR_success y pc'' -> PR_success (x,y) pc''
    | PR_fail s pc'' -> PR_fail s pc''
    end)

val parse_dependent : forall 'a 'b. (parser 'a) -> ('a -> parser 'b) -> (parser 'b)
let parse_dependent p1 p2 =
  fun pc ->
    pr_bind (p1 pc) (fun x pc' -> p2 x pc')



val parse_list' : forall 'a. (parser (maybe 'a)) -> (list 'a -> parser (list 'a))
let rec parse_list' p1 =
  fun acc pc ->   let _ = my_debug "list' " in pr_bind (p1 pc) (fun mx pc' ->
    match mx with
    | Nothing -> PR_success acc pc'
    | Just x -> parse_list' p1 (x :: acc) pc'
    end)

val parse_list : forall 'a. (parser (maybe 'a)) -> (parser (list 'a))
let parse_list p1 =
  pr_post_map
    (parse_list' p1 [])
    (List.reverse)

(** Claude: [parse_list_tolerant p pc] is [parse_list p pc] that stops at a
  * parse failure instead of propagating it: the elements parsed before the
  * failure, and the failure's description if there was one.  readelf and
  * objdump print what they can of a corrupt section and warn about the rest;
  * this is the hook for the same policy. *)
val parse_list_tolerant : forall 'a. (parser (maybe 'a)) -> parse_context -> (list 'a * maybe string)
let rec parse_list_tolerant' p1 acc pc =
  match p1 pc with
  | PR_fail s pc' -> (List.reverse acc, Just (pp_parse_fail s pc'))
  | PR_success Nothing pc' -> (List.reverse acc, Nothing)
  | PR_success (Just x) pc' -> parse_list_tolerant' p1 (x :: acc) pc'
  end
let parse_list_tolerant p1 pc = parse_list_tolerant' p1 [] pc

val parse_parser_list : forall 'a. (list (parser 'a)) -> (parser (list 'a))
let rec parse_parser_list ps =
  match ps with
  | [] -> pr_return []
  | p::ps' ->
      (fun pc -> pr_bind (p pc) (fun x pc' ->
        match parse_parser_list ps' pc' with
        | PR_success xs pc'' -> PR_success (x::xs) pc''
        | PR_fail s pc'' -> PR_fail s pc''
        end))
  end

val parse_maybe : forall 'a. parser 'a -> parser (maybe 'a)
let parse_maybe p =
  fun pc ->
    match sym_bs_length pc.pc_bytes with
    | 0 -> pr_return Nothing pc
    | _ ->
        match p pc with
        | PR_success v pc'' -> PR_success (Just v) pc''
        | PR_fail s pc'' -> PR_fail s pc''
        end
    end

val parse_demaybe : forall 'a. string ->parser (maybe 'a) -> parser 'a
let parse_demaybe s p =
  fun pc ->
    match p pc with
        | PR_success (Just v) pc'' -> PR_success v pc''
        | PR_success (Nothing) pc'' -> PR_fail s pc''
        | PR_fail s pc'' -> PR_fail s pc''

    end


val parse_restrict_length : forall 'a. sym_natural -> parser 'a -> parser 'a
let parse_restrict_length n p =
  fun pc ->
    match sym_partition (sym_natural_expect_const n (*"parse_strict_length"*)) pc.pc_bytes with
    | Fail _ -> Assert_extra.failwith "parse_restrict_length not given enough bytes"
    | Success (xs,ys) ->
        let pc' = <| pc_bytes = xs; pc_offset = pc.pc_offset |> in
        p pc'
    end


(* parsing of basic types *)

let parse_byte : parser(byte) =
  fun (pc:parse_context) ->
    match sym_read_char pc.pc_bytes with
    | Fail _ -> PR_fail "parse_byte" pc
    | Success (b,bs) -> PR_success b (<|pc_bytes=bs; pc_offset= pc.pc_offset + 1 |> )
    end

let parse_n_bytes (n:sym_natural) : parser (sym_byte_sequence) =
  fun (pc:parse_context) ->
    match sym_partition (sym_natural_expect_const n (*"parse_n_bytes"*)) pc.pc_bytes with
      | Fail _ -> PR_fail ("parse_n_bytes n=" ^ pphex_sym n) pc
      | Success (xs,bs) ->
          PR_success xs (<|pc_bytes=bs; pc_offset= pc.pc_offset + (sym_bs_length xs) |> )
    end

let bzero = byte_of_natural 0

let parse_string : parser (sym_byte_sequence) =
  fun (pc:parse_context) ->
    match sym_find_byte pc.pc_bytes bzero with
      | Nothing -> PR_fail "parse_string" pc
      | Just n ->
          pr_bind (parse_n_bytes (sym_natural_const n) pc) (fun res pc -> (*todo find byte should respect relocs*)
          pr_bind (parse_byte pc) (fun _ pc ->
          pr_return res pc))
    end

(* parse a null-terminated string; return Nothing if it is empty, Just s otherwise *)
let parse_non_empty_string : parser (maybe sym_byte_sequence) =
  fun (pc:parse_context) ->
  pr_bind (parse_string pc) (fun str pc ->
    if sym_bs_length str = 0 then
      pr_return Nothing pc
    else
      pr_return (Just str) pc)


(* TODO relocations *)
let parse_uint8 : parser sym_natural=
  fun (pc:parse_context) ->
    let _ = my_debug "uint8 " in
    match sym_read_char pc.pc_bytes with
      | Success (b, bytes) ->
          let v = natural_of_byte b in
          PR_success (sym_natural_const v) (<| pc_bytes = bytes; pc_offset = pc.pc_offset + 1 |>)
      | _ -> PR_fail "parse_uint32 not given enough bytes" pc
    end

let parse_uint8_constant (v:sym_natural) : parser sym_natural=
    fun (pc:parse_context) ->
      let _ = my_debug "uint8_constant " in
      PR_success v pc

      
(* TODO relocations *)
let parse_uint16 c : parser sym_natural=
    fun (pc:parse_context) ->
      let _ = my_debug "uint16 " in
      match sym_read_2_bytes_be pc.pc_bytes with
      | Success ((b0,b1),bytes') ->
          let v = if c.endianness=Little then
            natural_of_byte b0 + 256*natural_of_byte b1
          else
            natural_of_byte b1 + 256*natural_of_byte b0 in
          PR_success (sym_natural_const v) (<| pc_bytes = bytes'; pc_offset = pc.pc_offset + 2 |>)
      | _ -> PR_fail "parse_uint32 not given enough bytes" pc
      end

(* TODO relocations *)
let parse_uint32 c : parser sym_natural=
    fun (pc:parse_context) ->
      let _ = my_debug "uint32 " in
      match sym_read_4_bytes_be_symbolic pc.pc_bytes with
      | Success (Bytes (b0,b1,b2,b3),bytes') ->
          let v = if c.endianness=Little then
            natural_of_byte b0 + 256*natural_of_byte b1 + 256*256*natural_of_byte b2 + 256*256*256*natural_of_byte b3
          else
            natural_of_byte b3 + 256*natural_of_byte b2 + 256*256*natural_of_byte b1 + 256*256*256*natural_of_byte b0 in
          PR_success (sym_natural_const v) (<| pc_bytes = bytes'; pc_offset = pc.pc_offset + 4 |>)
      | Success (Sym n, bytes') ->
          PR_success n (<| pc_bytes = bytes'; pc_offset = pc.pc_offset + 4 |>)
      | _ -> PR_fail "parse_uint32 not given enough bytes" pc
      end

(* TODO relocations *)
let parse_uint64 c : parser sym_natural=
    fun (pc:parse_context) ->
      let _ = my_debug "uint64 " in
      match sym_read_8_bytes_be_symbolic pc.pc_bytes with
      | Success (Bytes (b0,b1,b2,b3,b4,b5,b6,b7),bytes') -> (*TODO*)
          let v = if c.endianness=Little then
            natural_of_byte b0 + 256*natural_of_byte b1 + 256*256*natural_of_byte b2 + 256*256*256*natural_of_byte b3
              + (256*256*256*256*(natural_of_byte b4 + 256*natural_of_byte b5 + 256*256*natural_of_byte b6 + 256*256*256*natural_of_byte b7))
          else
            natural_of_byte b7 + 256*natural_of_byte b6 + 256*256*natural_of_byte b5 + 256*256*256*natural_of_byte b4
              + (256*256*256*256*(natural_of_byte b3 + 256*natural_of_byte b2 + 256*256*natural_of_byte b1 + 256*256*256*natural_of_byte b0))
          in
          PR_success (sym_natural_const v) (<| pc_bytes = bytes'; pc_offset = pc.pc_offset + 8 |>)
      | Success (Sym n, bytes') ->
          PR_success n (<| pc_bytes = bytes'; pc_offset = pc.pc_offset + 8 |>)
      | _ -> PR_fail "parse_uint64 not given enough bytes" pc
      end


let integerFromTwosComplementNatural (n:sym_natural) (half: sym_natural) (all:sym_integer) : sym_integer =
  if n < half then symIntegerFromNatural n else symIntegerFromNatural n - all

let partialTwosComplementNaturalFromInteger (i:sym_integer) (half: sym_natural) (all:sym_integer) : sym_natural =
  if i >=0 && i < symIntegerFromNatural half then partialSymNaturalFromInteger i
  else if i >= (0-symIntegerFromNatural half) && i < 0 then partialSymNaturalFromInteger (all + i)
  else Assert_extra.failwith "partialTwosComplementNaturalFromInteger"

let parse_sint8 : parser sym_integer =
  pr_post_map (parse_uint8) (fun n -> integerFromTwosComplementNatural n 128 256)

let parse_sint16 c : parser sym_integer =
  pr_post_map (parse_uint16 c) (fun n -> integerFromTwosComplementNatural n (128*256) (256*256))

let parse_sint32 c : parser sym_integer =
  pr_post_map (parse_uint32 c) (fun n -> integerFromTwosComplementNatural n (128*256*256*256) (256*256*256*256))

let parse_sint64 c : parser sym_integer =
  pr_post_map (parse_uint64 c) (fun n -> integerFromTwosComplementNatural n (128*256*256*256*256*256*256*256) (256*256*256*256*256*256*256*256))

let rec parse_ULEB128' (acc: natural) (shift_factor: natural) : parser natural =
    fun (pc:parse_context) ->
      let _ = my_debug "ULEB128' " in
      match sym_read_char pc.pc_bytes with
      | Success (b,bytes') ->
          let n = natural_of_byte b in
          let acc' = (natural_land n 127) * shift_factor + acc in
          let finished = ((natural_land n 128) = 0) in
          let pc' = <| pc_bytes = bytes'; pc_offset = pc.pc_offset + 1 |> in
          if finished then
            PR_success acc' pc'
          else
            parse_ULEB128' acc' (shift_factor * 128) pc'
      | _ ->
          PR_fail "parse_ULEB128' not given enough bytes" pc
      end

let parse_ULEB128 : parser sym_natural =
  fun (pc:parse_context) ->
   pr_map (fun x -> sym_natural_const x) (parse_ULEB128' 0 1 pc)

let rec parse_SLEB128' (acc: natural) (shift_factor: natural) : parser (bool * natural * natural) =
    fun (pc:parse_context) ->
      let _ = my_debug "SLEB128' " in
      match sym_read_char pc.pc_bytes with
      | Success (b,bytes') ->
          let n = natural_of_byte b in
          let acc' = acc + (natural_land n 127) * shift_factor in
          let shift_factor' = shift_factor * 128 in
          let finished = ((natural_land n 128) = 0) in
          let positive = ((natural_land n 64) = 0) in
          let pc' = <| pc_bytes = bytes'; pc_offset = pc.pc_offset + 1 |> in
          if finished then
            PR_success (positive, shift_factor', acc') pc'
          else
            parse_SLEB128' acc' shift_factor' pc'
      | _ ->
          PR_fail "parse_SLEB128' not given enough bytes" pc
      end

let parse_SLEB128 : parser sym_integer =
    pr_post_map (parse_SLEB128' 0 1) (fun (positive, shift_factor, acc) ->
      sym_integer_const (if positive then integerFromNatural acc else integerFromNatural acc - integerFromNatural shift_factor))

let parse_nonzero_ULEB128_pair : parser (maybe (sym_natural*sym_natural)) =
  let _ = my_debug "nonzero_ULEB128_pair " in
  pr_post_map
    (parse_pair parse_ULEB128 parse_ULEB128)
    (fun (n1,n2) -> if n1=0 && n2=0 then Nothing else Just (n1,n2))

let parse_zero_terminated_ULEB128_pair_list : parser (list (sym_natural*sym_natural)) =
  let _ = my_debug "zero_terminated_ULEB128_pair_list " in
  parse_list parse_nonzero_ULEB128_pair

let parse_uintDwarfN c (df: dwarf_format) : parser sym_natural =
    match df with
   | Dwarf32 -> (parse_uint32 c)
   | Dwarf64 -> (parse_uint64 c)
   end

(* Claude: a 3-byte unsigned integer (DW_FORM_strx3, DW_FORM_addrx3) *)
let parse_uint24 c : parser sym_natural =
  pr_map2 (fun bs -> sym_natural_const (natural_of_bytes c.endianness bs)) (parse_n_bytes 3)

let parse_uint_address_size c (as': sym_natural) : parser sym_natural =
    match sym_natural_expect_const as' (**"parse_uint_address_size"*) with
    | 4 -> (parse_uint32 c)
    | 8 -> (parse_uint64 c)
    | _ -> Assert_extra.failwith ("cuh_address_size not 4 or 8: " ^ show as')
    end

(* Claude: byte reads at a position of a section, for the DWARF 5 tables *)
let read_uintDwarfN_at c (df: dwarf_format) (bs: sym_byte_sequence) (pos: natural) : maybe sym_natural =
  match sym_dropbytes pos bs with
  | Fail _ -> Nothing
  | Success bs' ->
      match parse_uintDwarfN c df <| pc_bytes = bs'; pc_offset = pos |> with
      | PR_success n _ -> Just n
      | PR_fail _ _ -> Nothing
      end
  end

let read_address_at c (as': sym_natural) (bs: sym_byte_sequence) (pos: natural) : maybe sym_natural =
  match sym_dropbytes pos bs with
  | Fail _ -> Nothing
  | Success bs' ->
      match parse_uint_address_size c as' <| pc_bytes = bs'; pc_offset = pos |> with
      | PR_success n _ -> Just n
      | PR_fail _ _ -> Nothing
      end
  end

let offset_size (df: dwarf_format) : natural = match df with Dwarf32 -> 4 | Dwarf64 -> 8 end

(* Claude: an attribute specification (DWARF 5 section 7.5.3, errata 221114.1): the
   attribute and form as ULEB128s, then for DW_FORM_implicit_const the value as a
   SLEB128; (0, 0) ends the list *)
let parse_attribute_specification : parser (maybe attribute_specification) =
  fun (pc: parse_context) ->
    pr_bind (parse_ULEB128 pc) (fun at pc1 ->
    pr_bind (parse_ULEB128 pc1) (fun af pc2 ->
      if at = 0 && af = 0 then PR_success Nothing pc2
      else if af = attribute_form_encode "DW_FORM_implicit_const" then
        pr_bind (parse_SLEB128 pc2) (fun i pc3 ->
          PR_success (Just <| as_attribute = at; as_form = af; as_implicit_const = Just i |>) pc3)
      else
        PR_success (Just <| as_attribute = at; as_form = af; as_implicit_const = Nothing |>) pc2))

let parse_uint_segment_selector_size c (ss: sym_natural) : parser (maybe sym_natural) =
    match sym_natural_expect_const ss (*"parse_uint_segment_selector_size_size"*) with
    | 0 -> pr_return Nothing
    | 1 -> pr_post_map (parse_uint8)    (fun n -> Just n)
    | 2 -> pr_post_map (parse_uint16 c) (fun n -> Just n)
    | 4 -> pr_post_map (parse_uint32 c) (fun n -> Just n)
    | 8 -> pr_post_map (parse_uint64 c) (fun n -> Just n)
    | _ -> Assert_extra.failwith "cuh_address_size not 4 or 8"
    end



(** ************************************************************ *)
(** **  parsing and pretty printing of .debug_* sections  ****** *)
(** ************************************************************ *)


(** abbreviations table: pp and parsing *)

let pp_abbreviation_declaration (x:abbreviation_declaration) =
  "   "
  ^ show x.ad_abbreviation_code ^ "      "
  ^ pp_tag_encoding x.ad_tag ^ "    "
  ^ (if x.ad_has_children then "[has children]" else "[no children]")
  ^ "\n"
(*  ^ " "^show (List.length x.ad_attribute_specifications) ^ " attributes\n"*)
  ^ String.concat ""
      (List.map
         (fun (sp: attribute_specification) ->
           "    " ^ right_space_padded_to 18 (pp_attribute_encoding sp.as_attribute) ^ " " ^ pp_attribute_form_encoding sp.as_form
           ^ (match sp.as_implicit_const with Just i -> ": " ^ show i | Nothing -> "" end) ^ "\n")
         x.ad_attribute_specifications)
  ^ "    DW_AT value: 0     DW_FORM value: 0\n"

      
let pp_abbreviations_table (x:abbreviations_table) =
  "offset: "^pphex_sym x.at_offset^"\n"
  ^ String.concat "" (List.map (pp_abbreviation_declaration) x.at_table)

(* print the distinct abbreviation tables used by all compilation units *)
let rec remove_duplicates xys xys_acc =
  match xys with
  | [] -> List.reverse xys_acc
  | (x,y)::xys' ->
      if List.any (fun (x',y') -> x'=x) xys_acc then
        remove_duplicates xys' xys_acc
      else
        remove_duplicates xys' ((x,y)::xys_acc)
  end
  
let pp_abbreviations_tables (d:dwarf) = 
  let xs : list (sym_natural * abbreviations_table) =
    List.map
      (fun cu -> (cu.cu_header.cuh_debug_abbrev_offset, cu.cu_abbreviations_table)) 
      d.d_compilation_units in
  let ys = remove_duplicates xs [] in
  String.concat "*********************\n" (List.map (fun (x,y)->pp_abbreviations_table y) ys)
  


    
let parse_abbreviation_declaration c : parser (maybe abbreviation_declaration) =
    fun (pc: parse_context) ->
      pr_bind (parse_ULEB128 pc) (fun n1 pc' ->
        if n1 = 0 then
          PR_success Nothing pc'
        else
          pr_bind (parse_ULEB128 pc') (fun n2 pc'' ->
            pr_bind (parse_uint8 pc'') (fun c pc''' ->
              pr_post_map1
                (parse_list parse_attribute_specification pc''')
                (fun l ->
                  Just ( let ad =
                    <|
                    ad_abbreviation_code = n1;
                    ad_tag = n2;
                    ad_has_children = (c<>0);
                    ad_attribute_specifications = l;
                  |> in (* let _ = my_debug2 (pp_abbreviation_declaration ad) in *) ad)
                ))))

let parse_abbreviations_table c =
  parse_list (parse_abbreviation_declaration c)


(** debug_str entry *)

let rec null_terminated_bs (bs: sym_byte_sequence) : sym_byte_sequence =
  match sym_find_byte bs bzero with
  | Just i ->
      match sym_takebytes i bs with
        | Success bs' -> bs'
        | Fail _ -> Assert_extra.failwith "find_byte or take_byte is broken"
      end
  | Nothing -> bs
  end

let pp_debug_str_entry_bytes (str: maybe sym_byte_sequence) (n: sym_natural) : string =
  (* Claude: in a relocatable file a DW_FORM_strp value may be a relocation
     against an undefined symbol (a string-table label defined elsewhere);
     readelf and objdump use the addend, as the offset part here *)
  match str with
  | Nothing -> "<no .debug_str section>"   (* Claude: readelf's text *)
  | Just str' ->
      match sym_dropbytes (sym_natural_offset_part n) str' with
      | Fail _ -> "<offset is too big>"   (* Claude: readelf's text *)
      | Success bs -> string_of_sym_byte_sequence (null_terminated_bs bs)
      end
  end

let pp_debug_str_entry (str: unit_context) (n: sym_natural) : string =
  pp_debug_str_entry_bytes str.uc_sections.sec_str n

(* Claude: DWARF 5 indirections through the unit's base attributes *)

(* the .debug_line_str string at offset n *)
let line_strp_string (str: unit_context) (n: sym_natural) : string =
  match str.uc_sections.sec_line_str with
  | Nothing -> "<no .debug_line_str section>"
  | Just sec ->
      match sym_dropbytes (sym_natural_offset_part n) sec with
      | Fail _ -> "<offset is too big>"   (* Claude: readelf's text *)
      | Success bs -> string_of_sym_byte_sequence (null_terminated_bs bs)
      end
  end

(* the .debug_str offset of the unit's string index i: entry i of the string
   offsets table at DW_AT_str_offsets_base (section 7.26); in a relocatable file the
   entry is a relocation against .debug_str, whose offset part is the offset *)
let strx_offset (str: unit_context) (i: sym_natural) : maybe sym_natural =
  Map.lookup (sym_natural_offset_part i) str.uc_tables.ut_str_offsets

let strx_string (str: unit_context) (i: sym_natural) : string =
  (* the message texts are readelf's; the first also for a unit without a string
     offsets table *)
  match strx_offset str i with
  | Just off ->
      if sym_natural_offset_part off >= sym_bs_length (section_or_empty str.uc_sections.sec_str) then "<indirect index offset is too big>"
      else pp_debug_str_entry_bytes str.uc_sections.sec_str off
  | Nothing -> "<string index too big>"
  end

(* the address at the unit's address index i: entry i of the address table at
   DW_AT_addr_base (section 7.27); symbolic in a relocatable file, as DW_FORM_addr
   values are *)
let addrx_address (str: unit_context) (i: sym_natural) : maybe sym_natural =
  Map.lookup (sym_natural_offset_part i) str.uc_tables.ut_addrs

(* the section offset of list index i of a location or range list table: the base
   (DW_AT_loclists_base / DW_AT_rnglists_base, which points at the offset array) plus
   the ith entry of that array (sections 7.28 and 7.29) *)
let listx_offset (str: unit_context) (base: maybe sym_natural) (sec: sym_byte_sequence) (i: sym_natural) : maybe sym_natural =
  match base with
  | Nothing -> Nothing
  | Just b ->
      let df = str.uc_cuh.cuh_dwarf_format in
      let pos = sym_natural_offset_part b + sym_natural_offset_part i * offset_size df in
      match read_uintDwarfN_at str.uc_c df sec pos with
      | Just off -> Just (sym_natural_const (sym_natural_offset_part b + sym_natural_offset_part off))
      | Nothing -> Nothing
      end
  end

let loclistx_offset (str: unit_context) (i: sym_natural) : maybe sym_natural =
  listx_offset str str.uc_loclists_base (section_or_empty str.uc_sections.sec_loclists) i

let rnglistx_offset (str: unit_context) (i: sym_natural) : maybe sym_natural =
  listx_offset str str.uc_rnglists_base (section_or_empty str.uc_sections.sec_rnglists) i

(* an address-valued attribute: DW_FORM_addr, or DWARF 5's indexed forms *)
let address_of_attribute_value (str: unit_context) (av: attribute_value) : maybe sym_natural =
  match av with
  | AV_addr n -> Just n
  | AV_addrx i -> addrx_address str i
  | _ -> Nothing
  end

let unit_version (str: unit_context) : natural = sym_natural_offset_part str.uc_cuh.cuh_version

(** operations: pp and parsing *)

let pp_operation_argument_value (oav:operation_argument_value) : string =
  match oav with
  | OAV_natural n -> pphex_sym n
  | OAV_integer n -> sym_integer_pp pphex_integer n (* show n*)
  | OAV_block n bs -> pphex_sym n ^ " " ^ ppbytes bs
  end

let pp_operation_semantics (os: operation_semantics) : string =
  match os with
  | OpSem_lit                         -> "OpSem_lit"
  | OpSem_deref                       -> "OpSem_deref"
  | OpSem_stack _                     -> "OpSem_stack ..."
  | OpSem_not_supported               -> "OpSem_not_supported"
  | OpSem_binary _                    -> "OpSem_binary ..."
  | OpSem_unary _                     -> "OpSem_unary ..."
  | OpSem_opcode_lit _                -> "OpSem_opcode_lit ..."
  | OpSem_reg                         -> "OpSem_reg"
  | OpSem_breg                        -> "OpSem_breg"
  | OpSem_bregx                       -> "OpSem_bregx"
  | OpSem_fbreg                       -> "OpSem_fbreg"
  | OpSem_deref_size                  -> "OpSem_deref_size"
  | OpSem_nop                         -> "OpSem_nop"
  | OpSem_piece                       -> "OpSem_piece"
  | OpSem_bit_piece                   -> "OpSem_bitpiece"
  | OpSem_implicit_value              -> "OpSem_implicit_value"
  | OpSem_stack_value                 -> "OpSem_stack_value"
  | OpSem_call_frame_cfa              -> "OpSem_call_frame_cfa"
  | OpSem_skip                        -> "OpSem_skip"
  | OpSem_bra                         -> "OpSem_bra"
  | OpSem_addrx                       -> "OpSem_addrx"
  | OpSem_constx                      -> "OpSem_constx"
  | OpSem_const_type                  -> "OpSem_const_type"
  | OpSem_regval_type                 -> "OpSem_regval_type"
  | OpSem_deref_type                  -> "OpSem_deref_type"
  | OpSem_convert                     -> "OpSem_convert"
  | OpSem_reinterpret                 -> "OpSem_reinterpret"
  end

let pp_operation_semantics_brief (os: operation_semantics) : string =
  match os with
  | OpSem_not_supported               -> " (OpSem_not_supported)"
  | _ -> ""
  end
   
let pp_operation (op: operation) : string =
  op.op_string ^ (match op.op_argument_values with [] -> "" | _ -> " " ^ String.concat " " (List.map pp_operation_argument_value op.op_argument_values) end) ^ pp_operation_semantics_brief op.op_semantics 

let pp_operations (ops: list operation) : string =
  String.concat "; " (List.map pp_operation ops)

val parser_of_operation_argument_type : p_context -> compilation_unit_header -> operation_argument_type -> (parser operation_argument_value)
let parser_of_operation_argument_type c cuh oat =
  match oat with
    | OAT_addr ->
        pr_map2 (fun n -> OAV_natural n) (parse_uint_address_size c cuh.cuh_address_size)
    | OAT_dwarf_format_t ->
        pr_map2 (fun n -> OAV_natural n) (parse_uintDwarfN c cuh.cuh_dwarf_format)
    | OAT_uint8   -> pr_map2 (fun n -> OAV_natural n) (parse_uint8)
    | OAT_uint16  -> pr_map2 (fun n -> OAV_natural n) (parse_uint16 c)
    | OAT_uint32  -> pr_map2 (fun n -> OAV_natural n) (parse_uint32 c)
    | OAT_uint64  -> pr_map2 (fun n -> OAV_natural n) (parse_uint64 c)
    | OAT_sint8   -> pr_map2 (fun n -> OAV_integer n) (parse_sint8)
    | OAT_sint16  -> pr_map2 (fun n -> OAV_integer n) (parse_sint16 c)
    | OAT_sint32  -> pr_map2 (fun n -> OAV_integer n) (parse_sint32 c)
    | OAT_sint64  -> pr_map2 (fun n -> OAV_integer n) (parse_sint64 c)
    | OAT_ULEB128 -> pr_map2 (fun n -> OAV_natural n) parse_ULEB128
    | OAT_SLEB128 -> pr_map2 (fun n -> OAV_integer n) parse_SLEB128
    | OAT_block   ->
      (fun pc -> pr_bind (parse_ULEB128 pc) (fun n pc' ->
        pr_map (fun bs -> OAV_block n bs) (parse_n_bytes n pc')))
    | OAT_block1  ->
      (fun pc -> pr_bind (parse_uint8 pc) (fun n pc' ->
        pr_map (fun bs -> OAV_block n bs) (parse_n_bytes n pc')))
  end

val parse_operation : p_context -> compilation_unit_header -> parser (maybe operation)
let parse_operation c cuh pc =
  match parse_uint8 pc with
  | PR_fail s pc' -> PR_success Nothing pc
  | PR_success code pc' ->
      match lookup_aBcd_acd code operation_encodings with
      | Nothing -> PR_fail ("encoding not found: " ^ pphex_sym code) pc
      | Just (s,oats,opsem) ->
          let ps = List.map (parser_of_operation_argument_type c cuh) oats in
          (* Claude: record the operation's byte offsets, for the branch operations *)
          pr_bind (parse_parser_list ps pc') (fun oavs pc'' ->
            PR_success
              (Just <| op_code = code; op_string = s; op_argument_values = oavs; op_semantics = opsem;
                       op_offset = pc.pc_offset; op_end = pc''.pc_offset |>)
              pc'')
      end
  end

val parse_operations : p_context -> compilation_unit_header -> parser (list operation)
let parse_operations c cuh =
  parse_list (parse_operation c cuh)

let parse_operations_bs c cuh bs : list operation =
  let pc = <|pc_bytes = bs; pc_offset = 0  |> in
  match parse_operations c cuh pc with
  | PR_fail s pc' -> Assert_extra.failwith ("parse_operations_bs fail: " ^ pp_parse_fail s pc')
  | PR_success ops pc' ->
     let _ = if sym_bs_length pc'.pc_bytes <> 0 then Assert_extra.failwith ("parse_operations_bs extra non-parsed bytes") else () in
     ops
  end



val parse_and_pp_operations : p_context -> compilation_unit_header -> sym_byte_sequence -> string
let parse_and_pp_operations c cuh bs =
  let pc = <|pc_bytes = bs; pc_offset = 0  |> in
  match parse_operations c cuh pc with
  | PR_fail s pc' -> "parse_operations fail: " ^ pp_parse_fail s pc'
  | PR_success ops pc' ->
      pp_operations ops
      ^ if sym_bs_length pc'.pc_bytes <> 0 then " Warning: extra non-parsed bytes" else ""
  end


(** attribute values: pp and parsing *)

val pp_attribute_value_plain :  attribute_value -> string
let pp_attribute_value_plain av =
  match av with
  | AV_addr x -> "AV_addr " ^ pphex_sym x
  | AV_block n bs -> "AV_block " ^ show n ^ " " ^ ppbytes bs
  | AV_constantN n bs -> "AV_constantN " ^ show n ^ " " ^ ppbytes bs
  | AV_constant_SLEB128 i -> "AV_constant_SLEB128 " ^ show i
  | AV_constant_ULEB128 n -> "AV_constant_ULEB128 " ^ show n
  | AV_exprloc n bs ->
    String.concat " " ["AV_exprloc"; show n; ppbytes bs]
  | AV_flag b -> "AV_flag " ^ show b
  | AV_ref n -> "AV_ref " ^ pphex_sym n
  | AV_ref_addr n -> "AV_ref_addr " ^ pphex_sym n
  | AV_ref_sig8 n -> "AV_ref_sig8 " ^ pphex_sym n
  | AV_sec_offset n -> "AV_sec_offset " ^ pphex_sym  n
  | AV_string bs -> string_of_sym_byte_sequence bs
  | AV_strp n -> "AV_sec_offset " ^ pphex_sym n ^ " "
  | AV_strx n -> "AV_strx " ^ pphex_sym n
  | AV_addrx n -> "AV_addrx " ^ pphex_sym n
  | AV_line_strp n -> "AV_line_strp " ^ pphex_sym n
  | AV_data16 bs -> "AV_data16 " ^ ppbytes bs
  | AV_implicit_const i -> "AV_implicit_const " ^ show i
  | AV_loclistx n -> "AV_loclistx " ^ pphex_sym n
  | AV_rnglistx n -> "AV_rnglistx " ^ pphex_sym n
  | AV_ref_sup4 n -> "AV_ref_sup4 " ^ pphex_sym n
  | AV_ref_sup8 n -> "AV_ref_sup8 " ^ pphex_sym n
  | AV_strp_sup n -> "AV_strp_sup " ^ pphex_sym n
  end

   
val pp_attribute_value : p_context -> compilation_unit_header -> unit_context -> sym_natural (*attribute tag*) -> attribute_value -> string
let pp_attribute_value c cuh str at av =
  match av with
  | AV_addr x -> "AV_addr " ^ pphex_sym x
  | AV_block n bs -> "AV_block " ^ show n ^ " " ^ ppbytes bs
      ^ if at = attribute_encode "DW_AT_location" then " " ^ parse_and_pp_operations c cuh bs else ""
  | AV_constantN n bs -> "AV_constantN " ^ show n ^ " " ^ ppbytes bs
  | AV_constant_SLEB128 i -> "AV_constant_SLEB128 " ^ show i
  | AV_constant_ULEB128 n -> "AV_constant_ULEB128 " ^ show n
  | AV_exprloc n bs ->
    String.concat " " ["AV_exprloc"; show n; ppbytes bs; parse_and_pp_operations c cuh bs]
  | AV_flag b -> "AV_flag " ^ show b
  | AV_ref n -> "AV_ref " ^ pphex_sym n
  | AV_ref_addr n -> "AV_ref_addr " ^ pphex_sym n
  | AV_ref_sig8 n -> "AV_ref_sig8 " ^ pphex_sym n
  | AV_sec_offset n -> "AV_sec_offset " ^ pphex_sym  n
  | AV_string bs -> string_of_sym_byte_sequence bs
  | AV_strp n -> "AV_sec_offset " ^ pphex_sym n ^ " "
      ^ pp_debug_str_entry str n
  | AV_strx n -> "AV_strx " ^ pphex_sym n ^ " " ^ strx_string str n
  | AV_addrx n -> "AV_addrx " ^ pphex_sym n ^ (match addrx_address str n with Just a -> " " ^ pphex_sym a | Nothing -> "" end)
  | AV_line_strp n -> "AV_line_strp " ^ pphex_sym n ^ " " ^ line_strp_string str n
  | AV_data16 bs -> "AV_data16 " ^ ppbytes bs
  | AV_implicit_const i -> "AV_implicit_const " ^ show i
  | AV_loclistx n -> "AV_loclistx " ^ pphex_sym n
  | AV_rnglistx n -> "AV_rnglistx " ^ pphex_sym n
  | AV_ref_sup4 n -> "AV_ref_sup4 " ^ pphex_sym n
  | AV_ref_sup8 n -> "AV_ref_sup8 " ^ pphex_sym n
  | AV_strp_sup n -> "AV_strp_sup " ^ pphex_sym n
  end

val parser_of_attribute_form_non_indirect : p_context -> compilation_unit_header -> sym_natural -> parser attribute_value
let parser_of_attribute_form_non_indirect c cuh n =
(* address*)
  if n = attribute_form_encode "DW_FORM_addr"         then
    pr_map2 (fun n -> AV_addr n) (parse_uint_address_size c cuh.cuh_address_size)
(* block *)
  else if n = attribute_form_encode "DW_FORM_block1"       then
    (fun pc -> pr_bind (parse_uint8 pc) (fun n pc' ->
      pr_map (fun bs -> AV_block n bs) (parse_n_bytes n pc')))
  else if n = attribute_form_encode "DW_FORM_block2"       then
    (fun pc -> pr_bind (parse_uint16 c pc) (fun n pc' ->
      pr_map (fun bs -> AV_block n bs) (parse_n_bytes n pc')))
  else if n = attribute_form_encode "DW_FORM_block4"       then
    (fun pc -> pr_bind (parse_uint32 c pc) (fun n pc' ->
      pr_map (fun bs -> AV_block n bs) (parse_n_bytes n pc')))
  else if n = attribute_form_encode "DW_FORM_block"        then
    (fun pc -> pr_bind (parse_ULEB128 pc) (fun n pc' ->
      pr_map (fun bs -> AV_block n bs) (parse_n_bytes n pc')))
(* constant *)
  else if n = attribute_form_encode "DW_FORM_data1"        then
    pr_map2 (fun bs -> AV_block 1 bs) (parse_n_bytes 1)
  else if n = attribute_form_encode "DW_FORM_data2"        then
    pr_map2 (fun bs -> AV_block 2 bs) (parse_n_bytes 2)
  else if n = attribute_form_encode "DW_FORM_data4"        then
    pr_map2 (fun bs -> AV_block 4 bs) (parse_n_bytes 4)
  else if n = attribute_form_encode "DW_FORM_data8"        then
    pr_map2 (fun bs -> AV_block 8 bs) (parse_n_bytes 8)
  else if n = attribute_form_encode "DW_FORM_sdata"        then
    pr_map2 (fun i -> AV_constant_SLEB128 i) parse_SLEB128
  else if n = attribute_form_encode "DW_FORM_udata"        then
    pr_map2 (fun n -> AV_constant_ULEB128 n) parse_ULEB128
(* exprloc *)
  else if n = attribute_form_encode "DW_FORM_exprloc"      then
    (fun pc -> pr_bind (parse_ULEB128 pc) (fun n pc' ->
      pr_map (fun bs -> AV_exprloc n bs) (parse_n_bytes n pc')))
(* flag *)
  else if n = attribute_form_encode "DW_FORM_flag"         then
    pr_map2 (fun n -> AV_flag (n<>0)) (parse_uint8)
  else if n = attribute_form_encode "DW_FORM_flag_present" then
    pr_map2 (fun () -> AV_flag true) (pr_return ())
(* lineptr, loclistptr, macptr, rangelistptr *)
  else if n = attribute_form_encode "DW_FORM_sec_offset"   then
    pr_map2 (fun n -> AV_sec_offset n) (parse_uintDwarfN c cuh.cuh_dwarf_format)
(* reference - first type *)
  else if n = attribute_form_encode "DW_FORM_ref1"         then
    pr_map2 (fun n -> AV_ref n) (parse_uint8)
  else if n = attribute_form_encode "DW_FORM_ref2"         then
    pr_map2 (fun n -> AV_ref n) (parse_uint16 c)
  else if n = attribute_form_encode "DW_FORM_ref4"         then
    pr_map2 (fun n -> AV_ref n) (parse_uint32 c)
  else if n = attribute_form_encode "DW_FORM_ref8"         then
    pr_map2 (fun n -> AV_ref n) (parse_uint64 c)
  else if n = attribute_form_encode "DW_FORM_ref_udata"    then
    pr_map2 (fun n -> AV_ref n) parse_ULEB128
(* reference - second type *)
  else if n = attribute_form_encode "DW_FORM_ref_addr"     then
    pr_map2 (fun n -> AV_ref_addr n) (parse_uintDwarfN c cuh.cuh_dwarf_format)
(* reference - third type *)
  else if n = attribute_form_encode "DW_FORM_ref_sig8"     then
    pr_map2 (fun n -> AV_ref_sig8 n) (parse_uint64 c)
(* string *)
  else if n = attribute_form_encode "DW_FORM_string"       then
    pr_map2 (fun bs -> AV_string bs) parse_string
  else if n = attribute_form_encode "DW_FORM_strp"         then
    pr_map2 (fun n -> AV_strp n) (parse_uintDwarfN c cuh.cuh_dwarf_format)
(* Claude: DWARF 5 forms *)
  else if n = attribute_form_encode "DW_FORM_strx"         then pr_map2 (fun n -> AV_strx n) parse_ULEB128
  else if n = attribute_form_encode "DW_FORM_strx1"        then pr_map2 (fun n -> AV_strx n) parse_uint8
  else if n = attribute_form_encode "DW_FORM_strx2"        then pr_map2 (fun n -> AV_strx n) (parse_uint16 c)
  else if n = attribute_form_encode "DW_FORM_strx3"        then pr_map2 (fun n -> AV_strx n) (parse_uint24 c)
  else if n = attribute_form_encode "DW_FORM_strx4"        then pr_map2 (fun n -> AV_strx n) (parse_uint32 c)
  else if n = attribute_form_encode "DW_FORM_addrx"        then pr_map2 (fun n -> AV_addrx n) parse_ULEB128
  else if n = attribute_form_encode "DW_FORM_addrx1"       then pr_map2 (fun n -> AV_addrx n) parse_uint8
  else if n = attribute_form_encode "DW_FORM_addrx2"       then pr_map2 (fun n -> AV_addrx n) (parse_uint16 c)
  else if n = attribute_form_encode "DW_FORM_addrx3"       then pr_map2 (fun n -> AV_addrx n) (parse_uint24 c)
  else if n = attribute_form_encode "DW_FORM_addrx4"       then pr_map2 (fun n -> AV_addrx n) (parse_uint32 c)
  else if n = attribute_form_encode "DW_FORM_line_strp"    then pr_map2 (fun n -> AV_line_strp n) (parse_uintDwarfN c cuh.cuh_dwarf_format)
  else if n = attribute_form_encode "DW_FORM_data16"       then pr_map2 (fun bs -> AV_data16 bs) (parse_n_bytes 16)
  else if n = attribute_form_encode "DW_FORM_implicit_const" then
    (* only reached through DW_FORM_indirect: the value then follows in the DIE (errata 221114.1) *)
    pr_map2 (fun i -> AV_implicit_const i) parse_SLEB128
  else if n = attribute_form_encode "DW_FORM_loclistx"     then pr_map2 (fun n -> AV_loclistx n) parse_ULEB128
  else if n = attribute_form_encode "DW_FORM_rnglistx"     then pr_map2 (fun n -> AV_rnglistx n) parse_ULEB128
  else if n = attribute_form_encode "DW_FORM_ref_sup4"     then pr_map2 (fun n -> AV_ref_sup4 n) (parse_uint32 c)
  else if n = attribute_form_encode "DW_FORM_ref_sup8"     then pr_map2 (fun n -> AV_ref_sup8 n) (parse_uint64 c)
  else if n = attribute_form_encode "DW_FORM_strp_sup"     then pr_map2 (fun n -> AV_strp_sup n) (parse_uintDwarfN c cuh.cuh_dwarf_format)
  (* Claude: dwz's alternatives, offset-sized *)
  else if n = attribute_form_encode "DW_FORM_GNU_strp_alt" then pr_map2 (fun n -> AV_strp_sup n) (parse_uintDwarfN c cuh.cuh_dwarf_format)
  else if n = attribute_form_encode "DW_FORM_GNU_ref_alt"  then pr_map2 (fun n -> (match cuh.cuh_dwarf_format with Dwarf32 -> AV_ref_sup4 n | Dwarf64 -> AV_ref_sup8 n end)) (parse_uintDwarfN c cuh.cuh_dwarf_format)
(* indirect: handled by parser_of_attribute_form *)
  else if n = attribute_form_encode "DW_FORM_indirect"     then
    Assert_extra.failwith "DW_FORM_INDIRECT cycle"
(* unknown *)
  else
    Assert_extra.failwith ("parser_of_attribute_form_non_indirect: unknown attribute form " ^ pphex_sym n)


(* Claude: DW_FORM_indirect may repeat (errata 221114.1) *)
let rec parser_of_attribute_form c cuh n =
  if n = attribute_form_encode "DW_FORM_indirect" then
    (fun pc -> pr_bind (parse_ULEB128 pc) (fun n' ->
      parser_of_attribute_form c cuh n') )
  else
    parser_of_attribute_form_non_indirect c cuh n


(* *** where to put this? *)

let pp_pos pos = "<" ^ sym_natural_pp pphexplain pos ^">"

let pp_cupdie (cu,parents,die) = pp_pos cu.cu_header.cuh_offset ^ "/" ^ pp_pos die.die_offset

let pp_cupdie3 (cu,parents,die) = pp_pos die.die_offset ^ "/" ^ String.concat "/" (List.map (fun p -> pp_pos p.die_offset) parents) ^ "/" ^ pp_pos cu.cu_header.cuh_offset
                                                              

(** ************************************************************ *)
(** **  finding things in the die tree                           *)
(** ************************************************************ *)

val find_maybe : forall 'a 'b. ('a -> maybe 'b) -> list 'a -> maybe 'b
let rec find_maybe f l =
  match l with
  | []      -> Nothing
  | x :: xs ->
     match f x with
     | Just y -> Just y
     | Nothing -> find_maybe f xs
     end
  end

let rec find_die_by_offset_in_cu offset cu : maybe cupdie =
  match Map.lookup offset cu.cu_index with
    | Just (parents,die) -> Just (cu, parents,die)
    | Nothing -> Nothing
  end

let find_die_by_offset_in_all offset d : maybe cupdie =
  find_maybe
    (fun cu -> find_die_by_offset_in_cu offset cu)
    d.d_compilation_units

val find_dies_in_die : (die->bool) -> compilation_unit -> list die -> die -> list cupdie
let rec find_dies_in_die (p:die->bool) (cu:compilation_unit) (parents: list die) (d: die) =
  let ds = List.concatMap (find_dies_in_die p cu (d::parents)) d.die_children in
  if p d then (cu,parents,d)::ds else ds

let find_dies (p:die->bool) (d: dwarf) : list cupdie =
  List.concatMap
    (fun cu -> find_dies_in_die p cu [] cu.cu_die)
    d.d_compilation_units


(** convert attribute values to usable Lem types *)


let string_of_string_attribute_value (str: unit_context) av : string =
  match av with
  | AV_string bs -> string_of_sym_byte_sequence bs
  | AV_strp n -> pp_debug_str_entry str n
  | AV_strx i -> strx_string str i           (* Claude: DWARF 5 *)
  | AV_line_strp n -> line_strp_string str n
  | _ -> "find_string_attribute_value_of_die AV not understood"
  end

let maybe_natural_of_constant_attribute_value die1 c av : maybe sym_natural = 
  match av with
  | AV_constantN n bs -> Just n
  | AV_constant_ULEB128 n -> Just n
  | AV_block n bs -> Just (sym_natural_of_bytes c.endianness bs)
  | AV_implicit_const i -> if i >= 0 then Just (partialSymNaturalFromInteger i) else Nothing   (* Claude: DWARF 5 *)
  | _ -> Nothing
  end

let natural_of_constant_attribute_value die1 c av : sym_natural =
  match maybe_natural_of_constant_attribute_value die1 c av with
  | Just n -> n 
  | Nothing -> Assert_extra.failwith ("natural_of_constant_attribute_value fail at " ^ (pp_pos die1.die_offset ^ (" with av= " ^ pp_attribute_value_plain av)))
  end

let integer_of_constant_attribute_value c av : sym_integer =
  match av with
  | AV_constantN n bs -> symIntegerFromNatural n
  | AV_constant_ULEB128 n -> symIntegerFromNatural n
  | AV_constant_SLEB128 n -> n
  | AV_block n bs -> symIntegerFromNatural (sym_natural_of_bytes c.endianness bs)
  | AV_implicit_const i -> i   (* Claude: DWARF 5 *)
  | _ -> Assert_extra.failwith ("integer_of_constant_attribute_value fail")
  end

let bool_of_flag_attribute_value av : bool =
  match av with
  | AV_flag b -> b
  | _ -> Assert_extra.failwith ("bool_of_maybe_flag_attribute_value fail")
  end

val add_die_to_index : die_index -> list die -> die -> die_index
let rec add_die_to_index acc parents die =
  let nacc : die_index = Map.insert die.die_offset (parents,die) acc in
  List.foldl (fun acc ndie -> add_die_to_index acc (die::parents) ndie) nacc die.die_children

(* Claude: a type unit viewed as a compilation unit, for the DIE-tree functions *)
let compilation_unit_of_type_unit (tu: type_unit) : compilation_unit =
  <|
  cu_header = tu.tu_header.tuh_cuh;
  cu_abbreviations_table = tu.tu_abbreviations_table;
  cu_die = tu.tu_die;
  cu_tables = tu.tu_tables;
  cu_index = add_die_to_index Map.empty [] tu.tu_die
  |>

let reference_of_reference_attribute_value c d cu str av : maybe (compilation_unit * (list die) * die) =
  match av with
  (* "offset from the first byte of the compilation header for the compilation unit containing the reference" *)
  | AV_ref n ->
     let n' = n+cu.cu_header.cuh_offset in
     match find_die_by_offset_in_all n' d (*cu.cu_die*) with
     | Just (cu',parents',die') -> Just (cu',parents',die')
     | Nothing -> Nothing (* Fail ("find_reference_attribute_of_die AV_ref failed (cuh="^pphex cu.cu_header.cuh_offset ^" n'="^pphex n'^")"^"\n"^ppd())*)
     end
   (* offset in .debug_info *)
  | AV_ref_addr n ->
     match find_die_by_offset_in_all n d with
     | Just (cu',parents',die') -> Just (cu',parents',die')
     | Nothing -> Nothing (*Fail ("find_reference_attribute_of_die AV_ref_addr failed\n"^ppd())*)
     end
  (* Claude: a type signature (DWARF 4 .debug_types, DWARF 5 DW_UT_type units in
     .debug_info): the type unit with that signature, and the DIE at its type
     offset, which is relative to the unit's header *)
  | AV_ref_sig8 sg ->
     match List.find (fun tu -> sym_eq tu.tu_header.tuh_type_signature sg) d.d_type_units with
     | Just tu ->
        let cu' = compilation_unit_of_type_unit tu in
        find_die_by_offset_in_cu (tu.tu_header.tuh_cuh.cuh_offset + tu.tu_header.tuh_type_offset) cu'
     | Nothing -> Nothing
     end
  | _ ->
     Nothing (*Fail ("reference_of_reference_attribute AV ("^pp_attribute_value c cu.cu_header str (attribute_encode an) av^") not supported\n"^ppd() )*)
      (* TODO: handle the AV_ref_sig8 case for type signature references *)
  end

(** attribute find *)   
  
let find_attribute_value (an: string) (die:die) : maybe attribute_value =
  let at = attribute_encode an in
  let ats = List.zip
      die.die_abbreviation_declaration.ad_attribute_specifications
      die.die_attribute_values in
  myfindmaybe
    (fun  ((sp: attribute_specification), ((pos: sym_natural),(av:attribute_value))) ->
      if sp.as_attribute = at then Just av else Nothing)
    ats

(* Claude: the context for interpreting one unit's attribute values (see [unit_context]) *)
let sec_offset_attribute_of_die (an: string) (die: die) : maybe sym_natural =
  match find_attribute_value an die with
  | Just (AV_sec_offset n) -> Just n
  | _ -> Nothing
  end

(* Claude: the entries of a unit's contribution to .debug_str_offsets or
   .debug_addr, given the base attribute's offset.  A contribution has a header
   (an initial length, a 2-byte version, and 2 more bytes) and the base points just
   after it, so the length gives the entry count; without a readable header (as in
   pre-standard uses of these tables) the entries run to the end of the section. *)
let rec index_list (i: natural) (xs: list 'a) : list (natural * 'a) =
  match xs with
  | [] -> []
  | x :: xs' -> (i, x) :: index_list (i + 1) xs'
  end

let read_index_table (c: p_context) (df: dwarf_format) (entry_size: natural) (p: parser sym_natural) (sec: sym_byte_sequence) (base: sym_natural) : Map.map natural sym_natural =
  let b = sym_natural_offset_part base in
  let header_size = match df with Dwarf32 -> 8 | Dwarf64 -> 16 end in
  let length_pos = match df with Dwarf32 -> b - 8 | Dwarf64 -> b - 12 end in
  let count_from_header =
    if b < header_size then Nothing else
    match read_uintDwarfN_at c df sec length_pos with
    | Just len -> let l = sym_natural_offset_part len in if l >= 4 then Just ((l - 4) div entry_size) else Nothing
    | Nothing -> Nothing
    end in
  let count =
    match count_from_header with
    | Just n -> n
    | Nothing -> if sym_bs_length sec > b then (sym_bs_length sec - b) div entry_size else 0
    end in
  match sym_dropbytes b sec with
  | Fail _ -> Map.empty
  | Success bs ->
      match parse_replicate count p <| pc_bytes = bs; pc_offset = b |> with
      | PR_success es _ -> Map.fromList (index_list 0 es)
      | PR_fail _ _ -> Map.empty
      end
  end

let read_index_table_headerless (c: p_context) (entry_size: natural) (p: parser sym_natural) (sec: sym_byte_sequence) (base: sym_natural) : Map.map natural sym_natural =
  let b = sym_natural_offset_part base in
  let count = if sym_bs_length sec > b then (sym_bs_length sec - b) div entry_size else 0 in
  match sym_dropbytes b sec with
  | Fail _ -> Map.empty
  | Success bs ->
      match parse_replicate count p <| pc_bytes = bs; pc_offset = b |> with
      | PR_success es _ -> Map.fromList (index_list 0 es)
      | PR_fail _ _ -> Map.empty
      end
  end

let unit_tables_of_die (c: p_context) (secs: dwarf_sections) (cuh: compilation_unit_header) (die: die) : unit_tables =
  let df = cuh.cuh_dwarf_format in
  let str_offsets =
    match sec_offset_attribute_of_die "DW_AT_str_offsets_base" die with
    | Just base ->
        (* in a relocatable file each entry is a relocation against .debug_str,
           whose offset part is the string's offset *)
        read_index_table c df (offset_size df) (pr_map2 (fun n -> sym_natural_const (sym_natural_offset_part n)) (parse_uintDwarfN c df)) (section_or_empty secs.sec_str_offsets) base
    | Nothing -> Map.empty
    end in
  (* the pre-standard DWARF 4 split-DWARF table (DW_AT_GNU_addr_base) has no
     header, so its entries run to the end of the section *)
  let base_attr = match sec_offset_attribute_of_die "DW_AT_addr_base" die with Just b -> Just b | Nothing -> sec_offset_attribute_of_die "DW_AT_GNU_addr_base" die end in
  let addrs =
    match base_attr with
    | Just base ->
        if sym_natural_offset_part cuh.cuh_version < 5 then
          read_index_table_headerless c (sym_natural_offset_part cuh.cuh_address_size) (parse_uint_address_size c cuh.cuh_address_size) (section_or_empty secs.sec_addr) base
        else read_index_table c df (sym_natural_offset_part cuh.cuh_address_size) (parse_uint_address_size c cuh.cuh_address_size) (section_or_empty secs.sec_addr) base
    | Nothing -> Map.empty
    end in
  <| ut_str_offsets = str_offsets; ut_addrs = addrs |>

let unit_context_of_sections (c: p_context) (secs: dwarf_sections) (loc: location_list_list) (ranges: range_list_list) (cuh: compilation_unit_header) : unit_context =
  <|
  uc_c = c;
  uc_sections = secs;
  uc_loc = loc;
  uc_ranges = ranges;
  uc_cuh = cuh;
  uc_tables = empty_unit_tables;
  uc_index = Map.empty;
  uc_str_offsets_base = Nothing;
  uc_addr_base = Nothing;
  uc_rnglists_base = Nothing;
  uc_loclists_base = Nothing;
  uc_base_address = 0;
  |>

let unit_context_of_die_tables (d: dwarf) (cuh: compilation_unit_header) (tables: unit_tables) (index: die_index) (die: die) : unit_context =
  let c = <| endianness = d.d_endianness |> in
  let str0 =
    <|
    uc_c = c;
    uc_sections = d.d_sections;
    uc_loc = d.d_loc;
    uc_ranges = d.d_ranges;
    uc_cuh = cuh;
    uc_tables = tables;
    uc_index = index;
    uc_str_offsets_base = sec_offset_attribute_of_die "DW_AT_str_offsets_base" die;
    uc_addr_base = sec_offset_attribute_of_die "DW_AT_addr_base" die;
    uc_rnglists_base = sec_offset_attribute_of_die "DW_AT_rnglists_base" die;
    uc_loclists_base = sec_offset_attribute_of_die "DW_AT_loclists_base" die;
    uc_base_address = 0;
    |> in
  let base =
    match find_attribute_value "DW_AT_low_pc" die with
    | Just av -> (match address_of_attribute_value str0 av with Just a -> a | Nothing -> 0 end)
    | Nothing -> 0
    end in
  <| str0 with uc_base_address = base |>

(* for a DIE without its parsed unit to hand: the tables are read afresh *)
let unit_context_of_die (d: dwarf) (cuh: compilation_unit_header) (die: die) : unit_context =
  unit_context_of_die_tables d cuh (unit_tables_of_die <| endianness = d.d_endianness |> d.d_sections cuh die) Map.empty die

let unit_context_of_cu (d: dwarf) (cu: compilation_unit) : unit_context =
  unit_context_of_die_tables d cu.cu_header cu.cu_tables cu.cu_index cu.cu_die

let unit_context_of_tu (d: dwarf) (tu: type_unit) : unit_context =
  unit_context_of_die_tables d tu.tu_header.tuh_cuh tu.tu_tables Map.empty tu.tu_die

(* Claude: for the few places that print without a unit to hand: the first unit's
   context *)
let unit_context_of_d (d: dwarf) : unit_context =
  match d.d_compilation_units with
  | cu :: _ -> unit_context_of_cu d cu
  | [] -> unit_context_of_sections <| endianness = d.d_endianness |> d.d_sections d.d_loc d.d_ranges
            <| cuh_offset = 0; cuh_dwarf_format = Dwarf32; cuh_unit_length = 0; cuh_version = 4; cuh_debug_abbrev_offset = 0;
               cuh_address_size = 8; cuh_unit_type = Nothing; cuh_dwo_id = Nothing |>
  end

  
let find_string_attribute_value_of_die (an: string) str (die:die) : maybe string =  
  match find_attribute_value an die with
  | Just av ->
     let s = string_of_string_attribute_value str av in
     Just s
  | Nothing -> 
      Nothing
  end 

let find_natural_attribute_value_of_die c (an: string) (die:die) : maybe sym_natural =  
  match find_attribute_value an die with
  | Just av ->
     let n = natural_of_constant_attribute_value die c av in
     Just n
  | Nothing -> 
      Nothing
  end 

let find_integer_attribute_value_of_die c (an: string) (die:die) : maybe sym_integer =  
  match find_attribute_value an die with
  | Just av ->
     let n = integer_of_constant_attribute_value c av in
     Just n
  | Nothing -> 
      Nothing
  end 

let find_flag_attribute_value_of_die (an: string) (die:die) : maybe bool =  
  Maybe.map bool_of_flag_attribute_value (find_attribute_value an die)


let find_flag_attribute_value_of_die_default_false (an: string) (die:die) : bool =  
  match find_flag_attribute_value_of_die an die with
  | Just b -> b
  | Nothing -> false
  end
   
  
  
let find_name_of_die str die : maybe string =
  find_string_attribute_value_of_die "DW_AT_name" str die



  
let find_reference_attribute_of_die c d cu str an die : maybe (compilation_unit * (list die) * die) =
  let ppd () = pp_pos die.die_offset (*pp_die c cuh str true 0 false die ^ "\n"*) in
  match find_attribute_value an die with
  | Nothing ->
     Nothing (*Fail ("find_reference_attribute_of_die found no " ^ an ^ "\n" ^ ppd())*)
  | Just av ->
     reference_of_reference_attribute_value c d cu str av
  end  

let find_DW_AT_type_of_die c d cu str die : maybe (compilation_unit * (list die) * die) =
  find_reference_attribute_of_die c d cu str "DW_AT_type" die

(* look up "an" in die. If not found, see if die has an abstract origin, and if so, look up "an" in that. Return the relevant cu, too *)
let find_attribute_value_using_abstract_origin c d cu str an die : maybe (compilation_unit * attribute_value) = 
  match find_attribute_value an die with
  | Just av -> Just (cu,av)
  | Nothing ->
     match find_reference_attribute_of_die c d cu str "DW_AT_abstract_origin" die with
     | Nothing ->
        Nothing (*s ^ " and no DW_AT_abstract_origin"*)
     | Just (cu',parents',die') -> 
        match find_attribute_value an die' with
        | Just av -> Just (cu',av)
        | Nothing -> Nothing
        end
     end
  end

let find_name_of_die_using_abstract_origin c d cu str die : maybe string = 
  match find_attribute_value_using_abstract_origin c d cu str "DW_AT_name" die with
  | Nothing -> Nothing
  | Just (cu',av) -> Just (string_of_string_attribute_value str av)
  end

(* TODO: not sure how DW_AT_specification should interact with abstract origins *)   
let find_name_of_die_using_abstract_origin_and_spec c d cu str die mcupdie_spec : maybe string = 
  match find_name_of_die_using_abstract_origin c d cu str die with
  | Just name -> Just name
  | Nothing ->
     match mcupdie_spec with
     | Just ((cu_spec,parents_spec,die_spec) as cupdie_spec) -> 
        find_name_of_die_using_abstract_origin c d cu_spec str die_spec
     | Nothing ->
        Nothing
    end
end
   
let find_reference_attribute_using_abstract_origin c d cu str an die : maybe (compilation_unit * (list die) * die) = 
  match find_attribute_value_using_abstract_origin c d cu str an die with
  | Nothing -> Nothing
  | Just (cu',av) ->
     reference_of_reference_attribute_value c d cu' str av     
  end

let find_DW_AT_type_of_die_using_abstract_origin c d cu str die : maybe (compilation_unit * (list die) * die) =
  find_reference_attribute_using_abstract_origin c d cu str "DW_AT_type" die

let find_flag_attribute_value_of_die_using_abstract_origin d (an: string) ((cu,parents,die):cupdie) : maybe bool =  
  let c = p_context_of_d d in
  match find_attribute_value_using_abstract_origin c d cu (unit_context_of_cu d cu) an die with
  | Nothing -> Nothing
  | Just (cu',av) ->
     Just (bool_of_flag_attribute_value av)
  end
  

(** compilation unit header: pp and parsing *)

let pp_dwarf_format df = match df with Dwarf32 -> "(32-bit)" | Dwarf64 -> "(64-bit)" end

let pp_unit_header (s:string) (x:compilation_unit_header) : string =
    "**" ^ s ^ " Unit @ offset " ^ pphex_sym x.cuh_offset ^ "\n"
  ^ "  " ^ s ^ " Unit @ offset " ^ pphex_sym x.cuh_offset ^ ":\n"
  ^ "   Length:        " ^ pphex_sym x.cuh_unit_length ^ " " ^ pp_dwarf_format x.cuh_dwarf_format ^ "\n"
  ^ "   Version:       " ^ show x.cuh_version ^ "\n"
  ^ "   Abbrev Offset: " ^ pphex_sym x.cuh_debug_abbrev_offset ^ "\n"
  ^ "   Pointer Size:  " ^ show x.cuh_address_size ^ "\n"

let pp_compilation_unit_header (x:compilation_unit_header) : string =
  pp_unit_header "Compilation" x

let parse_unit_length c : parser (dwarf_format * sym_natural) =
    fun (pc: parse_context) ->
      pr_bind (parse_uint32 c pc) (fun x pc' ->
        if x < sym_natural_of_hex "0xfffffff0" then PR_success (Dwarf32,x) pc'
        else if x <> sym_natural_of_hex "0xffffffff" then PR_fail "bad unit_length" pc
        else
          pr_bind (parse_uint64 c pc') (fun x' pc'' ->
            PR_success (Dwarf64, x') pc''))   (* Claude: was pc', re-reading the 8-byte length as the following fields *)


(* Claude: DWARF 2 to 4: unit_length, version, debug_abbrev_offset, address_size;
   DWARF 5 (section 7.5.1): unit_length, version, unit_type, address_size,
   debug_abbrev_offset, then a dwo_id for skeleton and split units (the type
   signature and offset of a type unit are read by the caller, as for .debug_types) *)
let parse_compilation_unit_header c : parser compilation_unit_header =
  fun (pc: parse_context) ->
    let offset = sym_natural_const pc.pc_offset in
    pr_bind (parse_unit_length c pc) (fun (df, ul) pc1 ->
    pr_bind (parse_uint16 c pc1) (fun v pc2 ->
      let mk dao as' ut dwo =
        <|
        cuh_offset = offset;
        cuh_dwarf_format = df;
        cuh_unit_length = ul;
        cuh_version = v;
        cuh_debug_abbrev_offset = dao;
        cuh_address_size = as';
        cuh_unit_type = ut;
        cuh_dwo_id = dwo;
        |> in
      if v >= 5 then
        pr_bind (parse_uint8 pc2) (fun ut pc3 ->
        pr_bind (parse_uint8 pc3) (fun as' pc4 ->
        pr_bind (parse_uintDwarfN c df pc4) (fun dao pc5 ->
          if ut = vDW_UT_skeleton || ut = vDW_UT_split_compile then
            pr_bind (parse_uint64 c pc5) (fun dwo pc6 -> PR_success (mk dao as' (Just ut) (Just dwo)) pc6)
          else
            PR_success (mk dao as' (Just ut) Nothing) pc5)))
      else
        pr_bind (parse_uintDwarfN c df pc2) (fun dao pc3 ->
        pr_bind (parse_uint8 pc3) (fun as' pc4 ->
          PR_success (mk dao as' Nothing Nothing) pc4))))


(** type unit header: pp and parsing *)

(* the test binaries don't have a .debug_types section, so this isn't tested *)

let pp_type_unit_header (x:type_unit_header) : string =
  pp_unit_header "Type" x.tuh_cuh
  ^ "   Type Signature:  " ^ pphex_sym x.tuh_type_signature ^ "\n"
  ^ "   Type Offset:  " ^ pphex_sym x.tuh_type_offset ^ "\n"


let parse_type_unit_header c : parser type_unit_header =
    pr_post_map
      (parse_dependent_pair
         (parse_compilation_unit_header c)
         (fun cuh ->
           parse_pair
             (parse_uint64 c) (* type signature *)
             (parse_uintDwarfN c cuh.cuh_dwarf_format) (* type offset *) ))
      (fun (cuh, (ts, to')) ->
        <|
        tuh_cuh = cuh;
        tuh_type_signature = ts;
        tuh_type_offset = to';
      |>)


(** debugging information entries: pp and parsing *)

(* example pp from readelf
 <2><51>: Abbrev Number: 3 (DW_TAG_variable)
    <52>   DW_AT_name        : x
    <54>   DW_AT_decl_file   : 1
    <55>   DW_AT_decl_line   : 2
    <56>   DW_AT_type        : <0x6a>
    <5a>   DW_AT_location    : 2 byte block: 91 6c 	(DW_OP_fbreg: -20)
*)



  

  
               
(** debugging information entries: pp and parsing *)
               
let indent_level (indent: bool) (level: natural) =
  if indent then
    (toString (replicate (3 * level) #' '))
  else
    " "
let indent_level_plus_one indent level =
  if indent then
    indent_level indent (level+1)
  else
    " "^"   "
      
(** Claude: DIE tree pretty-printing is a single walk over the tree,
  * [pp_die_tree], parameterised by a [die_style]: how to render the line that
  * introduces a DIE, one attribute line, and whatever follows a DIE's children.
  * Two styles exist: [style_info], linksem's own view of the parsed data
  * (--debug-dump=info), and [style_objdump], byte-identical to
  * `objdump --dwarf=info` (--debug-dump=dies), defined with the other
  * objdump-compatible printing functions further down.
  *)
type die_style =
  <| ds_die_line   : natural -> die -> string
   ; ds_attribute  : compilation_unit_header -> natural -> die -> (attribute_specification * (sym_natural * attribute_value)) -> string
   ; ds_terminator : natural -> die -> string
  |>

val pp_die_tree : die_style -> compilation_unit_header -> bool -> natural -> die -> string
let rec pp_die_tree (st:die_style) (cuh:compilation_unit_header) (descend:bool) (level:natural) (die:die) : string =
  let ad = die.die_abbreviation_declaration in
  st.ds_die_line level die
  ^ String.concat "" (List.map (st.ds_attribute cuh level die) (List.zip ad.ad_attribute_specifications die.die_attribute_values))
  ^ (if descend && ad.ad_has_children then
       String.concat "" (List.map (pp_die_tree st cuh descend (level + 1)) die.die_children)
       (* Claude: no terminator is shown when none was present: the unit's data
          ended the sibling list right after the last child *)
       ^ (match List.reverse die.die_children with
          | last :: _ -> if last.die_end = die.die_end then "" else st.ds_terminator level die
          | [] -> st.ds_terminator level die
          end)
     else "")

(** linksem's own view: each attribute with its form and the parsed value *)
val style_info : p_context -> unit_context -> bool -> die_style
let style_info c (str:unit_context) (indent:bool) : die_style =
  <| ds_die_line = (fun level die ->
       indent_level indent level ^ "<" ^ show level ^ ">"
       ^ pp_pos die.die_offset
       ^ ": Abbrev Number: " ^ show die.die_abbreviation_code
       ^ " (" ^ pp_tag_encoding die.die_abbreviation_declaration.ad_tag ^")\n")
   ; ds_attribute = (fun cuh level die (sp, (pos, av)) ->
       indent_level_plus_one indent level ^ pp_pos pos  ^ "   "
       ^ right_space_padded_to 18 (pp_attribute_encoding sp.as_attribute) ^ ": "
       ^ "(" ^ pp_attribute_form_encoding sp.as_form ^ ") "
       ^ pp_attribute_value c cuh str sp.as_attribute av
       ^ "\n")
   ; ds_terminator = (fun _ _ -> "")
  |>

(* Claude: the original entry points, kept with their signatures.  [indent]
   now only controls indentation: the unindented variant used to be a rough
   imitation of objdump, superseded by [pp_dwarf_like_objdump]. *)
let pp_die_attribute c (cuh:compilation_unit_header) (str : unit_context) (indent:bool) (level: natural) (die:die) (spec_and_value : attribute_specification * (sym_natural * attribute_value)) : string =
  (style_info c str indent).ds_attribute cuh level die spec_and_value

val pp_die : p_context -> compilation_unit_header -> unit_context -> bool -> natural -> bool -> die -> string
let pp_die c cuh str indent level (pp_children:bool) die =
  pp_die_tree (style_info c str indent) cuh pp_children level die

val pp_die_abbrev : p_context -> compilation_unit_header -> unit_context -> natural -> bool -> (list die) -> die -> string
let rec pp_die_abbrev c cuh str level (pp_children:bool) parents die =
  indent_level true level
  ^ pp_tag_encoding die.die_abbreviation_declaration.ad_tag
  ^ " (" ^ pp_pos die.die_offset ^ ") "
(*  ^ ": Abbrev Number: " ^ show die.die_abbreviation_code *)
  ^
    (match find_name_of_die str die with Just s -> s | Nothing -> "-" end)
    ^ "   :  " ^ String.concat " : " (List.map (fun die' ->  pp_tag_encoding die'.die_abbreviation_declaration.ad_tag) parents)
    ^ "\n"
    ^ (*(String.concat "" (List.map (pp_die_abbrev_attribute c cuh str) ats))*)

      if pp_children then String.concat "" (List.map (pp_die_abbrev c cuh str (level +1) pp_children (die::parents)) die.die_children) else ""


(* condensed pp for variables *)
val pp_die_abbrev_var : p_context -> dwarf -> compilation_unit -> unit_context -> bool -> (list die) -> die -> (string (*name*) * string (*offset*) * string (*kind*))
let rec pp_die_abbrev_var c d cu str (pp_children:bool) parents die =
  (*   (indent_level true level*)
  (*  ^ pp_tag_encoding die.die_abbreviation_declaration.ad_tag*)
(*  ^ ": Abbrev Number: " ^ show die.die_abbreviation_code *)
  ((match find_name_of_die_using_abstract_origin c d cu str die with
    | Just s -> s
    | Nothing -> "?"
    end)
   ,
   pp_pos die.die_offset,
   (if die.die_abbreviation_declaration.ad_tag = tag_encode "DW_TAG_variable" then  "var"
    else if die.die_abbreviation_declaration.ad_tag = tag_encode "DW_TAG_formal_parameter" then "param"
    else "other")
  )

(* condensed pp for variable parents *)
val pp_die_abbrev_var_parent : p_context -> dwarf -> compilation_unit -> unit_context -> die -> string
let pp_die_abbrev_var_parent c d cu str die =
  (*   (indent_level true level*)
  (*  ^ pp_tag_encoding die.die_abbreviation_declaration.ad_tag*)
(*  ^ ": Abbrev Number: " ^ show die.die_abbreviation_code *)
  let name = (match find_name_of_die_using_abstract_origin c d cu str die with Just s -> s | Nothing -> "" end) in
  let offset = pp_pos die.die_offset in 
   (if die.die_abbreviation_declaration.ad_tag = tag_encode "DW_TAG_compile_unit" then  name
    else if die.die_abbreviation_declaration.ad_tag = tag_encode "DW_TAG_subprogram" then name (*"subprogram"*)
    else if die.die_abbreviation_declaration.ad_tag = tag_encode "DW_TAG_inlined_subroutine" then name ^ "(inlined)"
    else if die.die_abbreviation_declaration.ad_tag = tag_encode "DW_TAG_lexical_block" then "block"
    else name ^ "(" ^ pp_tag_encoding die.die_abbreviation_declaration.ad_tag ^ ")")
  
  

val pp_die_abbrev_var_parents : p_context -> dwarf -> compilation_unit -> unit_context -> list die -> string
let pp_die_abbrev_var_parents c d cu str parents =
    String.concat ":" (List.map (fun die -> pp_die_abbrev_var_parent c d cu str die) parents)


  
  (*    ^ "   :  " ^ String.concat " : " (List.map (fun die' ->  pp_tag_encoding die'.die_abbreviation_declaration.ad_tag) parents)*)
    (* ^ "\n"*)
(*    ^ (*(String.concat "" (List.map (pp_die_abbrev_attribute c cuh str) ats))*)*)

(*      if pp_children then String.concat "" (List.map (pp_die_abbrev c cuh str (level +1) pp_children (die::parents)) die.die_children) else ""*)
    


val parse_die : p_context -> unit_context -> compilation_unit_header -> (sym_natural -> maybe abbreviation_declaration) -> parser (maybe die)
let rec parse_die c str cuh find_abbreviation_declaration =
  fun (pc: parse_context) ->
    let _ = my_debug3 ("parse_die called at " ^ pp_parse_context pc ^ "\n") in
    (* Claude: the end of the unit's data ends a sibling list even without the
       null entry that should end it (some hand-written test inputs omit it;
       readelf and objdump accept them) *)
    if sym_bs_length pc.pc_bytes = 0 then PR_success Nothing pc else
    pr_bind (parse_ULEB128 pc) (fun abbreviation_code pc' ->
      if abbreviation_code = 0 then PR_success Nothing pc'
      else
        let _ = my_debug3 ("parse_die abbreviation code "^pphex_sym abbreviation_code ^"\n") in
        match find_abbreviation_declaration abbreviation_code with
        | Nothing -> PR_fail ("abbreviation code " ^ pphex_sym abbreviation_code ^ " not in the abbreviation table") pc'   (* Claude *)
        | Just ad ->
        let attribute_value_parsers =
          List.map (fun (sp: attribute_specification) ->
              pr_with_pos (match sp.as_implicit_const with
                           | Just i -> pr_return (AV_implicit_const i)   (* Claude: no bytes in the DIE *)
                           | Nothing -> parser_of_attribute_form c cuh sp.as_form
                           end))
            ad.ad_attribute_specifications in
        pr_bind (parse_parser_list attribute_value_parsers pc') (fun avs pc'' ->

(*
          let die_header =
            <|
            die_offset = pc.pc_offset;
            die_abbreviation_code = abbreviation_code;
            die_abbreviation_declaration = ad;
            die_attribute_values = avs;
            die_children = [];
          |> in let _ = my_debug3 ("die_header " ^ pp_die cuh str true 999 die_header) in
  *)
            pr_bind
              (if ad.ad_has_children then parse_list (parse_die c str cuh find_abbreviation_declaration) pc'' else pr_return [] pc'')
              (fun dies pc''' ->
                PR_success (Just ( let die =
                  <|
                  die_offset = sym_natural_const pc.pc_offset;
                  die_abbreviation_code = abbreviation_code;
                  die_abbreviation_declaration = ad;
                  die_attribute_values = avs;
                  die_children = dies;
                  die_end = sym_natural_const pc'''.pc_offset;
                  |> in
                  let _ = my_debug3 ("die entire " ^ pp_die c cuh str true 0 false die) in
                  die)) pc''')) end)

let has_attribute (an: string) (die: die) : bool =
  List.elem
    (attribute_encode an)
    (List.map (fun (sp: attribute_specification) -> sp.as_attribute) die.die_abbreviation_declaration.ad_attribute_specifications)


(** compilation units: pp and parsing *)

let pp_compilation_unit c (indent:bool) (str: unit_context) cu =
  ""
(*  "*** compilation unit header               ***\n"*)
  ^ pp_compilation_unit_header cu.cu_header
  ^ "\n*** compilation unit abbreviation table\n"
  ^ pp_abbreviations_table cu.cu_abbreviations_table
  ^ "\n"
  ^ "*** compilation unit die tree\n"
  ^ pp_die c cu.cu_header str indent 0 true cu.cu_die
  ^ "\n"

let pp_compilation_units c (indent:bool) (d: dwarf) (compilation_units: list compilation_unit) : string =
  String.concat "" (List.map (fun cu -> pp_compilation_unit c indent (unit_context_of_cu d cu) cu) compilation_units)


let pp_compilation_unit_abbrev c (str: unit_context) cu =
  pp_compilation_unit_header cu.cu_header
(*  ^ pp_abbreviations_table cu.cu_abbreviations_table*)
  ^ pp_die_abbrev c cu.cu_header str 0 true [] cu.cu_die

let pp_compilation_units_abbrev c (d: dwarf) (compilation_units: list compilation_unit) : string =
  String.concat "" (List.map (fun cu -> pp_compilation_unit_abbrev c (unit_context_of_cu d cu) cu) compilation_units)

(* Claude: one unit of .debug_info: a compilation unit, or in DWARF 5 a type unit
   (DW_UT_type / DW_UT_split_type, whose header continues with the type signature
   and the offset of the type's DIE) *)
let parse_unit c (secs: dwarf_sections) : parser (maybe dwarf_unit) =
    fun (pc:parse_context) ->
      let debug_abbrev_section_body = section_or_empty secs.sec_abbrev in

      if sym_bs_length pc.pc_bytes = 0 then PR_success Nothing pc else

      (* Claude: every failure below is a [PR_fail] rather than an exception, so
         that [parse_list_tolerant] keeps the units parsed before it, as
         readelf and objdump keep printing past a corrupt unit. *)
      match parse_compilation_unit_header c pc with
      | PR_fail s pc' -> PR_fail ("parse_cuh_header fail: " ^ s) pc'
      | PR_success cuh pc' ->

      let _ = my_debug4 (pp_compilation_unit_header cuh) in

      if cuh.cuh_unit_length = 0 then PR_success Nothing pc' else

      let is_type_unit = match cuh.cuh_unit_type with Just ut -> ut = vDW_UT_type || ut = vDW_UT_split_type | Nothing -> false end in
      match (if is_type_unit then
               pr_bind (parse_uint64 c pc') (fun sg pca -> pr_bind (parse_uintDwarfN c cuh.cuh_dwarf_format pca) (fun to' pcb -> PR_success (Just (sg, to')) pcb))
             else PR_success Nothing pc') with
      | PR_fail s pc'' -> PR_fail ("type unit header fail: " ^ s) pc''
      | PR_success mtype_fields pc' ->

      let str = unit_context_of_sections c secs [] [] cuh in

      let abbrev_offset = sym_natural_expect_const cuh.cuh_debug_abbrev_offset in
      match sym_dropbytes abbrev_offset debug_abbrev_section_body with
      | Fail _ -> PR_fail ("debug_abbrev offset " ^ show abbrev_offset ^ " beyond the section") pc'
      | Success abbrev_bytes ->

      let pc_abbrev = <| pc_bytes = abbrev_bytes; pc_offset = abbrev_offset |> in

      (* todo: this is reparsing the abbreviations table for each cu *)
      match parse_abbreviations_table c pc_abbrev with
      | PR_fail s pc_abbrev' -> PR_fail ("parse_abbrevations_table fail: " ^ s) pc'
      | PR_success at pc_abbrev' ->

      let abbreviations_table = <| at_offset=sym_natural_const pc_abbrev.pc_offset; at_table= at|> in

      let _ = my_debug4 (pp_abbreviations_table abbreviations_table) in

      let find_abbreviation_declaration (ac:sym_natural) : maybe abbreviation_declaration =
        List.find (fun ad -> sym_eq ad.ad_abbreviation_code ac) abbreviations_table.at_table  in

      let _ = my_debug3 (pp_abbreviations_table abbreviations_table) in

      match parse_die c str cuh find_abbreviation_declaration pc' with
      | PR_fail s pc'' -> PR_fail ("parse_die fail: " ^ s) pc''
      | PR_success (Nothing) pc'' -> PR_fail "parse_die returned Nothing (an end-of-siblings marker as the unit's first DIE)" pc''
      | PR_success (Just die) pc'' ->
          let u =
            match mtype_fields with
            | Nothing ->
                Unit_compilation <|
                  cu_header = cuh;
                  cu_abbreviations_table = abbreviations_table;
                  cu_die = die;
                  cu_index = add_die_to_index Map.empty [] die;
                  cu_tables = unit_tables_of_die c secs cuh die;
                |>
            | Just (sg, to') ->
                Unit_type <|
                  tu_header = <| tuh_cuh = cuh; tuh_type_signature = sg; tuh_type_offset = to' |>;
                  tu_abbreviations_table = abbreviations_table;
                  tu_die = die;
                  tu_tables = unit_tables_of_die c secs cuh die;
                |>
            end in
          (* Claude: the next unit starts where this unit's header says this one
             ends, not where its DIE tree ended: some producers pad after the
             last DIE, and some emit several level-0 DIEs (which readelf and
             objdump print; here they are skipped).  A unit length that runs
             past the section is ignored and the DIE tree's end used instead. *)
          let header_size = match cuh.cuh_dwarf_format with Dwarf32 -> 4 | Dwarf64 -> 12 end in
          let cu_end = sym_natural_expect_const cuh.cuh_offset + header_size + sym_natural_expect_const cuh.cuh_unit_length in
          let pc_next =
            if cu_end >= pc''.pc_offset then
              match sym_dropbytes (cu_end - pc''.pc_offset) pc''.pc_bytes with
              | Success bs -> <| pc_bytes = bs; pc_offset = cu_end |>
              | Fail _ -> pc''
              end
            else pc'' in
          PR_success (Just u) pc_next
      end
      end
      end
      end
      end

let compilation_units_of_units (us: list dwarf_unit) : list compilation_unit =
  List.mapMaybe (fun u -> match u with Unit_compilation cu -> Just cu | Unit_type _ -> Nothing end) us

let type_units_of_units (us: list dwarf_unit) : list type_unit =
  List.mapMaybe (fun u -> match u with Unit_type tu -> Just tu | Unit_compilation _ -> Nothing end) us

(* Claude: a type unit viewed as a compilation unit, for the DIE accessors *)


(** type units: pp and parsing *)

let pp_type_unit c (d: dwarf) tu =
  pp_type_unit_header tu.tu_header
  ^ pp_abbreviations_table tu.tu_abbreviations_table
  ^ pp_die c tu.tu_header.tuh_cuh (unit_context_of_tu d tu) true 0 true tu.tu_die

let pp_type_units c (d: dwarf) (type_units: list type_unit) : string =
  String.concat "" (List.map (pp_type_unit c d) type_units)


(* the DWARF 4 .debug_types form; DWARF 5 type units are read by [parse_unit] *)
let parse_type_unit c (secs: dwarf_sections) : parser (maybe type_unit) =
    fun (pc:parse_context) ->
      let debug_abbrev_section_body = section_or_empty secs.sec_abbrev in

      if sym_bs_length pc.pc_bytes = 0 then PR_success Nothing pc else

      let (tuh, pc') =
        match parse_type_unit_header c pc with
        | PR_fail s pc' -> Assert_extra.failwith ("parse_tuh_header fail: " ^ pp_parse_fail s pc')
        | PR_success tuh pc' -> (tuh,pc')
        end in

      (* let _ = my_debug4 (pp_type_unit_header tuh) in *)

      let pc_abbrev = let n = tuh.tuh_cuh.cuh_debug_abbrev_offset in <|pc_bytes = match sym_dropbytes (sym_natural_expect_const n (*"mydrop of pc_abbrev"*)) debug_abbrev_section_body with Success bs -> bs | Fail _ -> Assert_extra.failwith "mydrop of debug_abbrev" end; pc_offset = sym_natural_expect_const n (*"mydrop of pc_abbrev"*) |> in

      let abbreviations_table =
        match parse_abbreviations_table c pc_abbrev with
        | PR_fail s pc_abbrev' -> Assert_extra.failwith ("parse_abbrevations_table fail: " ^ pp_parse_fail s pc_abbrev')
        | PR_success at pc_abbrev' -> <| at_offset=sym_natural_const pc_abbrev.pc_offset; at_table= at|>
        end in

      (* let _ = my_debug4 (pp_abbreviations_table abbreviations_table) in *)

      let find_abbreviation_declaration (ac:sym_natural) : maybe abbreviation_declaration =
        List.find (fun ad -> sym_eq ad.ad_abbreviation_code ac) abbreviations_table.at_table  in

      (* let _ = my_debug3 (pp_abbreviations_table abbreviations_table) in *)

      match parse_die c (unit_context_of_sections c secs [] [] tuh.tuh_cuh) tuh.tuh_cuh find_abbreviation_declaration pc' with
      | PR_fail s pc'' -> Assert_extra.failwith ("parse_die fail: " ^ pp_parse_fail s pc'')
      | PR_success (Nothing) pc'' -> Assert_extra.failwith ("parse_die returned Nothing: " ^ pp_parse_context pc'')
      | PR_success (Just die) pc'' ->
          let tu =
            <|
            tu_header = tuh;
            tu_abbreviations_table = abbreviations_table;
            tu_die = die;
            tu_tables = unit_tables_of_die c secs tuh.tuh_cuh die;
          |> in
          PR_success (Just tu) pc''
      end

let parse_type_units c (secs: dwarf_sections) : parser (list type_unit)
      =
    parse_list (parse_type_unit c secs)

(** location lists, pp and parsing *)

(* readelf example
Contents of the .debug_loc section:

    Offset   Begin    End      Expression
    00000000 0000000000400168 0000000000400174 (DW_OP_reg0 (r0))
    00000000 0000000000400174 0000000000400184 (DW_OP_GNU_entry_value: (DW_OP_reg0 (r0)); DW_OP_stack_value)
    00000000 <End of list>
    00000039 000000000040017c 0000000000400180 (DW_OP_lit1; DW_OP_stack_value)
*)

  

      
let pp_location_list_entry c (cuh:compilation_unit_header) (offset:sym_natural) (x:location_list_entry) : string =
  "    " ^ pphex_sym offset
  ^ " " ^ pphex_sym x.lle_beginning_address_offset
  ^ " " ^ pphex_sym x.lle_ending_address_offset
  ^ " (" ^ parse_and_pp_operations c cuh x.lle_single_location_description ^")"
  ^ "\n"

let pp_base_address_selection_entry c (cuh:compilation_unit_header) (offset:sym_natural) (x:base_address_selection_entry) : string =
  "    " ^ pphex_sym offset
  ^ " " ^ pphex_sym x.base_address
  ^ "\n"

let pp_location_list_item c (cuh: compilation_unit_header) (offset: sym_natural) (x:location_list_item) =
  match x with
  | LLI_lle lle -> pp_location_list_entry c cuh offset lle
  | LLI_base base -> pp_base_address_selection_entry c cuh offset base
  end

let pp_location_list c (cuh: compilation_unit_header) ((offset:sym_natural), (llis: list location_list_item)) =
  String.concat "" (List.map (pp_location_list_item c cuh offset) llis)
(*  ^ "    " ^ pphex_sym offset  ^ " <End of list>\n"*)

let pp_loc c (cuh: compilation_unit_header) (lls: list location_list) =
  "    Offset   Begin    End      Expression\n"
  ^  String.concat "" (List.map (pp_location_list c cuh) lls)

(* Note that this is just pp'ing the raw location list data - Section
3.1.1 says: The applicable base address of a location list entry is
determined by the closest preceding base address selection entry in
the same location list. If there is no such selection entry, then the
applicable base address defaults to the base address of the
compilation unit.  That is handled by the interpret_location_list below *)



let parse_location_list_item c (cuh: compilation_unit_header) : parser (maybe location_list_item) =
    fun (pc:parse_context) ->
      pr_bind
        (parse_pair
           (parse_uint_address_size c cuh.cuh_address_size)
           (parse_uint_address_size c cuh.cuh_address_size)
           pc)
        (fun ((a1: sym_natural),(a2:sym_natural)) pc' ->
          (* let _ = my_debug4 ("offset="^pphex pc.pc_offset ^ " begin=" ^ pphex a1 ^ " end=" ^ pphex a2) in *)
          if a1=0 && a2=0 then
            PR_success Nothing pc'
          else if a1 = max_address cuh.cuh_address_size then
            (* Claude: the base address is the second word (the first is the all-ones marker) *)
            let x = LLI_base <| (*base_offset=pc.pc_offset;*) base_address=a2 |> in
            PR_success (Just x (*(pc.pc_offset, x)*)) pc'
          else
            pr_bind (parse_uint16 c pc') (fun n pc'' ->
              pr_post_map1
                (parse_n_bytes n pc'')
                (fun bs ->
                  let x =
                    LLI_lle <|
                    (*lle_offset = pc.pc_offset;*)
                    lle_beginning_address_offset = a1;
                    lle_ending_address_offset = a2;
                    lle_single_location_description = bs;
                  |> in
                  Just x (*(pc.pc_offset, x)*))
                                        )
        )

let parse_location_list c cuh : parser (maybe location_list) =
    fun (pc: parse_context) ->
      if sym_bs_length pc.pc_bytes = 0 then
        PR_success Nothing pc
      else
        pr_post_map1
          (parse_list (parse_location_list_item c cuh) pc)
          (fun llis -> (Just (sym_natural_const pc.pc_offset, llis)))

let parse_location_list_list c cuh : parser location_list_list =
    parse_list (parse_location_list c cuh)

let find_location_list dloc n : location_list =
  myfindNonPure (fun (n',_)-> sym_eq n' n) dloc
  (* fails if location list not found *)

(* interpretation of a location list applies the base_address and LLI_base offsets to give a list indexed by concrete address ranges *)

let rec interpret_location_list (base_address: sym_natural) (llis: list location_list_item) : list (sym_natural * sym_natural * single_location_description) =
  match llis with
  | [] -> []
  | LLI_base base::llis' -> interpret_location_list base.base_address llis'
  | LLI_lle lle :: llis' -> (base_address+lle.lle_beginning_address_offset, base_address+lle.lle_ending_address_offset, lle.lle_single_location_description) :: interpret_location_list base_address llis'
  end


(** range lists, pp and parsing *)

(* example output from:  aarch64-linux-gnu-objdump --dwarf=Ranges 

Contents of the .debug_ranges section:

    Offset   Begin    End
    00000000 00000000004000fc 0000000000400114 
    00000000 000000000040011c 0000000000400128 
    00000000 <End of list>
...
    00000380 0000000000400598 000000000040059c 
    00000380 00000000004005a0 00000000004005a4 
    00000380 00000000004005b4 00000000004005b8 
    00000380 00000000004005bc 00000000004005bc (start == end)
    00000380 00000000004005c0 00000000004005c4 
    00000380 <End of list>

*)

let pp_range_list_entry c (cuh:compilation_unit_header) (offset:sym_natural) (x:range_list_entry) : string =
  "    " ^ pphex_sym offset
  ^ " " ^ pphex_sym x.rle_beginning_address_offset
  ^ " " ^ pphex_sym x.rle_ending_address_offset
  ^ (if x.rle_beginning_address_offset = x.rle_ending_address_offset then " (start == end)" else "")
  ^ "\n"

let pp_range_list_item c (cuh: compilation_unit_header) (offset: sym_natural) (x:range_list_item) =
  match x with
  | RLI_rle rle -> pp_range_list_entry c cuh offset rle
  | RLI_base base -> pp_base_address_selection_entry c cuh offset base
  end

let pp_range_list c (cuh: compilation_unit_header) ((offset:sym_natural), (rlis: list range_list_item)) =
  String.concat "" (List.map (pp_range_list_item c cuh offset) rlis)
  ^ "    " ^ pphex_sym offset  ^ " <End of list>\n"

let pp_ranges c (cuh: compilation_unit_header) (rls: list range_list) =
  "    Offset   Begin    End\n"
  ^  String.concat "" (List.map (pp_range_list c cuh) rls)

(* Note that this is just pp'ing the raw range list data - see also
the interpret_range_list below *)


let parse_range_list_item c (cuh: compilation_unit_header) : parser (maybe range_list_item) =
    fun (pc:parse_context) ->
      pr_bind
        (parse_pair
           (parse_uint_address_size c cuh.cuh_address_size)
           (parse_uint_address_size c cuh.cuh_address_size)
           pc)
        (fun ((a1: sym_natural),(a2:sym_natural)) pc' ->
          (* let _ = my_debug4 ("offset="^pphex pc.pc_offset ^ " begin=" ^ pphex a1 ^ " end=" ^ pphex a2) in *)
          if a1=0 && a2=0 then
            PR_success Nothing pc'
          else if a1 = max_address cuh.cuh_address_size then
            let x = RLI_base <| base_address=a2 |> in
            PR_success (Just x) pc'
          else
            let x =
              RLI_rle <|
                    rle_beginning_address_offset = a1;
                    rle_ending_address_offset = a2;
                  |> in
                  PR_success (Just x (*(pc.pc_offset, x)*)) pc'
        )

(* compiler output includes DW_AT_ranges attributes that point to proper suffixes of range lists. We support that by explicitly including each suffix - though one could be more efficient *)
    
let rec expand_range_list_suffixes cuh (offset,(rlis: list range_list_item)) : list range_list =
  match rlis with
  | [] -> []
  | [rli] -> [(offset,rlis)]
  | rli::rlis' -> (offset,rlis) :: expand_range_list_suffixes cuh ((offset + 2*cuh.cuh_address_size),rlis')
  end  

let parse_range_list c cuh : parser (maybe (list range_list)) =
    fun (pc: parse_context) ->
      if sym_bs_length pc.pc_bytes = 0 then
        PR_success Nothing pc
      else
        pr_post_map1
          (parse_list (parse_range_list_item c cuh) pc)
          (fun rlis -> (Just (expand_range_list_suffixes cuh (sym_natural_const pc.pc_offset, rlis))))

let parse_range_list_list c cuh : parser range_list_list =
    pr_map2 List.concat (parse_list (parse_range_list c cuh))

let find_range_list dranges n : maybe range_list =
  List.find (fun (n',_)-> sym_eq n' n) dranges
  (* fails if range list not found *)

(* interpretation of a range list applies the base_address and RLI_base offsets to give a list of concrete address ranges *)

let rec interpret_range_list (base_address: sym_natural) (rlis: list range_list_item) : list (sym_natural * sym_natural) =
  match rlis with
  | [] -> []
  | RLI_base base::rlis' -> interpret_range_list base.base_address rlis'
  | RLI_rle rle :: rlis' -> (base_address+rle.rle_beginning_address_offset, base_address+rle.rle_ending_address_offset) :: interpret_range_list base_address rlis'
  end

(** Claude: DWARF 5 location and range lists (.debug_loclists and .debug_rnglists,
    sections 2.6.2, 2.17.3, 7.28 and 7.29): kind-tagged entries, parsed from a
    section offset and interpreted to the same (lo, hi[, description]) lists as the
    DWARF 4 .debug_loc and .debug_ranges ones, resolving the address indices through
    the unit's address table *)

(* a counted location description: a ULEB128 length and that many bytes *)
let parse_counted_location_description : parser single_location_description =
  fun (pc: parse_context) -> pr_bind (parse_ULEB128 pc) (fun n pc' -> parse_n_bytes n pc')

let parse_loclist_entry c (cuh: compilation_unit_header) : parser (maybe loclist_entry) =
  fun (pc: parse_context) ->
    pr_bind (parse_uint8 pc) (fun kind pc1 ->
      let addr = parse_uint_address_size c cuh.cuh_address_size in
      let k = sym_natural_offset_part kind in
      if k = 0 then PR_success Nothing pc1     (* DW_LLE_end_of_list ends the list *)
      else if k = 1 then pr_map (fun i -> Just (LLE_base_addressx i)) (parse_ULEB128 pc1)
      else if k = 2 then pr_map (fun (i,(j,bs)) -> Just (LLE_startx_endx i j bs)) (parse_triple parse_ULEB128 parse_ULEB128 parse_counted_location_description pc1)
      else if k = 3 then pr_map (fun (i,(n,bs)) -> Just (LLE_startx_length i n bs)) (parse_triple parse_ULEB128 parse_ULEB128 parse_counted_location_description pc1)
      else if k = 4 then pr_map (fun (a,(b,bs)) -> Just (LLE_offset_pair a b bs)) (parse_triple parse_ULEB128 parse_ULEB128 parse_counted_location_description pc1)
      else if k = 5 then pr_map (fun bs -> Just (LLE_default_location bs)) (parse_counted_location_description pc1)
      else if k = 6 then pr_map (fun a -> Just (LLE_base_address a)) (addr pc1)
      else if k = 7 then pr_map (fun (a,(b,bs)) -> Just (LLE_start_end a b bs)) (parse_triple addr addr parse_counted_location_description pc1)
      else if k = 8 then pr_map (fun (a,(n,bs)) -> Just (LLE_start_length a n bs)) (parse_triple addr parse_ULEB128 parse_counted_location_description pc1)
      else PR_fail ("unknown DW_LLE kind " ^ show k) pc)

let parse_rnglist_entry c (cuh: compilation_unit_header) : parser (maybe rnglist_entry) =
  fun (pc: parse_context) ->
    pr_bind (parse_uint8 pc) (fun kind pc1 ->
      let addr = parse_uint_address_size c cuh.cuh_address_size in
      let k = sym_natural_offset_part kind in
      if k = 0 then PR_success Nothing pc1     (* DW_RLE_end_of_list ends the list *)
      else if k = 1 then pr_map (fun i -> Just (RLE_base_addressx i)) (parse_ULEB128 pc1)
      else if k = 2 then pr_map (fun (i,j) -> Just (RLE_startx_endx i j)) (parse_pair parse_ULEB128 parse_ULEB128 pc1)
      else if k = 3 then pr_map (fun (i,n) -> Just (RLE_startx_length i n)) (parse_pair parse_ULEB128 parse_ULEB128 pc1)
      else if k = 4 then pr_map (fun (a,b) -> Just (RLE_offset_pair a b)) (parse_pair parse_ULEB128 parse_ULEB128 pc1)
      else if k = 5 then pr_map (fun a -> Just (RLE_base_address a)) (addr pc1)
      else if k = 6 then pr_map (fun (a,b) -> Just (RLE_start_end a b)) (parse_pair addr addr pc1)
      else if k = 7 then pr_map (fun (a,n) -> Just (RLE_start_length a n)) (parse_pair addr parse_ULEB128 pc1)
      else PR_fail ("unknown DW_RLE kind " ^ show k) pc)

(* the list starting at a section offset (the entries up to its end-of-list) *)
let loclist_at (str: unit_context) (offset: sym_natural) : maybe (list loclist_entry) =
  match sym_dropbytes (sym_natural_offset_part offset) (section_or_empty str.uc_sections.sec_loclists) with
  | Fail _ -> Nothing
  | Success bs ->
      match parse_list (parse_loclist_entry str.uc_c str.uc_cuh) <| pc_bytes = bs; pc_offset = sym_natural_offset_part offset |> with
      | PR_success es _ -> Just es
      | PR_fail _ _ -> Nothing
      end
  end

let rnglist_at (str: unit_context) (offset: sym_natural) : maybe (list rnglist_entry) =
  match sym_dropbytes (sym_natural_offset_part offset) (section_or_empty str.uc_sections.sec_rnglists) with
  | Fail _ -> Nothing
  | Success bs ->
      match parse_list (parse_rnglist_entry str.uc_c str.uc_cuh) <| pc_bytes = bs; pc_offset = sym_natural_offset_part offset |> with
      | PR_success es _ -> Just es
      | PR_fail _ _ -> Nothing
      end
  end

let addrx_or_zero (str: unit_context) (i: sym_natural) : sym_natural =
  match addrx_address str i with Just a -> a | Nothing -> 0 end

(* the default location entry, if any, comes last, so that a bounded entry that
   covers the pc wins *)
let rec interpret_loclist (str: unit_context) (base: sym_natural) (es: list loclist_entry) : list (sym_natural * sym_natural * single_location_description) =
  match es with
  | [] -> []
  | LLE_end_of_list :: _ -> []
  | LLE_base_addressx i :: es' -> interpret_loclist str (addrx_or_zero str i) es'
  | LLE_base_address a :: es' -> interpret_loclist str a es'
  | LLE_offset_pair lo hi bs :: es' -> (base + lo, base + hi, bs) :: interpret_loclist str base es'
  | LLE_startx_endx i j bs :: es' -> (addrx_or_zero str i, addrx_or_zero str j, bs) :: interpret_loclist str base es'
  | LLE_startx_length i n bs :: es' -> let a = addrx_or_zero str i in (a, a + n, bs) :: interpret_loclist str base es'
  | LLE_start_end a b bs :: es' -> (a, b, bs) :: interpret_loclist str base es'
  | LLE_start_length a n bs :: es' -> (a, a + n, bs) :: interpret_loclist str base es'
  | LLE_default_location bs :: es' -> interpret_loclist str base es' ++ [(0, max_address str.uc_cuh.cuh_address_size, bs)]
  end

let rec interpret_rnglist (str: unit_context) (base: sym_natural) (es: list rnglist_entry) : list (sym_natural * sym_natural) =
  match es with
  | [] -> []
  | RLE_end_of_list :: _ -> []
  | RLE_base_addressx i :: es' -> interpret_rnglist str (addrx_or_zero str i) es'
  | RLE_base_address a :: es' -> interpret_rnglist str a es'
  | RLE_offset_pair lo hi :: es' -> (base + lo, base + hi) :: interpret_rnglist str base es'
  | RLE_startx_endx i j :: es' -> (addrx_or_zero str i, addrx_or_zero str j) :: interpret_rnglist str base es'
  | RLE_startx_length i n :: es' -> let a = addrx_or_zero str i in (a, a + n) :: interpret_rnglist str base es'
  | RLE_start_end a b :: es' -> (a, b) :: interpret_rnglist str base es'
  | RLE_start_length a n :: es' -> (a, a + n) :: interpret_rnglist str base es'
  end

(* the interpreted location list an attribute value denotes: a DWARF 4 .debug_loc
   offset (a unit of version < 5), or a DWARF 5 .debug_loclists offset or index;
   the offsets are relative to the unit's base address unless the list selects
   another *)
let location_list_of_attribute_value (str: unit_context) (av: attribute_value) : maybe (list (sym_natural * sym_natural * single_location_description)) =
  match av with
  | AV_sec_offset n ->
      if unit_version str < 5 then
        match List.find (fun (n', _) -> sym_eq n' n) str.uc_loc with
        | Just (_, llis) -> Just (interpret_location_list str.uc_base_address llis)
        | Nothing -> Nothing
        end
      else
        match loclist_at str n with
        | Just es -> Just (interpret_loclist str str.uc_base_address es)
        | Nothing -> Nothing
        end
  | AV_loclistx i ->
      match loclistx_offset str i with
      | Just off ->
          match loclist_at str off with
          | Just es -> Just (interpret_loclist str str.uc_base_address es)
          | Nothing -> Nothing
          end
      | Nothing -> Nothing
      end
  | _ -> Nothing
  end

let rec ranges_of_attribute_value (str: unit_context) (av: attribute_value) : maybe (list (sym_natural * sym_natural)) =
  match av with
  (* Claude: DWARF 2/3 producers give DW_AT_ranges as data4/data8 *)
  | AV_block _ bs -> ranges_of_attribute_value str (AV_sec_offset (sym_natural_of_bytes str.uc_c.endianness bs))
  | AV_constantN _ bs -> ranges_of_attribute_value str (AV_sec_offset (sym_natural_of_bytes str.uc_c.endianness bs))
  | AV_sec_offset n ->
      if unit_version str < 5 then
        match find_range_list str.uc_ranges n with
        | Just (_, rlis) -> Just (interpret_range_list str.uc_base_address rlis)
        | Nothing -> Nothing
        end
      else
        match rnglist_at str n with
        | Just es -> Just (interpret_rnglist str str.uc_base_address es)
        | Nothing -> Nothing
        end
  | AV_rnglistx i ->
      match rnglistx_offset str i with
      | Just off ->
          match rnglist_at str off with
          | Just es -> Just (interpret_rnglist str str.uc_base_address es)
          | Nothing -> Nothing
          end
      | Nothing -> Nothing
      end
  | _ -> Nothing
  end

(** frame information, pp and parsing *)

(* readelf example

Contents of the .debug_frame section:

00000000 0000000c ffffffff CIE
  Version:               1
  Augmentation:          ""
  Code alignment factor: 4
  Data alignment factor: -8
  Return address column: 65

  DW_CFA_def_cfa: r1 ofs 0

00000010 00000024 00000000 FDE cie=00000000 pc=100000b0..10000120
  DW_CFA_advance_loc: 8 to 100000b8
  DW_CFA_def_cfa_offset: 80
  DW_CFA_offset: r31 at cfa-8
  DW_CFA_advance_loc: 4 to 100000bc
  DW_CFA_def_cfa_register: r31
  DW_CFA_advance_loc: 80 to 1000010c
  DW_CFA_def_cfa: r1 ofs 0
  DW_CFA_nop
  DW_CFA_nop
  DW_CFA_nop
  DW_CFA_nop

00000038 00000024 00000000 FDE cie=00000000 pc=10000120..100001a4
  DW_CFA_advance_loc: 16 to 10000130
  DW_CFA_def_cfa_offset: 144
  DW_CFA_offset_extended_sf: r65 at cfa+16
  DW_CFA_offset: r31 at cfa-8
  DW_CFA_advance_loc: 4 to 10000134
  DW_CFA_def_cfa_register: r31
  DW_CFA_advance_loc: 84 to 10000188
  DW_CFA_def_cfa: r1 ofs 0
*)



let pp_cfa_address a = pphex_sym a
let pp_cfa_block b = ppbytes b
let pp_cfa_delta d = pphex_sym d
(*let pp_cfa_offset n = pphex n
let pp_cfa_register r = show r*)
let pp_cfa_sfoffset i = show i

let pp_cfa_register r = "r"^show r (*TODO: arch-specific register names *)

let pp_cfa_offset (i:sym_integer) = if i=0 then "" else if i<0 then show i else "+" ^ show i

let pp_cfa_rule (cr:cfa_rule) : string =
  match cr with
  | CR_undefined -> "u"
  | CR_register r i -> pp_cfa_register r ^ pp_cfa_offset i
  | CR_expression bs -> "exp"
  end

let pp_register_rule (rr:register_rule) : string =  (*TODO make this more readelf-like *)
  match rr with
  | RR_undefined -> "u"
  | RR_same_value -> "s"
  | RR_offset i -> "c" ^ pp_cfa_offset i
  | RR_val_offset i -> "val(c" ^ pp_cfa_offset i ^ ")"
  | RR_register r -> pp_cfa_register r
  | RR_expression bs -> "exp"
  | RR_val_expression bs -> "val(exp)"
  | RR_architectural -> ""
  end



let pp_call_frame_instruction i =
  match i with
  | DW_CFA_advance_loc d          -> "DW_CFA_advance_loc" ^ " " ^ pp_cfa_delta d
  | DW_CFA_offset r n             -> "DW_CFA_offset" ^ " " ^ pp_cfa_register r ^ " " ^ pp_cfa_offset (symIntegerFromNatural n)
  | DW_CFA_restore r              -> "DW_CFA_restore" ^ " " ^ pp_cfa_register r
  | DW_CFA_nop                    -> "DW_CFA_nop"
  | DW_CFA_set_loc a              -> "DW_CFA_set_loc" ^ " " ^ pp_cfa_address a
  | DW_CFA_advance_loc1 d         -> "DW_CFA_advance_loc1" ^ " " ^ pp_cfa_delta d
  | DW_CFA_advance_loc2 d         -> "DW_CFA_advance_loc2" ^ " " ^ pp_cfa_delta d
  | DW_CFA_advance_loc4 d         -> "DW_CFA_advance_loc4" ^ " " ^ pp_cfa_delta d
  | DW_CFA_offset_extended r n    -> "DW_CFA_offset_extended" ^ " " ^ pp_cfa_register r ^ " " ^ pp_cfa_offset (symIntegerFromNatural n)
  | DW_CFA_restore_extended r     -> "DW_CFA_restore_extended" ^ " " ^ pp_cfa_register r
  | DW_CFA_undefined r            -> "DW_CFA_undefined" ^ " " ^ pp_cfa_register r
  | DW_CFA_same_value r           -> "DW_CFA_same_value" ^ " " ^ pp_cfa_register r
  | DW_CFA_register r1 r2         -> "DW_CFA_register" ^ " " ^ pp_cfa_register r1 ^ " " ^ pp_cfa_register r2
  | DW_CFA_remember_state         -> "DW_CFA_remember_state"
  | DW_CFA_restore_state          -> "DW_CFA_restore_state"
  | DW_CFA_def_cfa r n            -> "DW_CFA_def_cfa" ^ " " ^ pp_cfa_register r ^ " " ^ pp_cfa_offset (symIntegerFromNatural n)
  | DW_CFA_def_cfa_register r     -> "DW_CFA_def_cfa_register" ^ " " ^ pp_cfa_register r
  | DW_CFA_def_cfa_offset n       -> "DW_CFA_def_cfa_offset" ^ " " ^ pp_cfa_offset (symIntegerFromNatural n)
  | DW_CFA_def_cfa_expression b   -> "DW_CFA_def_cfa_expression" ^ " " ^ pp_cfa_block b
  | DW_CFA_expression r b         -> "DW_CFA_expression" ^ " " ^ pp_cfa_register r ^ " " ^ pp_cfa_block b
  | DW_CFA_offset_extended_sf r i -> "DW_CFA_offset_extended_sf" ^ " " ^ pp_cfa_register r ^ " " ^ pp_cfa_sfoffset i
  | DW_CFA_def_cfa_sf r i         -> "DW_CFA_def_cfa_sf" ^ " " ^ pp_cfa_register r ^ " " ^ pp_cfa_sfoffset i
  | DW_CFA_def_cfa_offset_sf i    -> "DW_CFA_def_cfa_offset_sf" ^ " " ^ pp_cfa_sfoffset i
  | DW_CFA_val_offset r n         -> "DW_CFA_val_offset" ^ " " ^ pp_cfa_register r ^ " " ^ pp_cfa_offset (symIntegerFromNatural n)
  | DW_CFA_val_offset_sf r i      -> "DW_CFA_val_offset_sf" ^ pp_cfa_register r ^ " " ^ pp_cfa_sfoffset i
  | DW_CFA_val_expression r b     -> "DW_CFA_val_expression" ^ " " ^ pp_cfa_register r ^ " " ^ pp_cfa_block b
  | DW_CFA_AARCH64_negate_ra_state        -> "DW_CFA_AARCH64_negate_ra_state"
  | DW_CFA_unknown bt             -> "DW_CFA_unknown" ^ " " ^ show bt
  end

let pp_call_frame_instructions is = String.concat "" (List.map (fun i -> "  " ^ pp_call_frame_instruction i ^ "\n") is)


let parser_of_call_frame_argument_type c cuh (cfat: call_frame_argument_type) : parser call_frame_argument_value =
    match cfat with
    | CFAT_address       -> pr_map2 (fun n -> CFAV_address n) (parse_uint_address_size c cuh.cuh_address_size)
    | CFAT_delta1        -> pr_map2 (fun n -> CFAV_delta n) (parse_uint8)
    | CFAT_delta2        -> pr_map2 (fun n -> CFAV_delta n) (parse_uint16 c)
    | CFAT_delta4        -> pr_map2 (fun n -> CFAV_delta n) (parse_uint32 c)
    | CFAT_delta_ULEB128 -> pr_map2 (fun n -> CFAV_delta n) (parse_ULEB128)
    | CFAT_offset        -> pr_map2 (fun n -> CFAV_offset n) (parse_ULEB128)
    | CFAT_sfoffset      -> pr_map2 (fun n -> CFAV_sfoffset n) (parse_SLEB128)
    | CFAT_register      -> pr_map2 (fun n -> CFAV_register n) (parse_ULEB128)
    | CFAT_block ->
      (fun pc -> pr_bind (parse_ULEB128 pc) (fun n pc' ->
        pr_map (fun bs -> CFAV_block bs) (parse_n_bytes n pc')))
    end

let parse_call_frame_instruction c cuh : parser (maybe call_frame_instruction) =
    fun pc ->
      match sym_read_char pc.pc_bytes with
      | Fail _ -> PR_success Nothing pc
      | Success (b,bs') ->
          let pc' = <| pc_bytes = bs'; pc_offset = pc.pc_offset + 1 |> in
          let ch = unsigned_char_of_byte b in
          let high_bits = unsigned_char_land ch (unsigned_char_of_natural 192) in
          let low_bits = sym_natural_const (natural_of_unsigned_char (unsigned_char_land ch (unsigned_char_of_natural 63))) in
          if high_bits = unsigned_char_of_natural 0 then
            match lookup_abCde_de low_bits call_frame_instruction_encoding with
            | Just ((args: list call_frame_argument_type), result) ->
                let ps = List.map (parser_of_call_frame_argument_type c cuh) args in
                let p =
                  pr_post_map
                    (parse_parser_list ps)
                    result in
                match p pc' with
                | PR_success (Just cfi) pc'' -> PR_success (Just cfi) pc''
                | PR_success (Nothing) pc'' -> Assert_extra.failwith "bad call frame instruction argument 1"
                | PR_fail s pc'' -> Assert_extra.failwith "bad call frame instruction argument 2"
                end
            | Nothing ->
                (*Assert_extra.failwith ("can't parse " ^ show b ^ " as call frame instruction")*)
                PR_success (Just (DW_CFA_unknown b)) pc'
            end
          else
            if high_bits = unsigned_char_of_natural 64 then
              PR_success (Just (DW_CFA_advance_loc low_bits)) pc'
            else if high_bits = unsigned_char_of_natural 192 then
              PR_success (Just (DW_CFA_restore low_bits)) pc'
            else
                let p = parser_of_call_frame_argument_type c cuh CFAT_offset in
                match p pc' with
                | PR_success (CFAV_offset n) pc'' -> PR_success (Just (DW_CFA_offset low_bits n)) pc''
                | PR_success _ pc'' -> Assert_extra.failwith "bad call frame instruction argument 3"
                | PR_fail s pc'' -> Assert_extra.failwith "bad call frame instruction argument 4"
                end
      end

let parse_call_frame_instructions c cuh : parser (list call_frame_instruction) =
    parse_list (parse_call_frame_instruction c cuh)

val parse_and_pp_call_frame_instructions : p_context -> compilation_unit_header -> sym_byte_sequence -> string
let parse_and_pp_call_frame_instructions c cuh bs =
  let pc = <|pc_bytes = bs; pc_offset = 0  |> in
  match parse_call_frame_instructions c cuh pc with
  | PR_fail s pc' -> "parse_call_frame_instructions fail: " ^ pp_parse_fail s pc'
  | PR_success is pc' ->
      pp_call_frame_instructions is
      ^ if sym_bs_length pc'.pc_bytes <> 0 then " Warning: extra non-parsed bytes" else ""
  end



let pp_call_frame_instructions' c cuh bs =
  (* ppbytes bs ^ "\n" *)
  parse_and_pp_call_frame_instructions c cuh bs



let pp_cie c cuh cie =
  pphex_sym cie.cie_offset
  ^ " " ^ pphex_sym cie.cie_length
  ^ " " ^ pphex_sym cie.cie_id
  ^ " CIE\n"
  ^ "  Version:                " ^ show cie.cie_version ^ "\n"
  ^ "  Augmentation:           \""^ show (string_of_sym_byte_sequence cie.cie_augmentation) ^ "\"\n"
  ^ "  Code alignment factor: " ^ show cie.cie_code_alignment_factor ^ "\n"
  ^ "  Data alignment factor: " ^ show cie.cie_data_alignment_factor ^ "\n"
  ^ "  Return address column: " ^ show cie.cie_return_address_register ^ "\n"
  ^ "\n"
  ^ ppbytes cie.cie_initial_instructions_bytes ^ "\n"
  ^ pp_call_frame_instructions cie.cie_initial_instructions

(*    cie_address_size: sym_natural;  (* not shown by readelf - must match compilation unit *)*)
(*    cie_segment_size: sym_natural;  (* not shown by readelf *)*)
(* readelf says "Return address column", but the DWARF spec says "Return address register" *)


let pp_fde c cuh fde =
  pphex_sym fde.fde_offset
  ^ " " ^ pphex_sym fde.fde_length
  ^ " " ^ pphex_sym fde.fde_cie_pointer  (* not what this field of readelf output is *)
  ^ " FDE"
  ^ " cie=" ^ pphex_sym fde.fde_cie_pointer (* duplicated?? *)
  ^ " pc=" ^ match fde.fde_initial_location_segment_selector with Nothing -> "" | Just segment_selector -> "("^pphex_sym segment_selector^")" end ^ pphex_sym fde.fde_initial_location_address ^ ".." ^ pphex_sym (fde.fde_initial_location_address + fde.fde_address_range) ^ "\n"
  ^ ppbytes fde.fde_instructions_bytes ^ "\n"
  ^ pp_call_frame_instructions fde.fde_instructions

let pp_frame_info_element c cuh fie =
  match fie with
  | FIE_cie cie -> pp_cie c cuh cie
  | FIE_fde fde -> pp_fde c cuh fde
  end

let pp_frame_info c cuh fi =
  "Contents of the .debug_frame section:\n\n"
  ^ String.concat "\n" (List.map (pp_frame_info_element c cuh) fi)
  ^ "\n"



let rec find_cie fi cie_id =
  match fi with
  | [] -> Assert_extra.failwith "find_cie: cie_id not found"
  | FIE_fde _ :: fi' -> find_cie fi' cie_id
  | FIE_cie cie :: fi' -> if sym_eq cie_id cie.cie_offset then cie else find_cie fi' cie_id
  end

let parse_initial_location c cuh mss mas' : parser ((maybe sym_natural) * sym_natural) = (*(segment selector and target address)*)
    (* assume segment selector size is zero unless given explicitly.  Probably we need to do something architecture-specific for earlier dwarf versions?*)
  parse_pair
    (parse_uint_segment_selector_size c (match mss with Just n -> n | Nothing -> 0 end))
    (parse_uint_address_size c (match mas' with Just n -> n | Nothing -> cuh.cuh_address_size end))


let parse_call_frame_instruction_bytes offset' ul =
  fun (pc: parse_context) ->
    parse_n_bytes (ul - (sym_natural_const pc.pc_offset - offset')) pc

let parse_frame_info_element c cuh (fi: list frame_info_element) : parser frame_info_element =
  parse_dependent
    (pr_with_pos
       (parse_dependent_pair
          (parse_unit_length c)
          (fun (df,ul) ->
            pr_with_pos
              (parse_uintDwarfN c df) (* CIE_id (cie) or CIE_pointer (fde) *)
          )))
    (fun (offset,((df,ul),(offset',cie_id))) ->
      if (cie_id =
        match df with
        | Dwarf32 -> sym_natural_of_hex "0xffffffff"
        | Dwarf64 -> sym_natural_of_hex "0xffffffffffffffff"
        end)
      then
        (* parse cie *)
        pr_post_map
          (parse_pair
             (parse_dependent_pair
                parse_uint8  (* version *)
                (fun v ->
                  parse_triple
                    parse_string (* augmentation *)
                    (if v=4 || v=46 then pr_post_map parse_uint8 (fun i->Just i) else pr_return Nothing) (* address_size *)
                    (if v=4 || v=46 then pr_post_map parse_uint8 (fun i->Just i) else pr_return Nothing)))  (* segment_size *)
             (parse_quadruple
                parse_ULEB128 (* code_alignment_factor *)
                parse_SLEB128 (* data_alignment_factor *)
                parse_ULEB128 (* return address register *)
                (parse_call_frame_instruction_bytes offset' ul)))
          (fun ( (v,(aug,(mas',mss))), (caf,(daf,(rar,bs))) ) ->
            let pc = <|pc_bytes = bs; pc_offset = 0  |> in
            match parse_call_frame_instructions c cuh pc with
            | PR_success is _ ->
                FIE_cie
                  (
                    <|
                    cie_offset = offset;
                    cie_length = ul;
                    cie_id = cie_id;
                    cie_version = v;
                    cie_augmentation = aug;
                    cie_address_size = mas';
                    cie_segment_size = mss;
                    cie_code_alignment_factor = caf;
                    cie_data_alignment_factor = daf;
                    cie_return_address_register = rar;
                    cie_initial_instructions_bytes = bs;
                    cie_initial_instructions = is;
                  |>)
            | PR_fail s _ -> Assert_extra.failwith s
            end
          )

      else
        (* parse fde *)
        let cie = find_cie fi cie_id in
        (* let _ = my_debug4 (pp_cie c cuh cie) in *)
        pr_post_map
          (parse_triple
             (parse_initial_location c cuh cie.cie_segment_size cie.cie_address_size) (*(segment selector and target address)*)
             (parse_uint_address_size c (match cie.cie_address_size with Just n -> n | Nothing -> cuh.cuh_address_size end)) (* address_range (target address) *)
             (parse_call_frame_instruction_bytes offset' ul)
          )
          (fun ( (ss,adr), (ar, bs)) ->
            let pc = <|pc_bytes = bs; pc_offset = 0  |> in
            match parse_call_frame_instructions c cuh pc with
            | PR_success is _ ->
                FIE_fde
                  (
                    <|
                    fde_offset = offset;
                    fde_length = ul;
                    fde_cie_pointer = cie_id;
                    fde_initial_location_segment_selector = ss;
                    fde_initial_location_address = adr;
                    fde_address_range = ar;
                    fde_instructions_bytes = bs;
                    fde_instructions = is;
                  |> )
            | PR_fail s _ -> Assert_extra.failwith s
            end
         )
    )

(* you can't even parse an fde without accessing the cie it refers to
(to determine the segment selector size).  Gratuitous complexity or what?
Hence the following, which should be made more tail-recursive.  *)

val parse_dependent_list' : forall 'a. (list 'a -> parser 'a) -> list 'a -> parser (list 'a)
let rec parse_dependent_list' p1 acc =
  fun pc ->
    if sym_bs_length pc.pc_bytes = 0 then
      PR_success (List.reverse acc) pc
    else
      pr_bind
        (p1 acc pc)
        (fun x pc' ->
          parse_dependent_list' p1 (x::acc) pc')

val parse_dependent_list : forall 'a. (list 'a -> parser 'a) -> parser (list 'a)
let parse_dependent_list p1 = parse_dependent_list' p1 []


let parse_frame_info c cuh : parser frame_info
      =
    parse_dependent_list (parse_frame_info_element c cuh)


(** line numbers .debug_line, pp and parsing *)

let pp_line_number_file_entry lnfe =
 "lnfe_path = " ^ string_of_sym_byte_sequence lnfe.lnfe_path ^ "\n"
^ "lnfe_directory_index " ^ show lnfe.lnfe_directory_index ^ "\n"
^ "lnfe_last_modification = " ^ show lnfe.lnfe_last_modification ^ "\n"
^ "lnfe_length = " ^ show lnfe.lnfe_length ^ "\n"
^ (match lnfe.lnfe_md5 with Just bs -> "lnfe_md5 = " ^ hex_string_of_bytes bs ^ "\n" | Nothing -> "" end)


let pp_line_number_header lnh =
  "offset =                             " ^ pphex_sym lnh.lnh_offset ^ "\n"
^ "dwarf_format =                       " ^ pp_dwarf_format lnh.lnh_dwarf_format ^ "\n"
^ "unit_length =                        " ^ show lnh.lnh_unit_length ^ "\n"
^ "version =                            " ^ show lnh.lnh_version ^ "\n"
^ "header_length =                      " ^ show lnh.lnh_header_length ^ "\n"
^ "minimum_instruction_length =         " ^ show lnh.lnh_minimum_instruction_length ^ "\n"
^ "maximum_operations_per_instruction = " ^ show lnh.lnh_maximum_operations_per_instruction ^ "\n"
^ "default_is_stmt =                    " ^ show lnh.lnh_default_is_stmt ^ "\n"
^ "line_base =                          " ^ show lnh.lnh_line_base ^ "\n"
^ "line_range =                         " ^ show lnh.lnh_line_range ^ "\n"
^ "opcode_base =                        " ^ show lnh.lnh_opcode_base ^ "\n"
^ "standard_opcode_lengths =            " ^ show lnh.lnh_standard_opcode_lengths ^ "\n"
^ "comp_dir =                           " ^ show lnh.lnh_comp_dir ^ "\n"
^ "include_directories =                " ^ String.concat ", " (List.map string_of_sym_byte_sequence  lnh.lnh_include_directories) ^ "\n"
^ "file_entries =                   \n\n" ^ String.concat "\n" (List.map pp_line_number_file_entry  lnh.lnh_file_entries) ^ "\n"

  
let pp_line_number_operation lno =
  match lno with
  | DW_LNS_copy               -> "DW_LNS_copy"
  | DW_LNS_advance_pc n       -> "DW_LNS_advance_pc" ^ " " ^ show n
  | DW_LNS_advance_line i     -> "DW_LNS_advance_line" ^ " " ^ show i
  | DW_LNS_set_file n         -> "DW_LNS_set_file" ^ " " ^ show n
  | DW_LNS_set_column n       -> "DW_LNS_set_column" ^ " " ^ show n
  | DW_LNS_negate_stmt        -> "DW_LNS_negate_stmt"
  | DW_LNS_set_basic_block    -> "DW_LNS_set_basic_block"
  | DW_LNS_const_add_pc       -> "DW_LNS_const_add_pc"
  | DW_LNS_fixed_advance_pc n -> "DW_LNS_fixed_advance_pc" ^ " " ^ show n
  | DW_LNS_set_prologue_end   -> "DW_LNS_set_prologue_end"
  | DW_LNS_set_epilogue_begin -> "DW_LNS_set_epilogue_begin"
  | DW_LNS_set_isa n          -> "DW_LNS_set_isa" ^ " " ^ show n
  | DW_LNE_end_sequence           -> "DW_LNE_end_sequence"
  | DW_LNE_set_address n          -> "DW_LNE_set_address" ^ " " ^ pphex_sym n
  | DW_LNE_define_file s n1 n2 n3 -> "DW_LNE_define_file" ^ " " ^ show s ^ " " ^ show n1 ^ " " ^ show n2 ^ " " ^ show n3
  | DW_LNE_set_discriminator n    -> "DW_LNE_set_discriminator" ^ " " ^ show n
  | DW_LN_special n           -> "DW_LN_special" ^ " " ^ show n
  end

let pp_line_number_program lnp =
  pp_line_number_header lnp.lnp_header
  ^ "[" ^ String.concat ", " (List.map pp_line_number_operation lnp.lnp_operations) ^ "]\n"



let parse_line_number_file_entry : parser (maybe line_number_file_entry)
      =
    parse_dependent
      (parse_non_empty_string)
      (fun ms ->
        match ms with
        | Nothing ->
            pr_return Nothing
        | Just s ->
            pr_post_map
              (parse_triple
                 parse_ULEB128
                 parse_ULEB128
                 parse_ULEB128
              )
              (fun (n1,(n2,n3)) ->
                (Just
                <|
                lnfe_path = s;
                lnfe_directory_index = n1;
                lnfe_last_modification = n2;
                lnfe_length = n3;
                lnfe_md5 = Nothing;
              |> )
              )
         end
      )

(* Claude: the DWARF 5 line number header (section 6.2.4).  The directory and
   file name tables are described by entry formats: a ubyte count of (content
   type, form) ULEB128 pairs, then a ULEB128 count of entries each with one value
   per pair, read with the ordinary attribute form parsers.  Path strings may be
   inline, or offsets into .debug_line_str or .debug_str, so the unit context is
   needed to resolve them. *)


let parse_lnct_entry_format : parser (list (sym_natural * sym_natural)) =
  fun (pc: parse_context) ->
    pr_bind (parse_uint8 pc) (fun n pc' ->
      parse_replicate (sym_natural_offset_part n) (parse_pair parse_ULEB128 parse_ULEB128) pc')

let rec parse_lnct_entry c (str: unit_context) (formats: list (sym_natural * sym_natural)) : parser (list (sym_natural * attribute_value)) =
  fun (pc: parse_context) ->
    match formats with
    | [] -> PR_success [] pc
    | (ct, form) :: formats' ->
        pr_bind (parser_of_attribute_form c str.uc_cuh form pc) (fun av pc' ->
          pr_map (fun avs -> (ct, av) :: avs) (parse_lnct_entry c str formats' pc'))
    end

(* the null-terminated string at offset n of a string section, as bytes *)
let section_string_bytes (sec: sym_byte_sequence) (n: sym_natural) : sym_byte_sequence =
  match sym_dropbytes (sym_natural_offset_part n) sec with
  | Fail _ -> sym_bs_empty
  | Success bs -> null_terminated_bs bs
  end

let lnct_string_bytes (str: unit_context) (av: attribute_value) : sym_byte_sequence =
  match av with
  | AV_string bs -> bs
  | AV_line_strp n -> section_string_bytes (section_or_empty str.uc_sections.sec_line_str) n
  | AV_strp n -> section_string_bytes (section_or_empty str.uc_sections.sec_str) n
  | AV_strx i -> (match strx_offset str i with Just off -> section_string_bytes (section_or_empty str.uc_sections.sec_str) off | Nothing -> sym_bs_empty end)
  | _ -> sym_bs_empty
  end

(* DW_LNCT_path = 1, DW_LNCT_directory_index = 2, DW_LNCT_timestamp = 3,
   DW_LNCT_size = 4, DW_LNCT_MD5 = 5 *)
let lnct_value (ct: natural) (avs: list (sym_natural * attribute_value)) : maybe attribute_value =
  match List.find (fun (ct', _) -> sym_natural_offset_part ct' = ct) avs with
  | Just (_, av) -> Just av
  | Nothing -> Nothing
  end

let lnct_natural c (avs: list (sym_natural * attribute_value)) (ct: natural) : sym_natural =
  match lnct_value ct avs with
  | Just (AV_constantN n _) -> n
  | Just (AV_constant_ULEB128 n) -> n
  | Just (AV_block _ bs) -> sym_natural_of_bytes c.endianness bs
  | _ -> 0
  end

let lnct_path (str: unit_context) (avs: list (sym_natural * attribute_value)) : sym_byte_sequence =
  match lnct_value 1 avs with Just av -> lnct_string_bytes str av | Nothing -> sym_bs_empty end

let line_number_file_entry_of_lnct c (str: unit_context) (avs: list (sym_natural * attribute_value)) : line_number_file_entry =
  <|
  lnfe_path = lnct_path str avs;
  lnfe_directory_index = lnct_natural c avs 2;
  lnfe_last_modification = lnct_natural c avs 3;
  lnfe_length = lnct_natural c avs 4;
  lnfe_md5 = (match lnct_value 5 avs with Just (AV_data16 bs) -> Just bs | _ -> Nothing end);
  |>

(* the entry formats, directories and file names of a header: DWARF 5 tables, or
   the DWARF 2-4 null-terminated lists (with empty formats) *)
type line_number_tables = list (sym_natural * sym_natural) * list sym_byte_sequence * list (sym_natural * sym_natural) * list line_number_file_entry

let parse_line_number_tables_v5 c (str: unit_context) : parser line_number_tables =
  fun (pc: parse_context) ->
    pr_bind (parse_lnct_entry_format pc) (fun dfmt pc1 ->
    pr_bind (parse_ULEB128 pc1) (fun dcount pc2 ->
    pr_bind (parse_replicate (sym_natural_offset_part dcount) (parse_lnct_entry c str dfmt) pc2) (fun dirs pc3 ->
    pr_bind (parse_lnct_entry_format pc3) (fun ffmt pc4 ->
    pr_bind (parse_ULEB128 pc4) (fun fcount pc5 ->
    pr_bind (parse_replicate (sym_natural_offset_part fcount) (parse_lnct_entry c str ffmt) pc5) (fun files pc6 ->
      PR_success (dfmt, List.map (lnct_path str) dirs, ffmt, List.map (line_number_file_entry_of_lnct c str) files) pc6))))))

let parse_line_number_tables_v4 : parser line_number_tables =
  fun (pc: parse_context) ->
    pr_map (fun (ids, fns) -> ([], ids, [], fns))
      (parse_pair (parse_list parse_non_empty_string) (parse_list parse_line_number_file_entry) pc)

let parse_line_number_header c (str: unit_context) (comp_dir:maybe string) : parser line_number_header =
  fun (pc: parse_context) ->
    pr_bind (pr_with_pos (parse_unit_length c) pc) (fun (pos,(df,ul)) pc1 ->
    pr_bind (parse_uint16 c pc1) (fun v pc2 ->
    let v5 = v >= sym_natural_const 5 in
    pr_bind ((if v5 then pr_map2 (fun (a,s) -> (Just a, Just s)) (parse_pair parse_uint8 parse_uint8) else pr_return (Nothing, Nothing)) pc2) (fun (mas, mss) pc3 ->
    pr_bind (parse_uintDwarfN c df pc3) (fun hl pc4 ->
    pr_bind (parse_uint8 pc4) (fun minil pc5 ->
    (* maximum_operations_per_instruction is not in DWARF 2 or 3 *)
    pr_bind ((if v < sym_natural_const 4 then parse_uint8_constant (sym_natural_const 1) else parse_uint8) pc5) (fun maxopi pc6 ->
    pr_bind (parse_quadruple parse_uint8 parse_sint8 parse_uint8 parse_uint8 pc6) (fun (dis,(lb,(lr,ob))) pc7 ->
    pr_bind (parse_n_bytes (ob - sym_natural_const 1) pc7) (fun solbs pc8 ->
    let sols = List.map sym_natural_of_byte (byte_list_of_sym_byte_sequence solbs) in
    pr_bind ((if v5 then parse_line_number_tables_v5 c str else parse_line_number_tables_v4) pc8) (fun (dfmt, ids, ffmt, fns) pc9 ->
      PR_success
        <|
        lnh_offset = pos;
        lnh_dwarf_format = df;
        lnh_unit_length = ul;
        lnh_version = v;
        lnh_header_length = hl;
        lnh_minimum_instruction_length = minil;
        lnh_maximum_operations_per_instruction = maxopi;
        lnh_default_is_stmt = (dis<>0);
        lnh_line_base = lb;
        lnh_line_range = lr;
        lnh_opcode_base = ob;
        lnh_standard_opcode_lengths = sols;
        lnh_address_size = mas;
        lnh_segment_selector_size = mss;
        lnh_directory_entry_format = dfmt;
        lnh_file_name_entry_format = ffmt;
        lnh_include_directories = ids;
        lnh_file_entries = fns;
        lnh_comp_dir = comp_dir;
        |> pc9)))))))))

let parser_of_line_number_argument_type c (cuh: compilation_unit_header) (lnat: line_number_argument_type) : parser line_number_argument_value =
    match lnat with
    | LNAT_address -> pr_map2 (fun n -> LNAV_address n) (parse_uint_address_size c cuh.cuh_address_size)
    | LNAT_ULEB128 -> pr_map2 (fun n -> LNAV_ULEB128 n) (parse_ULEB128)
    | LNAT_SLEB128 -> pr_map2 (fun i -> LNAV_SLEB128 i) (parse_SLEB128)
    | LNAT_uint16  -> pr_map2 (fun n -> LNAV_uint16 n) (parse_uint16 c)
    | LNAT_string  -> pr_map2 (fun s -> LNAV_string s) (parse_string)
    end

let parse_line_number_operation c (cuh: compilation_unit_header) (lnh: line_number_header) : parser line_number_operation =
  parse_dependent
    parse_uint8
    (fun opcode ->
      if opcode=0 then
        (* parse extended opcode *)
        parse_dependent
          (parse_pair
             parse_ULEB128
             parse_uint8)
          (fun (size,opcode') ->
            match lookup_aBcd_acd opcode' line_number_extended_encodings with
            | Just (_, arg_types, result) ->
                let ps = List.map (parser_of_line_number_argument_type c cuh) arg_types in
                parse_demaybe ("parse_line_number_operation fail")
                  (pr_post_map
                     (parse_parser_list ps)
                     result )
            | Nothing ->
                Assert_extra.failwith ("parse_line_number_operation extended opcode not found: " ^ show opcode')
            end)
            (* it's not clear what the ULEB128 size field is for, as the extended opcides all seem to have well-defined sizes.  perhaps there can be extra padding that needs to be absorbed? *)
      else if opcode >= lnh.lnh_opcode_base then
        (* parse special opcode *)
        let adjusted_opcode = opcode - lnh.lnh_opcode_base in
        pr_return (DW_LN_special adjusted_opcode)
      else
        (* parse standard opcode *)
        match lookup_aBcd_acd opcode line_number_standard_encodings with
        | Just (_, arg_types, result) ->
            let ps = List.map (parser_of_line_number_argument_type c cuh) arg_types in
            parse_demaybe ("parse_line_number_operation fail")
              (pr_post_map
                 (parse_parser_list ps)
                 result)
        | Nothing ->
            Assert_extra.failwith ("parse_line_number_operation standard opcode not found: " ^ show opcode)
              (* the standard_opcode_lengths machinery is intended to allow vendor specific extension instructions to be parsed and ignored, but here we couldn't usefully process such instructions in any case, so we just fail *)
        end)


let parse_line_number_operations c (cuh:compilation_unit_header) (lnh:line_number_header) : parser (list line_number_operation) =
    parse_list (parse_maybe (parse_line_number_operation c cuh lnh))


        (* assume operations start immediately after the header - not completely clear in DWARF whether the header_length is just an optimisation or whether it's intended to allow the operations to start later *)
        (* line number operations have no no-op and no termination operation, so we have to cut down the available bytes to the right length *)

let parse_line_number_program c (cuh:compilation_unit_header) (str: unit_context) (comp_dir:maybe string) : parser line_number_program =
    parse_dependent
      (parse_line_number_header c str comp_dir)
      (fun lnh ->
        (* Claude: the header_length counts from after that field to the first
           opcode; before it come the version and, in DWARF 5, the address_size and
           segment_selector_size bytes *)
        let byte_count_of_operations =
          lnh.lnh_unit_length - (lnh.lnh_header_length + 2 + (if lnh.lnh_version >= sym_natural_const 5 then 2 else 0) + (match lnh.lnh_dwarf_format with Dwarf32 -> 4 | Dwarf64 -> 8 end)) in
       pr_post_map
         (parse_restrict_length
           byte_count_of_operations
           (parse_line_number_operations c cuh lnh)
         )
         (fun ops ->
           <|
           lnp_header = lnh;
           lnp_operations = ops;
         |>)
     )

(*TODO: this should use find_natural_attribute_value_of_die *)  
(* Claude: a unit's line information is optional: [Nothing] when it has no
   DW_AT_stmt_list (hand-written or partial units, and the units of some
   producers), which readelf and objdump simply accept. *)
let line_number_offset_of_compilation_unit c cu : maybe sym_natural =
  (* Claude: the offset is normalised to its offset part: in a relocatable file
     it is a relocation against .debug_line, whose addend is the offset. *)
  let offset_of v = Just (sym_natural_const (sym_natural_offset_part v)) in
  match find_attribute_value "DW_AT_stmt_list" cu.cu_die with
  | Just (AV_sec_offset n) -> offset_of n
  | Just (AV_block n bs) ->
        (* a 32-bit MIPS example used a 4-byte AV_block not AV_sec_offset; LLVM's
           DWARF 2 and 3 output uses DW_FORM_data4 too, relocated in an object
           file, so the bytes are read as the parsers read them (Claude) *)
        match (if n = 8 then parse_uint64 c else parse_uint32 c) <| pc_bytes = bs; pc_offset = 0 |> with
        | PR_success v _ -> offset_of v
        | PR_fail _ _ -> Nothing
        end
  | _ -> Nothing
  end

let line_number_program_of_compilation_unit d cu =
  let c = p_context_of_d d in
  match line_number_offset_of_compilation_unit c cu with
  | Nothing -> Assert_extra.failwith ("compilation unit did not have a DW_AT_stmt_list attribute\n" ^ pp_compilation_unit_header cu.cu_header ^ "\n")
  | Just offset ->
    match List.find (fun lnp -> sym_eq lnp.lnp_header.lnh_offset offset) d.d_line_info with
    | Nothing -> Assert_extra.failwith "compilation unit line number offset not found"
    | Just lnp ->lnp
    end
  end

(* Claude: version-appropriate lookups in the directory and file tables: 0-based in
   DWARF 5, 1-based before, with index 0 in either case standing for the
   compilation directory (so no directory) / the primary source file; DWARF 5's
   entry 0 of the directory table is the compilation directory itself, which is
   already known from DW_AT_comp_dir *)
let lnh_directory (lnh: line_number_header) (i: sym_natural) : maybe sym_byte_sequence =
  if i = 0 then Nothing
  else if lnh.lnh_version >= sym_natural_const 5 then mynth i lnh.lnh_include_directories
  else mynth (i - 1) lnh.lnh_include_directories

let lnh_file (lnh: line_number_header) (i: sym_natural) : maybe line_number_file_entry =
  if lnh.lnh_version >= sym_natural_const 5 then mynth i lnh.lnh_file_entries
  else if i = 0 then Nothing
  else mynth (i - 1) lnh.lnh_file_entries

let filename d cu n =
  let lnp = line_number_program_of_compilation_unit d cu in
  if n=0 && lnp.lnp_header.lnh_version < sym_natural_const 5 then Nothing else
    match lnh_file lnp.lnp_header n with
    | Just lnfe ->
       Just (string_of_sym_byte_sequence lnfe.lnfe_path)
    | Nothing ->
       Assert_extra.failwith ("line number file entry not found")
    end

let unpack_file_entry lnh file : unpacked_file_entry = 
  match lnh_file lnh file with
  | Just lnfe ->
     let directory =
       if lnfe.lnfe_directory_index = 0 then
         Nothing 
       else
         match lnh_directory lnh lnfe.lnfe_directory_index with
         | Just d -> Just (string_of_sym_byte_sequence d)
         | Nothing -> Just "<unpack_file_entry: directory entry not found>"
         end
     in
     (lnh.lnh_comp_dir, directory, string_of_sym_byte_sequence lnfe.lnfe_path)
   | Nothing ->
     (Nothing,Nothing,"<unpack_file_entry: file entry not found>")
   end


let pp_ufe (((mcomp_dir,mdir,file) as ufe) : unpacked_file_entry) : string = 
  file
  ^ " dir=" ^ match mdir with | Just s->s|Nothing->"<none>" end
  ^ " comp_dir=" ^ match mcomp_dir with | Just s->s|Nothing->"<none>" end

let pp_ud (((((mcomp_dir,mdir,file) as ufe) : unpacked_file_entry), (line:nat), (subprogram_name:string)) : unpacked_decl) : string = 
  file
  ^ ":" ^ show line
  ^ " " ^ subprogram_name
  ^ " dir=" ^ match mdir with | Just s->s|Nothing->"<none>" end
  ^ " comp_dir=" ^ match mcomp_dir with | Just s->s|Nothing->"<none>" end

   
let pp_ufe_brief (((mcomp_dir,mdir,file) as ufe) : unpacked_file_entry) : string = 
  file
  (*
  ^ " dir=" ^ match mdir with | Just s->s|Nothing->"<none>" end
  ^ " comp_dir=" ^ match mcomp_dir with | Just s->s|Nothing->"<none>" end
   *)
   
let parse_line_number_info c str (d_line: sym_byte_sequence) (cu: compilation_unit) : maybe line_number_program =
  let comp_dir = find_string_attribute_value_of_die "DW_AT_comp_dir" str cu.cu_die in
  let f n =
    (* Claude: an offset beyond .debug_line, or a program that does not parse,
       leaves the unit without line information rather than failing *)
    match sym_dropbytes n d_line with
    | Fail _ -> Nothing
    | Success d_line' ->
      let pc = <| pc_bytes = d_line'; pc_offset = n|> in
      match parse_line_number_program c cu.cu_header str comp_dir pc with
      | PR_success lnp pc' -> Just lnp
      | PR_fail s pc' -> Nothing
      end
    end in
  match line_number_offset_of_compilation_unit c cu with
  | Nothing -> Nothing   (* Claude: a unit without line information *)
  | Just offset -> f (sym_natural_expect_const offset (*"parse_line_number_info"*))
  end

(* Claude: each unit's line table is read with that unit's context (its comp_dir
   may be an indexed string) *)
let parse_line_number_infos c (d: dwarf) compilation_units
    =
  match d.d_sections.sec_line with
  | Nothing -> []   (* no line tables *)
  | Just sec_line -> List.mapMaybe (fun cu -> parse_line_number_info c (unit_context_of_cu d cu) sec_line cu) compilation_units
  end

let pp_line_info li
    =
  String.concat "\n" (List.map (pp_line_number_program) li)


(** all dwarf info: pp and parsing *)

(** ************************************************************ *)
(** Claude: objdump-compatible pretty printing                    *)
(** ************************************************************ *)

(* Claude: The [od_*] functions reproduce the text of
   `objdump --dwarf=abbrev,info` (binutils 2.42, binutils/dwarf.c:
   display_debug_abbrev, process_debug_info, read_and_display_attr_value,
   decode_location_expression), so that `main_elf --debug-dump=dies` can be
   diffed against it.  objdump applies the relocations of a relocatable file
   using section symbols of value 0, so a relocated field shows just its
   addend; here that is the offset part of the symbolic value.  Values that
   objdump writes with C's %#x print 0 as a bare "0". *)

let od_hx (n:natural) : string = unsafe_hex_string_of_natural_alternate n
let od_hx_sym (n:sym_natural) : string = od_hx (sym_natural_offset_part n)
let od_x_sym (n:sym_natural) : string = pphexplain (sym_natural_offset_part n)
let od_dec_sym (n:sym_natural) : string = show (sym_natural_offset_part n)

(* DWARF register names, as in binutils dwarf.c; "" marks an unnamed number *)
let od_regnames_aarch64 : list string = ["x0"; "x1"; "x2"; "x3"; "x4"; "x5"; "x6"; "x7"; "x8"; "x9"; "x10"; "x11"; "x12"; "x13"; "x14"; "x15"; "x16"; "x17"; "x18"; "x19"; "x20"; "x21"; "x22"; "x23"; "x24"; "x25"; "x26"; "x27"; "x28"; "x29"; "x30"; "sp"; ""; "elr"; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; "vg"; "ffr"; "p0"; "p1"; "p2"; "p3"; "p4"; "p5"; "p6"; "p7"; "p8"; "p9"; "p10"; "p11"; "p12"; "p13"; "p14"; "p15"; "v0"; "v1"; "v2"; "v3"; "v4"; "v5"; "v6"; "v7"; "v8"; "v9"; "v10"; "v11"; "v12"; "v13"; "v14"; "v15"; "v16"; "v17"; "v18"; "v19"; "v20"; "v21"; "v22"; "v23"; "v24"; "v25"; "v26"; "v27"; "v28"; "v29"; "v30"; "v31"; "z0"; "z1"; "z2"; "z3"; "z4"; "z5"; "z6"; "z7"; "z8"; "z9"; "z10"; "z11"; "z12"; "z13"; "z14"; "z15"; "z16"; "z17"; "z18"; "z19"; "z20"; "z21"; "z22"; "z23"; "z24"; "z25"; "z26"; "z27"; "z28"; "z29"; "z30"; "z31"]
let od_regnames_x86_64 : list string = ["rax"; "rdx"; "rcx"; "rbx"; "rsi"; "rdi"; "rbp"; "rsp"; "r8"; "r9"; "r10"; "r11"; "r12"; "r13"; "r14"; "r15"; "rip"; "xmm0"; "xmm1"; "xmm2"; "xmm3"; "xmm4"; "xmm5"; "xmm6"; "xmm7"; "xmm8"; "xmm9"; "xmm10"; "xmm11"; "xmm12"; "xmm13"; "xmm14"; "xmm15"; "st0"; "st1"; "st2"; "st3"; "st4"; "st5"; "st6"; "st7"; "mm0"; "mm1"; "mm2"; "mm3"; "mm4"; "mm5"; "mm6"; "mm7"; "rflags"; "es"; "cs"; "ss"; "ds"; "fs"; "gs"; ""; ""; "fs.base"; "gs.base"; ""; ""; "tr"; "ldtr"; "mxcsr"; "fcw"; "fsw"; "xmm16"; "xmm17"; "xmm18"; "xmm19"; "xmm20"; "xmm21"; "xmm22"; "xmm23"; "xmm24"; "xmm25"; "xmm26"; "xmm27"; "xmm28"; "xmm29"; "xmm30"; "xmm31"; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; "k0"; "k1"; "k2"; "k3"; "k4"; "k5"; "k6"; "k7"]
let od_regnames_i386 : list string = ["eax"; "ecx"; "edx"; "ebx"; "esp"; "ebp"; "esi"; "edi"; "eip"; "eflags"; ""; "st0"; "st1"; "st2"; "st3"; "st4"; "st5"; "st6"; "st7"; ""; ""; "xmm0"; "xmm1"; "xmm2"; "xmm3"; "xmm4"; "xmm5"; "xmm6"; "xmm7"; "mm0"; "mm1"; "mm2"; "mm3"; "mm4"; "mm5"; "mm6"; "mm7"; "fcw"; "fsw"; "mxcsr"; "es"; "cs"; "ss"; "ds"; "fs"; "gs"; ""; ""; "tr"; "ldtr"; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; ""; "k0"; "k1"; "k2"; "k3"; "k4"; "k5"; "k6"; "k7"]

let od_regname_from_table (tbl: list string) (r:natural) : string =
  match List.index tbl (unsafe_nat_of_natural r) with
  | Just s -> if s = "" then "r" ^ show r else s
  | Nothing -> "r" ^ show r
  end

val objdump_regname : natural -> natural -> string
let objdump_regname (mach:natural) : natural -> string =
  if mach = elf_ma_aarch64 then od_regname_from_table od_regnames_aarch64
  else if mach = elf_ma_x86_64 then od_regname_from_table od_regnames_x86_64
  else if mach = elf_ma_386 then od_regname_from_table od_regnames_i386
  else (fun r -> "r" ^ show r)

(** the BFD target name objdump prints in its "file format" line *)
val objdump_target_name_64 : natural -> bool -> string
let objdump_target_name_64 (mach:natural) (little:bool) : string =
  if mach = elf_ma_aarch64 then (if little then "elf64-littleaarch64" else "elf64-bigaarch64")
  else if mach = elf_ma_x86_64 then "elf64-x86-64"
  else if mach = elf_ma_riscv then (if little then "elf64-littleriscv" else "elf64-bigriscv")
  else if mach = elf_ma_ppc64 then (if little then "elf64-powerpcle" else "elf64-powerpc")
  else if mach = elf_ma_mips then (if little then "elf64-tradlittlemips" else "elf64-tradbigmips")
  (* Claude: objdump's generic target for a machine it has no back end for *)
  else if little then "elf64-little" else "elf64-big"

(* the bytes objdump would show for a (possibly partly symbolic) byte sequence:
   symbolic parts are rendered as the offset part of their value *)
let rec od_bytes_le (n:natural) (w:natural) : list natural =
  if w = 0 then [] else (n mod 256) :: od_bytes_le (n div 256) (w - 1)

let rec od_concrete_bytes' (en:endianness) (raw: list natural) (mask: list sym_mask_entry) : list natural =
  match mask with
  | [] -> raw
  | NoSym k :: mask' ->
      let k' = unsafe_nat_of_natural k in
        List.take k' raw ++ od_concrete_bytes' en (List.drop k' raw) mask'
  | SymVal k v :: mask' ->
      let bs = od_bytes_le (sym_natural_offset_part v) k in
      let bs = match en with Little -> bs | Big -> List.reverse bs end in
        bs ++ od_concrete_bytes' en (List.drop (unsafe_nat_of_natural k) raw) mask'
  end

let od_concrete_bytes (c:p_context) (bs:sym_byte_sequence) : list natural =
  od_concrete_bytes' c.endianness (List.map natural_of_byte (byte_list_of_byte_sequence bs.sbs_bytes)) bs.sbs_symbolic

let od_value_of_bytes (c:p_context) (bs:sym_byte_sequence) : natural =
  let bytes = od_concrete_bytes c bs in
  let le = match c.endianness with Little -> bytes | Big -> List.reverse bytes end in
    List.foldr (fun b acc -> b + 256 * acc) 0 le

let od_block (c:p_context) (n:sym_natural) (bs:sym_byte_sequence) : string =
  od_dec_sym n ^ " byte block: " ^ String.concat "" (List.map (fun b -> pphexplain b ^ " ") (od_concrete_bytes c bs))


(* location expressions *)
let od_arg_nat (args: list operation_argument_value) (i:nat) : natural =
  match List.index args i with
  | Just (OAV_natural n) -> sym_natural_offset_part n
  | Just (OAV_integer n) -> let i = sym_integer_expect_const n in if i < 0 then 0 else naturalFromInteger i
  | _ -> 0
  end

let od_arg_int (args: list operation_argument_value) (i:nat) : integer =
  match List.index args i with
  | Just (OAV_integer n) -> sym_integer_expect_const n
  | Just (OAV_natural n) -> integerFromNatural (sym_natural_offset_part n)
  | _ -> 0
  end

let od_arg_block (args: list operation_argument_value) (i:nat) : maybe (sym_natural * sym_byte_sequence) =
  match List.index args i with
  | Just (OAV_block n bs) -> Just (n, bs)
  | _ -> Nothing
  end

(* Claude: how objdump renders each operator's arguments (decode_location_expression);
   operators without a row print just their name *)
type od_op_shape =
  | OdOp_addr              (* "name: %x" *)
  | OdOp_unsigned          (* "name: %u" *)
  | OdOp_signed            (* "name: %d" *)
  | OdOp_reg of natural    (* "name (%s)", register = code - base *)
  | OdOp_breg of natural   (* "name (%s): %d" *)
  | OdOp_regx              (* "name: %u (%s)" *)
  | OdOp_bregx             (* "name: %u (%s) %d" *)
  | OdOp_cu_ref            (* "name: <%#x>", CU-relative *)
  | OdOp_abs_ref           (* "name: <%#x>" *)
  | OdOp_index_ref         (* "name <%#x>" *)
  | OdOp_convert           (* "name <%#x>", CU-relative unless 0 *)
  | OdOp_implicit_pointer  (* "name: <%#x> %d" *)
  | OdOp_regval_type       (* "name: %u (%s) <%#x>" *)
  | OdOp_deref_type        (* "name: %d <%#x>" *)
  | OdOp_bit_piece         (* "name: size: %u offset: %u " *)
  | OdOp_implicit_value    (* "name N byte block: .." *)
  | OdOp_const_type        (* "name: <%#x> N byte block: .." *)
  | OdOp_nested            (* "name: (" nested expression ")" *)
  | OdOp_fixed of string   (* a fixed text *)

(* (lowest code, highest code, shape) *)
let od_op_shapes : list (natural * natural * od_op_shape) = [
  (3, 3, OdOp_addr);
  (8, 8, OdOp_unsigned); (9, 9, OdOp_signed); (10, 10, OdOp_unsigned); (11, 11, OdOp_signed);   (* const1u .. const2s *)
  (12, 12, OdOp_unsigned); (13, 13, OdOp_signed); (14, 14, OdOp_unsigned); (15, 15, OdOp_signed); (* const4u .. const8s *)
  (16, 16, OdOp_unsigned); (17, 17, OdOp_signed);          (* constu, consts *)
  (21, 21, OdOp_unsigned);                                  (* pick *)
  (35, 35, OdOp_unsigned);                                  (* plus_uconst *)
  (40, 40, OdOp_signed); (47, 47, OdOp_signed);             (* bra, skip *)
  (80, 111, OdOp_reg 80); (112, 143, OdOp_breg 112);        (* reg0..31, breg0..31 *)
  (144, 144, OdOp_regx); (145, 145, OdOp_signed); (146, 146, OdOp_bregx);  (* regx, fbreg, bregx *)
  (147, 149, OdOp_unsigned);                                (* piece, deref_size, xderef_size *)
  (152, 153, OdOp_cu_ref); (154, 154, OdOp_abs_ref);        (* call2, call4, call_ref *)
  (157, 157, OdOp_bit_piece); (158, 158, OdOp_implicit_value);
  (160, 160, OdOp_implicit_pointer); (161, 162, OdOp_index_ref); (163, 163, OdOp_nested); (164, 164, OdOp_const_type);
  (165, 165, OdOp_regval_type); (166, 167, OdOp_deref_type); (168, 169, OdOp_convert);
  (224, 224, OdOp_fixed "DW_OP_GNU_push_tls_address or DW_OP_HP_unknown");
  (242, 242, OdOp_implicit_pointer); (243, 243, OdOp_nested); (244, 244, OdOp_const_type); (245, 245, OdOp_regval_type);
  (246, 246, OdOp_deref_type); (247, 247, OdOp_convert); (249, 249, OdOp_convert);
  (250, 250, OdOp_cu_ref); (251, 252, OdOp_index_ref); (253, 253, OdOp_abs_ref)
]

val od_op : p_context -> compilation_unit_header -> (natural -> string) -> operation -> string
let rec od_op c cuh regname (op:operation) : string =
  let code = sym_natural_expect_const op.op_code in
  let args = op.op_argument_values in
  let cu_off = sym_natural_offset_part cuh.cuh_offset in
  let name = op.op_string in
  match List.find (fun (lo, hi, _) -> lo <= code && code <= hi) od_op_shapes with
  | Nothing -> name
  | Just (_, _, shape) ->
    match shape with
    | OdOp_addr -> name ^ ": " ^ pphexplain (od_arg_nat args 0)
    | OdOp_unsigned -> name ^ ": " ^ show (od_arg_nat args 0)
    | OdOp_signed -> name ^ ": " ^ show (od_arg_int args 0)
    | OdOp_reg base -> name ^ " (" ^ regname (code - base) ^ ")"
    | OdOp_breg base -> name ^ " (" ^ regname (code - base) ^ "): " ^ show (od_arg_int args 0)
    | OdOp_regx -> let r = od_arg_nat args 0 in name ^ ": " ^ show r ^ " (" ^ regname r ^ ")"
    | OdOp_bregx -> let r = od_arg_nat args 0 in name ^ ": " ^ show r ^ " (" ^ regname r ^ ") " ^ show (od_arg_int args 1)
    | OdOp_cu_ref -> name ^ ": <" ^ od_hx (od_arg_nat args 0 + cu_off) ^ ">"
    | OdOp_abs_ref -> name ^ ": <" ^ od_hx (od_arg_nat args 0) ^ ">"
    | OdOp_index_ref -> name ^ " <" ^ od_hx (od_arg_nat args 0) ^ ">"
    | OdOp_convert -> let v = od_arg_nat args 0 in name ^ " <" ^ od_hx (if v = 0 then 0 else v + cu_off) ^ ">"
    | OdOp_implicit_pointer -> name ^ ": <" ^ od_hx (od_arg_nat args 0) ^ "> " ^ show (od_arg_int args 1)
    | OdOp_regval_type -> let r = od_arg_nat args 0 in name ^ ": " ^ show r ^ " (" ^ regname r ^ ") <" ^ od_hx (cu_off + od_arg_nat args 1) ^ ">"
    | OdOp_deref_type -> name ^ ": " ^ show (od_arg_int args 0) ^ " <" ^ od_hx (cu_off + od_arg_nat args 1) ^ ">"
    | OdOp_bit_piece -> name ^ ": size: " ^ show (od_arg_nat args 0) ^ " offset: " ^ show (od_arg_nat args 1) ^ " "
    | OdOp_implicit_value -> name ^ (match od_arg_block args 0 with Just (n, bs) -> " " ^ od_block c n bs | Nothing -> "" end)
    | OdOp_const_type -> name ^ ": <" ^ od_hx (cu_off + od_arg_nat args 0) ^ "> " ^ (match od_arg_block args 1 with Just (n, bs) -> " " ^ od_block c n bs | Nothing -> "" end)
    | OdOp_nested ->
        name ^ ": ("
        ^ (match od_arg_block args 0 with
           | Just (_, bs) -> String.concat "; " (List.map (od_op c cuh regname) (parse_operations_bs c cuh bs))
           | Nothing -> ""
           end)
        ^ ")"
    | OdOp_fixed t -> t
    end
  end

let od_ops c cuh regname (ops: list operation) : string =
  String.concat "; " (List.map (od_op c cuh regname) ops)

let od_ops_need_frame_base (ops: list operation) : bool =
  List.any (fun op -> sym_natural_expect_const op.op_code = 145) ops

(* attribute classification: the codes are looked up once, at module
   initialisation, since these tests run for every attribute of every DIE *)
let od_code (s:string) : sym_natural =
  match lookup_Abc_b s attribute_encodings with Just n -> n | Nothing -> sym_natural_const 0 end
let od_codes (names: list string) : list sym_natural = List.map od_code names
let od_at_in (at:sym_natural) (codes: list sym_natural) : bool = List.any (fun c -> c = at) codes

let od_form_data1 = attribute_form_encode "DW_FORM_data1"
let od_form_data2 = attribute_form_encode "DW_FORM_data2"
let od_form_data4 = attribute_form_encode "DW_FORM_data4"
let od_form_data8 = attribute_form_encode "DW_FORM_data8"
let od_form_sec_offset = attribute_form_encode "DW_FORM_sec_offset"
let od_form_exprloc = attribute_form_encode "DW_FORM_exprloc"
let od_form_loclistx = attribute_form_encode "DW_FORM_loclistx"
let od_form_block = attribute_form_encode "DW_FORM_block"
let od_form_block1 = attribute_form_encode "DW_FORM_block1"
let od_form_block2 = attribute_form_encode "DW_FORM_block2"
let od_form_block4 = attribute_form_encode "DW_FORM_block4"

(* Claude: readelf omits the block display (and the delimiter before it) for a
   block or exprloc whose first byte is DW_OP_addrx (0xa1), printing just the
   decoded expression that follows *)
let od_addrx_block (c:p_context) (af:sym_natural) (av:attribute_value) : bool =
  let block_form = af = od_form_exprloc || af = od_form_block || af = od_form_block1 || af = od_form_block2 || af = od_form_block4 in
  match av with
  | AV_exprloc _ bs -> block_form && (match od_concrete_bytes c bs with b :: _ -> b = 161 | [] -> false end)
  | AV_block _ bs -> block_form && (match od_concrete_bytes c bs with b :: _ -> b = 161 | [] -> false end)
  | _ -> false
  end

(* Claude: 16 bytes as hex digits, for a DW_FORM_data16 value *)
let od_hex_bytes (bs: sym_byte_sequence) : string = hex_string_of_bytes bs

let od_location_attrs = ["DW_AT_frame_base"; "DW_AT_location"; "DW_AT_string_length";   (* Claude: not DW_AT_GNU_locviews, which objdump prints without "(location list)" *)
  "DW_AT_return_addr"; "DW_AT_data_member_location"; "DW_AT_vtable_elem_location"; "DW_AT_segment";
  "DW_AT_static_link"; "DW_AT_use_location"; "DW_AT_call_value"; "DW_AT_GNU_call_site_value";
  "DW_AT_call_data_value"; "DW_AT_GNU_call_site_data_value"; "DW_AT_call_target"; "DW_AT_GNU_call_site_target";
  "DW_AT_call_target_clobbered"; "DW_AT_GNU_call_site_target_clobbered"]
let od_base_attrs = ["DW_AT_loclists_base"; "DW_AT_rnglists_base"; "DW_AT_str_offsets_base"]
let od_expr_attrs = ["DW_AT_allocated"; "DW_AT_associated"; "DW_AT_data_location"; "DW_AT_byte_stride";
  "DW_AT_upper_bound"; "DW_AT_lower_bound"; "DW_AT_rank"]
let od_exprloc_only_attrs = ["DW_AT_data_bit_offset"; "DW_AT_byte_size"; "DW_AT_bit_size";
  "DW_AT_string_length_byte_size"; "DW_AT_string_length_bit_size"; "DW_AT_bit_stride"]
let od_location_codes = od_codes od_location_attrs
let od_base_codes = od_codes od_base_attrs
let od_expr_codes = od_codes od_expr_attrs
let od_exprloc_only_codes = od_codes od_exprloc_only_attrs
let od_nonloclist_base_codes = od_codes ["DW_AT_rnglists_base"; "DW_AT_str_offsets_base"]
let od_at_inline = od_code "DW_AT_inline"
let od_at_language = od_code "DW_AT_language"
let od_at_encoding = od_code "DW_AT_encoding"
let od_at_accessibility = od_code "DW_AT_accessibility"
let od_at_visibility = od_code "DW_AT_visibility"
let od_at_endianity = od_code "DW_AT_endianity"
let od_at_virtuality = od_code "DW_AT_virtuality"
let od_at_identifier_case = od_code "DW_AT_identifier_case"
let od_at_calling_convention = od_code "DW_AT_calling_convention"
let od_at_ordering = od_code "DW_AT_ordering"
let od_at_decimal_sign = od_code "DW_AT_decimal_sign"
let od_at_defaulted = od_code "DW_AT_defaulted"

let od_lang (u:natural) : string =
  if u = 1 then "ANSI C" else if u = 2 then "non-ANSI C" else if u = 3 then "Ada" else if u = 4 then "C++"
  else if u = 5 then "Cobol 74" else if u = 6 then "Cobol 85" else if u = 7 then "FORTRAN 77" else if u = 8 then "Fortran 90"
  else if u = 9 then "ANSI Pascal" else if u = 10 then "Modula 2" else if u = 11 then "Java" else if u = 12 then "ANSI C99"
  else if u = 13 then "ADA 95" else if u = 14 then "Fortran 95" else if u = 15 then "PLI" else if u = 16 then "Objective C"
  else if u = 17 then "Objective C++" else if u = 18 then "Unified Parallel C" else if u = 19 then "D" else if u = 20 then "Python"
  else if u = 21 then "OpenCL" else if u = 22 then "Go" else if u = 23 then "Modula 3" else if u = 24 then "Haskell"
  else if u = 25 then "C++03" else if u = 26 then "C++11" else if u = 27 then "OCaml" else if u = 28 then "Rust"
  else if u = 29 then "C11" else if u = 30 then "Swift" else if u = 31 then "Julia" else if u = 32 then "Dylan"
  else if u = 33 then "C++14" else if u = 34 then "Fortran 03" else if u = 35 then "Fortran 08" else if u = 36 then "RenderScript"
  else if u = 32769 then "MIPS assembler" else if u = 34661 then "Unified Parallel C"
  else if u >= 32768 && u <= 65535 then "implementation defined: " ^ od_hx u
  else "unknown: " ^ od_hx u

let od_ate (u:natural) : string =
  if u = 0 then "(void)" else if u = 1 then "(machine address)" else if u = 2 then "(boolean)"
  else if u = 3 then "(complex float)" else if u = 4 then "(float)" else if u = 5 then "(signed)"
  else if u = 6 then "(signed char)" else if u = 7 then "(unsigned)" else if u = 8 then "(unsigned char)"
  else if u = 9 then "(imaginary float)" else if u = 10 then "(packed_decimal)" else if u = 11 then "(numeric_string)"
  else if u = 12 then "(edited)" else if u = 13 then "(signed_fixed)" else if u = 14 then "(unsigned_fixed)"
  else if u = 15 then "(decimal float)" else if u = 16 then "(unicode string)" else if u = 17 then "(UCS)" else if u = 18 then "(ASCII)"
  else if u = 128 then "(HP_float80)" else if u = 129 then "(HP_complex_float80)" else if u = 130 then "(HP_float128)"
  else if u = 131 then "(HP_complex_float128)" else if u = 132 then "(HP_floathpintel)" else if u = 133 then "(HP_imaginary_float80)"
  else if u = 134 then "(HP_imaginary_float128)"
  else if u >= 128 && u <= 255 then "(user defined type)"
  else "(unknown type)"

(* the "\t(...)" annotation objdump adds after certain attributes' values *)
let od_annotation (at:sym_natural) (u:natural) : string =
  if at = od_at_inline then
    "\t" ^ (if u = 0 then "(not inlined)" else if u = 1 then "(inlined)" else if u = 2 then "(declared as inline but ignored)"
            else if u = 3 then "(declared as inline and inlined)" else "  (Unknown inline attribute value: " ^ od_hx u ^ ")")
  else if at = od_at_language then "\t(" ^ od_lang u ^ ")"
  else if at = od_at_encoding then "\t" ^ od_ate u
  else if at = od_at_accessibility then
    "\t" ^ (if u = 1 then "(public)" else if u = 2 then "(protected)" else if u = 3 then "(private)" else "(unknown accessibility)")
  else if at = od_at_visibility then
    "\t" ^ (if u = 1 then "(local)" else if u = 2 then "(exported)" else if u = 3 then "(qualified)" else "(unknown visibility)")
  else if at = od_at_endianity then
    "\t" ^ (if u = 0 then "(default)" else if u = 1 then "(big)" else if u = 2 then "(little)"
            else if u >= 64 && u <= 255 then "(user specified)" else "(unknown endianity)")
  else if at = od_at_virtuality then
    "\t" ^ (if u = 0 then "(none)" else if u = 1 then "(virtual)" else if u = 2 then "(pure_virtual)" else "(unknown virtuality)")
  else if at = od_at_identifier_case then
    "\t" ^ (if u = 0 then "(case_sensitive)" else if u = 1 then "(up_case)" else if u = 2 then "(down_case)"
            else if u = 3 then "(case_insensitive)" else "(unknown case)")
  else if at = od_at_calling_convention then
    "\t" ^ (if u = 1 then "(normal)" else if u = 2 then "(program)" else if u = 3 then "(nocall)"
            else if u = 4 then "(pass by ref)" else if u = 5 then "(pass by value)"
            else if u = 64 then "(Rensas SH)" else if u = 65 then "(Borland fastcall i386)"
            else if u >= 64 && u <= 255 then "(user defined)" else "(unknown convention)")
  else if at = od_at_ordering then
    "\t" ^ (if u = 0 then "(row major)" else if u = 1 then "(column major)" else "(undefined)")
  else if at = od_at_decimal_sign then
    "\t" ^ (if u = 1 then "(unsigned)" else if u = 2 then "(leading overpunch)" else if u = 3 then "(trailing overpunch)"
            else if u = 4 then "(leading separate)" else if u = 5 then "(trailing separate)" else "(unrecognised)")
  else if at = od_at_defaulted then
    "\t" ^ (if u = 0 then "(no)" else if u = 1 then "(in class)" else if u = 2 then "(out of class)" else "(unrecognised)")
  else ""

(* the value of an attribute as an unsigned constant, as objdump's uvalue *)
let od_uvalue (c:p_context) (small_data:bool) (wide_data:bool) (av:attribute_value) : natural =
  match av with
  | AV_block _ bs -> if small_data || wide_data then od_value_of_bytes c bs else 0
  | AV_constantN _ bs -> od_value_of_bytes c bs
  | AV_constant_ULEB128 n -> sym_natural_offset_part n
  | AV_constant_SLEB128 i -> let i = sym_integer_expect_const i in if i < 0 then 0 else naturalFromInteger i
  | AV_flag b -> if b then 1 else 0
  | AV_addr x -> sym_natural_offset_part x
  | AV_sec_offset x -> sym_natural_offset_part x
  | AV_implicit_const i -> let i = sym_integer_expect_const i in if i < 0 then 0 else naturalFromInteger i   (* Claude: DWARF 5 *)
  | AV_addrx x -> sym_natural_offset_part x
  | AV_strx x -> sym_natural_offset_part x
  | AV_loclistx x -> sym_natural_offset_part x
  | AV_rnglistx x -> sym_natural_offset_part x
  | _ -> 0
  end

val od_attribute_value : p_context -> compilation_unit_header -> unit_context -> (natural -> string) -> bool ->
  sym_natural -> sym_natural -> attribute_value -> string
let od_attribute_value c cuh str regname have_frame_base (at:sym_natural) (af:sym_natural) (av:attribute_value) : string =
  let cu_off = sym_natural_offset_part cuh.cuh_offset in
  let small_data = af = od_form_data1 || af = od_form_data2 in
  let wide_data  = af = od_form_data4 || af = od_form_data8 in
  let value =
    match av with
    | AV_addr x -> od_hx_sym x
    | AV_block n bs ->
        if small_data then show (od_value_of_bytes c bs)
        else if wide_data then od_hx (od_value_of_bytes c bs)
        else if od_addrx_block c af av then ""
        else od_block c n bs
    | AV_constantN n bs ->
        if wide_data then od_hx (od_value_of_bytes c bs) else show (od_value_of_bytes c bs)
    | AV_constant_SLEB128 i -> show (sym_integer_expect_const i)
    | AV_constant_ULEB128 n -> od_dec_sym n
    | AV_exprloc n bs -> if od_addrx_block c af av then "" else od_block c n bs
    | AV_flag b -> if b then "1" else "0"
    | AV_ref n -> "<" ^ od_hx (sym_natural_offset_part n + cu_off) ^ ">"
    | AV_ref_addr n -> "<" ^ od_hx_sym n ^ ">"
    | AV_ref_sig8 n -> "signature: " ^ od_hx_sym n
    | AV_sec_offset n -> od_hx_sym n
    | AV_string bs -> string_of_sym_byte_sequence bs
    | AV_strp n -> "(indirect string, offset: " ^ od_hx_sym n ^ "): " ^ pp_debug_str_entry str n
    (* Claude: DWARF 5, as readelf prints them *)
    | AV_strx i -> "(indexed string: " ^ od_hx_sym i ^ "): " ^ strx_string str i
    | AV_addrx i -> "(index: " ^ od_hx_sym i ^ "): "
        ^ (match addrx_address str i with Just a -> od_hx_sym a | Nothing -> "0" end)   (* Claude: readelf prints 0 (and warns) for an index beyond the table *)
    | AV_line_strp n -> "(indirect line string, offset: " ^ od_hx_sym n ^ "): " ^ line_strp_string str n
    | AV_data16 bs -> od_hex_bytes bs
    | AV_implicit_const i -> show (sym_integer_expect_const i)
    | AV_loclistx i -> "(index: " ^ od_hx_sym i ^ "): "
        ^ (match loclistx_offset str i with Just o -> od_hx_sym o | Nothing -> "<no DW_AT_loclists_base>" end)
    | AV_rnglistx i -> "(index: " ^ od_hx_sym i ^ "): "
        ^ (match rnglistx_offset str i with Just o -> od_hx_sym o | Nothing -> "<no DW_AT_rnglists_base>" end)
    | AV_ref_sup4 n -> "<alt " ^ od_hx_sym n ^ ">"
    | AV_ref_sup8 n -> "<alt " ^ od_hx_sym n ^ ">"
    | AV_strp_sup n -> "(alt indirect string, offset: " ^ od_hx_sym n ^ ")"
    end
  in
  let block =
    match av with
    | AV_block _ bs -> if small_data || wide_data then Nothing else Just bs
    | AV_exprloc _ bs -> Just bs
    | _ -> Nothing
    end
  in
  let uvalue : natural = od_uvalue c small_data wide_data av in
  let is_loc = od_at_in at od_location_codes in
  let is_base = od_at_in at od_base_codes in
  let version = sym_natural_offset_part cuh.cuh_version in
  let loclist =
    if (is_loc || is_base)
       && (af = od_form_sec_offset || af = od_form_loclistx || (version < 4 && wide_data))
       && not (od_at_in at od_nonloclist_base_codes)
    then " (location list)" else ""
  in
  let expr =
    match block with
    | Just bs ->
        if is_loc || is_base || od_at_in at od_expr_codes
           || (od_at_in at od_exprloc_only_codes && af = od_form_exprloc) then
          let ops = parse_operations_bs c cuh bs in
            "\t(" ^ od_ops c cuh regname ops ^ ")"
            ^ (if (is_loc || is_base || od_at_in at od_expr_codes) && od_ops_need_frame_base ops && not have_frame_base
               then " [without DW_AT_frame_base]" else "")
        else ""
    | Nothing -> ""
    end
  in
    value ^ loclist ^ expr ^ od_annotation at uvalue

let od_tag_name (t:sym_natural) : string =
  match lookup_aB_a t tag_encodings with
  (* Claude: readelf's names for these two are the pre-DWARF-3 short forms *)
  | Just "DW_TAG_template_type_parameter" -> "DW_TAG_template_type_param"
  | Just "DW_TAG_template_value_parameter" -> "DW_TAG_template_value_param"
  | Just s -> s
  | Nothing ->
      let n = sym_natural_offset_part t in
        if n >= 16512 && n <= 65535 then "User TAG value: " ^ od_hx n else "Unknown TAG value: " ^ od_hx n
  end

(** byte-identical to `objdump --dwarf=info`: see [pp_die_tree] *)
val style_objdump : p_context -> unit_context -> (natural -> string) -> bool -> die_style
let style_objdump c (str:unit_context) (regname: natural -> string) (have_frame_base:bool) : die_style =
  <| ds_die_line = (fun level die ->
       " <" ^ show level ^ "><" ^ od_x_sym die.die_offset ^ ">: Abbrev Number: " ^ od_dec_sym die.die_abbreviation_code
       ^ " (" ^ od_tag_name die.die_abbreviation_declaration.ad_tag ^ ")\n")
   ; ds_attribute = (fun cuh level die (sp, (pos, av)) ->
       (* Claude: the space after the colon is the value's delimiter, absent when
          readelf prints no value text (a DW_OP_addrx block) *)
       "    <" ^ od_x_sym pos ^ ">   " ^ right_space_padded_to 18 (pp_attribute_encoding sp.as_attribute) ^ (if od_addrx_block c sp.as_form av then ":" else ": ")
       ^ od_attribute_value c cuh str regname have_frame_base sp.as_attribute sp.as_form av ^ "\n")
   ; ds_terminator = (fun level die ->
       " <" ^ show (level + 1) ^ "><" ^ pphexplain (sym_natural_offset_part die.die_end - 1) ^ ">: Abbrev Number: 0\n")
  |>

(* Claude: the unit header lines, shared by compilation and type units *)
let od_unit_header (h: compilation_unit_header) : string =
  "  Compilation Unit @ offset " ^ od_hx_sym h.cuh_offset ^ ":\n"
  ^ "   Length:        " ^ od_hx_sym h.cuh_unit_length ^ " " ^ pp_dwarf_format h.cuh_dwarf_format ^ "\n"
  ^ "   Version:       " ^ od_dec_sym h.cuh_version ^ "\n"
  ^ (match h.cuh_unit_type with   (* Claude: DWARF 5 *)
     | Just ut -> "   Unit Type:     " ^ pp_unit_type_encoding ut ^ " (" ^ od_dec_sym ut ^ ")\n"
     | Nothing -> ""
     end)
  ^ "   Abbrev Offset: " ^ od_hx_sym h.cuh_debug_abbrev_offset ^ "\n"
  ^ "   Pointer Size:  " ^ od_dec_sym h.cuh_address_size ^ "\n"
  ^ (match h.cuh_dwo_id with   (* Claude: DWARF 5 skeleton and split units *)
     | Just id -> "   DWO ID:        " ^ od_hx_sym id ^ "\n"
     | Nothing -> ""
     end)

let od_compilation_unit c str regname have_frame_base (cu:compilation_unit) : string =
  od_unit_header cu.cu_header
  ^ pp_die_tree (style_objdump c str regname have_frame_base) cu.cu_header true 0 cu.cu_die

(* Claude: a DWARF 5 type unit in .debug_info, as readelf prints it: the header
   with its signature and type offset, then the DIE tree *)
let od_type_unit c str regname have_frame_base (tu:type_unit) : string =
  let h = tu.tu_header.tuh_cuh in
  od_unit_header h
  ^ "   Signature:     " ^ od_hx_sym tu.tu_header.tuh_type_signature ^ "\n"
  ^ "   Type Offset:   " ^ od_hx_sym tu.tu_header.tuh_type_offset ^ "\n"
  ^ pp_die_tree (style_objdump c str regname have_frame_base) h true 0 tu.tu_die

(* the units of .debug_info in section order: the two lists are each in that order *)
let rec od_units_in_order c d regname have_frame_base (cus: list compilation_unit) (tus: list type_unit) : string =
  match (cus, tus) with
  | ([], []) -> ""
  | (cu :: cus', []) -> od_compilation_unit c (unit_context_of_cu d cu) regname have_frame_base cu ^ od_units_in_order c d regname have_frame_base cus' []
  | ([], tu :: tus') -> od_type_unit c (unit_context_of_tu d tu) regname have_frame_base tu ^ od_units_in_order c d regname have_frame_base [] tus'
  | (cu :: cus', tu :: tus') ->
      if cu.cu_header.cuh_offset < tu.tu_header.tuh_cuh.cuh_offset
      then od_compilation_unit c (unit_context_of_cu d cu) regname have_frame_base cu ^ od_units_in_order c d regname have_frame_base cus' tus
      else od_type_unit c (unit_context_of_tu d tu) regname have_frame_base tu ^ od_units_in_order c d regname have_frame_base cus tus'
  end

let od_abbreviation_declaration (x:abbreviation_declaration) : string =
  "   " ^ od_dec_sym x.ad_abbreviation_code ^ "      " ^ od_tag_name x.ad_tag ^ "    "
  ^ (if x.ad_has_children then "[has children]" else "[no children]") ^ "\n"
  ^ String.concat ""
      (List.map
        (fun (sp: attribute_specification) ->
          "    " ^ right_space_padded_to 18 (pp_attribute_encoding sp.as_attribute) ^ " " ^ pp_attribute_form_encoding sp.as_form
          ^ (match sp.as_implicit_const with Just i -> ": " ^ show (sym_integer_expect_const i) | Nothing -> "" end) ^ "\n")
        x.ad_attribute_specifications)
  ^ "    DW_AT value: 0     DW_FORM value: 0\n"

let od_abbreviations_table (x:abbreviations_table) : string =
  "  Number TAG (" ^ od_hx_sym x.at_offset ^ ")\n"
  ^ String.concat "" (List.map od_abbreviation_declaration x.at_table)

let od_abbreviations_tables (d:dwarf) : string =
  let xs = List.map (fun cu -> (cu.cu_header.cuh_debug_abbrev_offset, cu.cu_abbreviations_table)) d.d_compilation_units in
  let ys = remove_duplicates xs [] in
  let ys = sort_by (fun (x, _) (y, _) -> natural_ordering (sym_natural_offset_part x) (sym_natural_offset_part y)) ys in
    String.concat "" (List.map (fun (_, t) -> od_abbreviations_table t) ys)

(* objdump's have_frame_base is set on the first DW_AT_frame_base it reads in
   its initial pass over the whole section and never reset, so "[without
   DW_AT_frame_base]" only ever appears in files with no frame base at all *)
let rec od_die_has_attribute (at:sym_natural) (die:die) : bool =
  List.any (fun (sp: attribute_specification) -> sp.as_attribute = at) die.die_abbreviation_declaration.ad_attribute_specifications
  || List.any (od_die_has_attribute at) die.die_children

let od_file_has_frame_base (d:dwarf) : bool =
  match lookup_Abc_b "DW_AT_frame_base" attribute_encodings with
  | Just at -> List.any (fun cu -> od_die_has_attribute at cu.cu_die) d.d_compilation_units
  | Nothing -> false
  end

(* Claude: text of `objdump --dwarf=abbrev,info`; [regname] names DWARF registers for the machine *)
val pp_dwarf_like_objdump : bool -> (natural -> string) -> dwarf -> string
(* Claude: the two sections of objdump --dwarf=abbrev,info separately; each is
   also what readelf --debug-dump=abbrev and (non-wide) --debug-dump=info print *)
let od_debug_abbrev_section (d:dwarf) : string =
  "Contents of the .debug_abbrev section:\n\n"
  ^ od_abbreviations_tables d

let od_debug_info_section regname (d:dwarf) : string =
  let c = p_context_of_d d in
  let have_frame_base = od_file_has_frame_base d in
  "Contents of the .debug_info section:\n\n"
  ^ od_units_in_order c d regname have_frame_base d.d_compilation_units d.d_type_units

let vDW_IDX_compile_unit : natural = 1
let vDW_IDX_type_unit : natural = 2
let vDW_IDX_die_offset : natural = 3
let vDW_IDX_parent : natural = 4
let vDW_IDX_type_hash : natural = 5

let rec nth_maybe (i: natural) (xs: list 'a) : maybe 'a =
  match xs with
  | [] -> Nothing
  | x :: xs' -> if i = 0 then Just x else nth_maybe (i - 1) xs'
  end

(* the compilation unit whose DW_AT_macros (or DW_AT_GNU_macros) names a macro
   unit, else the one whose line table the unit names *)
let cu_of_macro_unit (d: dwarf) (mu: macro_unit) : maybe compilation_unit =
  let c = p_context_of_d d in
  let by_attr = List.find (fun cu ->
      List.any (fun an -> match find_attribute_value an cu.cu_die with Just (AV_sec_offset n) -> sym_natural_offset_part n = mu.mu_offset | _ -> false end)
        ["DW_AT_macros"; "DW_AT_GNU_macros"]) d.d_compilation_units in
  match by_attr with
  | Just cu -> Just cu
  | Nothing ->
      match mu.mu_debug_line_offset with
      | Just lo -> List.find (fun cu -> match line_number_offset_of_compilation_unit c cu with Just off -> sym_natural_offset_part off = sym_natural_offset_part lo | Nothing -> false end) d.d_compilation_units
      | Nothing -> Nothing
      end
  end

(** Claude: readelf-format dumps of the DWARF 5 tables and the accelerator and
    macro sections: --debug-dump=aranges, addr, str-offsets, macro, and gdb_index
    (under which readelf prints .debug_names).  Formats from readelf 2.42's output. *)

(* a string without its final newline, for the dumps readelf ends without a blank line *)
let chop_final_newline (s: string) : string =
  let nl = match String.toCharList "\n" with c :: _ -> Just c | [] -> Nothing end in
  match (List.reverse (String.toCharList s), nl) with
  | (c :: cs, Just n) -> if c = n then String.toString (List.reverse cs) else s
  | _ -> s
  end

(* a natural as 2*size hex digits *)
let od_hex_width (size: natural) (n: sym_natural) : string =
  let s = pphexplain (sym_natural_offset_part n) in
  let w = 2 * size in
  let l = naturalFromNat (String.stringLength s) in
  (if l < w then String.concat "" (List.replicate (natFromNatural (w - l)) "0") else "") ^ s

let od_debug_aranges_section (d: dwarf) : string =
  if d.d_sections.sec_aranges = Nothing then "" else
  "Contents of the .debug_aranges section:\n\n"
  ^ String.concat "" (List.map (fun ar ->
      let as' = sym_natural_offset_part ar.ar_address_size in
      "  Length:                   " ^ od_dec_sym ar.ar_unit_length ^ "\n"
      ^ "  Version:                  " ^ od_dec_sym ar.ar_version ^ "\n"
      ^ "  Offset into .debug_info:  " ^ od_hx_sym ar.ar_debug_info_offset ^ "\n"
      ^ "  Pointer Size:             " ^ od_dec_sym ar.ar_address_size ^ "\n"
      ^ "  Segment Size:             " ^ od_dec_sym ar.ar_segment_selector_size ^ "\n"
      ^ "\n    Address            Length\n"
      ^ String.concat "" (List.map (fun (_, a, l) -> "    " ^ od_hex_width as' a ^ " " ^ od_hex_width as' l ^ "\n") ar.ar_ranges)
      ^ "    " ^ od_hex_width as' 0 ^ " " ^ od_hex_width as' 0 ^ "\n") d.d_aranges)

(* the entries of an index table, whose indices are contiguous from 0 *)
let rec index_table_entries (m: Map.map natural sym_natural) (i: natural) : list (natural * sym_natural) =
  match Map.lookup i m with
  | Just a -> (i, a) :: index_table_entries m (i + 1)
  | Nothing -> []
  end

(* the address table of each unit that has one, in unit order *)
let addr_base_of_cu (cu: compilation_unit) : maybe natural =
  match sec_offset_attribute_of_die "DW_AT_addr_base" cu.cu_die with
  | Just b -> Just (sym_natural_offset_part b)
  | Nothing -> (match sec_offset_attribute_of_die "DW_AT_GNU_addr_base" cu.cu_die with Just b -> Just (sym_natural_offset_part b) | Nothing -> Nothing end)
  end

let od_debug_addr_section (d: dwarf) : string =
  match d.d_sections.sec_addr with Nothing -> "" | Just sec_addr ->
  let bases = List.mapMaybe addr_base_of_cu d.d_compilation_units in
  "Contents of the .debug_addr section:\n\n"
  ^ String.concat "" (List.mapMaybe (fun cu ->
      match addr_base_of_cu cu with
      | Nothing -> Nothing
      | Just base ->
          let as' = sym_natural_offset_part cu.cu_header.cuh_address_size in
          (* a headerless (DWARF 4) table runs to the next unit's base, as readelf shows it *)
          let limit = List.foldl (fun acc b -> if b > base && b < acc then b else acc) (sym_bs_length sec_addr) bases in
          let count = (limit - base) div as' in
          Just ("  For compilation unit at offset " ^ od_hx_sym cu.cu_header.cuh_offset ^ ":\n\tIndex\tAddress\n"
                ^ String.concat "" (List.map (fun (i, a) -> "\t" ^ show i ^ ":\t" ^ od_hex_width as' a ^ "\n")
                     (List.filter (fun (i, _) -> sym_natural_offset_part cu.cu_header.cuh_version >= 5 || i < count) (index_table_entries cu.cu_tables.ut_addrs 0))))
      end) d.d_compilation_units)
  end

(* the string offsets contributions, one after another through the section *)
let rec od_str_offsets_contributions c (sec: sym_byte_sequence) (str: maybe sym_byte_sequence) (pos: natural) : string =
  match sym_dropbytes pos sec with
  | Fail _ -> ""
  | Success bs ->
      if sym_bs_length bs = 0 then "" else
      match parse_unit_length c <| pc_bytes = bs; pc_offset = pos |> with
      | PR_fail _ _ -> ""
      | PR_success (df, ul) pc1 ->
          (* zero words between contributions are alignment padding *)
          if sym_natural_offset_part ul = 0 then od_str_offsets_contributions c sec str (pos + 4) else
          match parse_pair (parse_uint16 c) (parse_uint16 c) pc1 with
          | PR_fail _ _ -> ""
          | PR_success (v, _) pc2 ->
              let l = sym_natural_offset_part ul in
              let end_off = pc1.pc_offset + l in
              let count = if l >= 4 then (l - 4) div (offset_size df) else 0 in
              let entries =
                match parse_replicate count (parse_uintDwarfN c df) pc2 with
                | PR_success es _ -> es
                | PR_fail _ _ -> []
                end in
              "    Length: " ^ od_hx_sym ul ^ "\n    Version: " ^ od_hx_sym v ^ "\n       Index   Offset [String]\n"
              ^ String.concat "" (List.map (fun (i, off) ->
                  left_space_padded_to 12 (show i) ^ " " ^ od_hex_width (offset_size df) off ^ "  " ^ pp_debug_str_entry_bytes str off ^ "\n") (index_list 0 entries))
              ^ od_str_offsets_contributions c sec str end_off
          end
      end
  end

let od_debug_str_offsets_section (d: dwarf) : string =
  match d.d_sections.sec_str_offsets with Nothing -> "" | Just sec ->
  chop_final_newline ("Contents of the .debug_str_offsets section:\n\n"
  ^ od_str_offsets_contributions (p_context_of_d d) sec d.d_sections.sec_str 0)
  end

(* .debug_macro as readelf prints it: the unit header, then one line per entry;
   indexed strings are resolved through the unit that refers to the macro unit,
   and a start_file's file name is shown only for a DWARF 2-4 line table, as
   readelf does *)
let od_macro_unit (d: dwarf) (mu: macro_unit) : string =
  let c = p_context_of_d d in
  let mcu = cu_of_macro_unit d mu in
  let mstr = match mcu with Just cu -> Just (unit_context_of_cu d cu) | Nothing -> Nothing end in
  let mlnp = match mcu with
    | Just cu -> (match line_number_offset_of_compilation_unit c cu with
                  | Just off -> List.find (fun lnp -> sym_eq lnp.lnp_header.lnh_offset off) d.d_line_info
                  | Nothing -> Nothing end)
    | Nothing -> Nothing end in
  let strp off = pp_debug_str_entry_bytes d.d_sections.sec_str off in
  let strx i = match mstr with Just str -> strx_string str i | Nothing -> "<no compilation unit for this macro unit>" end in
  let filename fi =
    match mlnp with
    | Just lnp ->
        if lnp.lnp_header.lnh_version >= sym_natural_const 5 then "" else
        (match lnh_file lnp.lnp_header fi with
         | Just lnfe ->
             let dir = match lnh_directory lnp.lnp_header lnfe.lnfe_directory_index with Just dbs -> string_of_sym_byte_sequence dbs ^ "/" | Nothing -> "" end in
             " filename: " ^ dir ^ string_of_sym_byte_sequence lnfe.lnfe_path
         | Nothing -> "" end)
    | Nothing -> ""
    end in
  "  Offset:                      " ^ od_hx mu.mu_offset ^ "\n"
  ^ "  Version:                     " ^ od_dec_sym mu.mu_version ^ "\n"
  ^ "  Offset size:                 " ^ show (offset_size mu.mu_dwarf_format) ^ "\n"
  ^ (match mu.mu_debug_line_offset with Just lo -> "  Offset into .debug_line:     " ^ od_hx_sym lo ^ "\n" | Nothing -> "" end)
  ^ "\n"
  ^ String.concat "" (List.map (fun e ->
      match e with
      | ME_define l s -> " DW_MACRO_define - lineno : " ^ od_dec_sym l ^ " macro : " ^ string_of_sym_byte_sequence s ^ "\n"
      | ME_undef l s -> " DW_MACRO_undef - lineno : " ^ od_dec_sym l ^ " macro : " ^ string_of_sym_byte_sequence s ^ "\n"
      | ME_define_strp l off -> " DW_MACRO_define_strp - lineno : " ^ od_dec_sym l ^ " macro : " ^ strp off ^ "\n"
      | ME_undef_strp l off -> " DW_MACRO_undef_strp - lineno : " ^ od_dec_sym l ^ " macro : " ^ strp off ^ "\n"
      | ME_define_strx l i -> " DW_MACRO_define_strx lineno : " ^ od_dec_sym l ^ " macro : " ^ strx i ^ "\n"
      | ME_undef_strx l i -> " DW_MACRO_undef_strx lineno : " ^ od_dec_sym l ^ " macro : " ^ strx i ^ "\n"
      | ME_define_sup l off -> " DW_MACRO_define_sup - lineno : " ^ od_dec_sym l ^ " macro offset : " ^ od_hx_sym off ^ "\n"
      | ME_undef_sup l off -> " DW_MACRO_undef_sup - lineno : " ^ od_dec_sym l ^ " macro offset : " ^ od_hx_sym off ^ "\n"
      | ME_start_file l fi -> " DW_MACRO_start_file - lineno: " ^ od_dec_sym l ^ " filenum: " ^ od_dec_sym fi ^ filename fi ^ "\n"
      | ME_end_file -> " DW_MACRO_end_file\n"
      | ME_import off -> " DW_MACRO_import - offset : " ^ od_hx_sym off ^ "\n"
      | ME_import_sup off -> " DW_MACRO_import_sup - offset : " ^ od_hx_sym off ^ "\n"
      | ME_other o avs -> " DW_MACRO_" ^ od_hx o ^ String.concat "" (List.map (fun av -> " " ^ pp_attribute_value_plain av) avs) ^ "\n"
      end) mu.mu_entries)
  ^ "\n"

let od_debug_macro_section (d: dwarf) : string =
  if d.d_sections.sec_macro = Nothing then "" else
  chop_final_newline ("Contents of the .debug_macro section:\n\n"
  ^ String.concat "" (List.map (od_macro_unit d) d.d_macro))

(* .debug_names as readelf prints it under --debug-dump=gdb_index *)
let od_names_attribute (en: endianness) (a: sym_natural) (av: attribute_value) : string =
  let name =
    let n = sym_natural_offset_part a in
    if n = vDW_IDX_compile_unit then "DW_IDX_compile_unit"
    else if n = vDW_IDX_type_unit then "DW_IDX_type_unit"
    else if n = vDW_IDX_die_offset then "DW_IDX_die_offset"
    else if n = vDW_IDX_parent then "DW_IDX_parent"
    else if n = vDW_IDX_type_hash then "DW_IDX_type_hash"
    else "DW_IDX_" ^ od_hx n in
  let value =
    match av with
    | AV_ref r -> "<" ^ od_hx_sym r ^ ">"
    | AV_ref_addr r -> "<" ^ od_hx_sym r ^ ">"
    | AV_flag b -> if b then "1" else "0"
    | AV_constantN _ bs -> show (natural_of_bytes en bs)
    | AV_block n bs -> if n = 1 then show (natural_of_bytes en bs) else od_hx (natural_of_bytes en bs)   (* the data forms parse as blocks; readelf shows data1 in decimal, the wider ones in hex *)
    | AV_constant_ULEB128 n -> od_dec_sym n
    | AV_constant_SLEB128 i -> show (sym_integer_expect_const i)
    | _ -> pp_attribute_value_plain av
    end in
  name ^ "=" ^ value

let od_names_entry (en: endianness) (e: names_entry) : string =
  "<" ^ od_dec_sym e.ne_abbreviation.na_code ^ "> " ^ od_tag_name e.ne_abbreviation.na_tag
  ^ String.concat "" (List.map (fun (a, av) -> " " ^ od_names_attribute en a av) e.ne_values)

let od_names_index (d: dwarf) (ni: names_index) : string =
  let n (x: sym_natural) : natural = sym_natural_offset_part x in
  let bc = n ni.ni_bucket_count in
  let used = List.length (List.filter (fun b -> n b <> 0) ni.ni_buckets) in
  (* clashes: consecutive hashes in the same bucket, and the longest such run *)
  let (clashes, longest, _, _) =
    List.foldl (fun ((clashes: natural), (longest: natural), (run: natural), (prev: maybe natural)) h ->
        let hb = n h mod bc in
        match prev with
        | Just pb -> if pb = hb then (clashes + 1, (if run + 1 > longest then run + 1 else longest), run + 1, Just hb) else (clashes, longest, 0, Just hb)
        | Nothing -> (clashes, longest, 0, Just hb)
        end) (0, 0, 0, Nothing) (if bc = 0 then [] else ni.ni_hashes) in
  let aug = byte_list_of_sym_byte_sequence ni.ni_augmentation in
  "Version " ^ od_dec_sym ni.ni_version ^ "\n"
  ^ "Augmentation string: " ^ String.concat "" (List.map (fun b -> unsafe_hex_string_of_natural 2 (natural_of_byte b) ^ " ") aug)
  ^ " (\"" ^ string_of_sym_byte_sequence (null_terminated_bs ni.ni_augmentation) ^ "\")\n"
  ^ "CU table:\n" ^ String.concat "" (List.map (fun (i, off) -> "[" ^ left_space_padded_to 3 (show i) ^ "] " ^ od_hx_sym off ^ "\n") (index_list 0 ni.ni_comp_units)) ^ "\n"
  ^ "TU table:\n" ^ String.concat "" (List.map (fun (i, off) -> "[" ^ left_space_padded_to 3 (show i) ^ "] " ^ od_hx_sym off ^ "\n") (index_list 0 ni.ni_local_type_units)) ^ "\n"
  ^ "Foreign TU table:\n" ^ String.concat "" (List.map (fun (i, sg) -> "[" ^ left_space_padded_to 3 (show i) ^ "] " ^ od_hex_width 8 sg ^ "\n") (index_list 0 ni.ni_foreign_type_units)) ^ "\n"
  ^ (if bc = 0 then "Used 0 of 0 buckets.\n\n" else
       "Used " ^ show used ^ " of " ^ show bc ^ " bucket" ^ (if bc = 1 then "" else "s") ^ ".\n"
       ^ "Out of " ^ od_dec_sym ni.ni_name_count ^ " items there are " ^ show clashes ^ " bucket clashes (longest of " ^ show longest ^ " entries).\n\n")
  ^ "Symbol table:\n"
  ^ String.concat "" (List.map (fun (i, (off, es)) ->
      let name = pp_debug_str_entry_bytes d.d_sections.sec_str off in
      let hash = match nth_maybe i ni.ni_hashes with Just h -> "#" ^ od_hex_width 4 h ^ " " | Nothing -> "" end in
      "[" ^ left_space_padded_to 3 (show (i + 1)) ^ "] " ^ hash ^ name ^ ":"
      ^ (match es with
         | [e] -> " " ^ od_names_entry d.d_endianness e ^ "\n"
         | _ -> "\n" ^ String.concat "" (List.map (fun e -> "\t" ^ od_names_entry d.d_endianness e ^ "\n") es)
         end)) (index_list 0 (List.zip ni.ni_string_offsets ni.ni_entries)))

let od_debug_names_section (d: dwarf) : string =
  if d.d_sections.sec_names = Nothing then "" else
  chop_final_newline ("Contents of the .debug_names section:\n\n"
  ^ String.concat "" (List.map (od_names_index d) d.d_names))

let pp_dwarf_like_objdump abbrev_first regname (d:dwarf) : string =
  (* Claude: objdump prints the two sections in the order of the section
     header table; [abbrev_first] says which that is *)
  if abbrev_first then
    od_debug_abbrev_section d ^ "\n" ^ od_debug_info_section regname d
  else
    od_debug_info_section regname d ^ "\n" ^ od_debug_abbrev_section d


let pp_dwarf d =
  let c = p_context_of_d d in

(*  "\n************** .debug_info section - abbreviated *****************\n"
  ^ pp_compilation_units_abbrev c d d.d_compilation_units
  ^*) "\n************** .debug_info section - full ************************\n"
  ^ pp_compilation_units c true d d.d_compilation_units
  ^ (match d.d_compilation_units with
     | [] -> "\n(no compilation units: the .debug_loc, .debug_ranges and .debug_frame sections are not shown)\n"   (* Claude *)
     | cu :: _ ->
       let (cuh_default : compilation_unit_header) = cu.cu_header in
       "\n************** .debug_loc section: location lists ****************\n"
       ^ pp_loc c cuh_default d.d_loc
       ^ "\n************** .debug_ranges section: range lists ****************\n"
       ^ pp_ranges c cuh_default d.d_ranges
       ^ "\n************** .debug_frame section: frame info   ****************\n"
       ^ pp_frame_info c cuh_default d.d_frame_info
     end)
  ^ "\n************** .debug_line section: line number info   ****************\n"
  ^ pp_line_info d.d_line_info


(* TODO: don't use lists of bytes here! *)
(** Claude: parsing of the accelerator and macro sections (see the types above) *)

(* a header for the attribute-form parsers where no unit is involved: the tables'
   own offset size, an 8-byte address size (no address forms occur there) *)
let cuh_for_tables (df: dwarf_format) : compilation_unit_header =
  <| cuh_offset = 0; cuh_dwarf_format = df; cuh_unit_length = 0; cuh_version = 5; cuh_debug_abbrev_offset = 0;
     cuh_address_size = 8; cuh_unit_type = Nothing; cuh_dwo_id = Nothing |>

(* the parse context just after a contribution that started at [pc] and whose
   length field said it ends at [end_off] *)
let pc_after (pc: parse_context) (end_off: natural) : maybe parse_context =
  match sym_dropbytes (end_off - pc.pc_offset) pc.pc_bytes with
  | Success bs -> Just <| pc_bytes = bs; pc_offset = end_off |>
  | Fail _ -> Nothing
  end

(* .debug_aranges: a set's tuples, ended by a zero tuple or the set's end *)
let parse_aranges_tuple c (as': sym_natural) (ss: sym_natural) : parser (maybe (sym_natural * sym_natural * sym_natural)) =
  fun (pc: parse_context) ->
    if sym_bs_length pc.pc_bytes = 0 then PR_success Nothing pc else
    pr_bind ((if ss = 0 then pr_return 0 else parse_uint_address_size c ss) pc) (fun seg pc1 ->
    pr_bind (parse_uint_address_size c as' pc1) (fun a pc2 ->
    pr_bind (parse_uint_address_size c as' pc2) (fun l pc3 ->
      if seg = 0 && a = 0 && l = 0 then PR_success Nothing pc3 else PR_success (Just (seg, a, l)) pc3)))

let parse_aranges_set c : parser (maybe aranges_set) =
  fun (pc: parse_context) ->
    if sym_bs_length pc.pc_bytes = 0 then PR_success Nothing pc else
    pr_bind (parse_unit_length c pc) (fun (df, ul) pc1 ->
    pr_bind (parse_uint16 c pc1) (fun v pc2 ->
    pr_bind (parse_uintDwarfN c df pc2) (fun dio pc3 ->
    pr_bind (parse_uint8 pc3) (fun as' pc4 ->
    pr_bind (parse_uint8 pc4) (fun ss pc5 ->
      (* the tuples start at a multiple of the tuple size from the set's start, so
         the header is padded (section 7.21) *)
      let tuple_size = sym_natural_offset_part ss + 2 * sym_natural_offset_part as' in
      let header_size = pc5.pc_offset - pc.pc_offset in
      let pad = if tuple_size = 0 then 0 else (tuple_size - header_size mod tuple_size) mod tuple_size in
      let end_off = pc1.pc_offset + sym_natural_offset_part ul in
      pr_bind (parse_n_bytes (sym_natural_const pad) pc5) (fun _ pc6 ->
        if end_off < pc6.pc_offset then PR_fail "aranges set length too short for its header" pc else
        pr_bind (parse_restrict_length (sym_natural_const (end_off - pc6.pc_offset)) (parse_list (parse_aranges_tuple c as' ss)) pc6) (fun tuples _ ->
          match pc_after pc end_off with
          | Nothing -> PR_fail "aranges set runs past the section" pc
          | Just pc' ->
              PR_success (Just <| ar_offset = pc.pc_offset; ar_dwarf_format = df; ar_unit_length = ul; ar_version = v;
                                  ar_debug_info_offset = dio; ar_address_size = as'; ar_segment_selector_size = ss; ar_ranges = tuples |>) pc'
          end)))))))

(* .debug_names: abbreviations (ULEB128 code, tag, (attribute, form) pairs ended by
   (0, 0); the table ends with a 0 code), and the entries of the entry pool *)
let parse_names_attribute_spec : parser (maybe (sym_natural * sym_natural)) =
  fun (pc: parse_context) ->
    pr_bind (parse_pair parse_ULEB128 parse_ULEB128 pc) (fun (a, f) pc' ->
      if a = 0 && f = 0 then PR_success Nothing pc' else PR_success (Just (a, f)) pc')

let parse_names_abbreviation : parser (maybe names_abbreviation) =
  fun (pc: parse_context) ->
    if sym_bs_length pc.pc_bytes = 0 then PR_success Nothing pc else
    pr_bind (parse_ULEB128 pc) (fun code pc1 ->
      if code = 0 then PR_success Nothing pc1 else
      pr_bind (parse_ULEB128 pc1) (fun tag pc2 ->
      pr_bind (parse_list parse_names_attribute_spec pc2) (fun specs pc3 ->
        PR_success (Just <| na_code = code; na_tag = tag; na_attributes = specs |>) pc3)))

let parse_names_entry c (df: dwarf_format) (abbrevs: list names_abbreviation) : parser (maybe names_entry) =
  fun (pc: parse_context) ->
    pr_bind (parse_ULEB128 pc) (fun code pc1 ->
      if code = 0 then PR_success Nothing pc1 else
      match List.find (fun na -> sym_eq na.na_code code) abbrevs with
      | Nothing -> PR_fail ("abbreviation code " ^ show code ^ " is not in the name index's abbreviation table") pc
      | Just na ->
          pr_bind (parse_parser_list (List.map (fun (_, form) -> parser_of_attribute_form c (cuh_for_tables df) form) na.na_attributes) pc1) (fun avs pc2 ->
            PR_success (Just <| ne_abbreviation = na; ne_values = List.zip (List.map (fun (a, _) -> a) na.na_attributes) avs |>) pc2)
      end)

let parse_names_index c : parser (maybe names_index) =
  fun (pc: parse_context) ->
    if sym_bs_length pc.pc_bytes = 0 then PR_success Nothing pc else
    let n (x: sym_natural) : natural = sym_natural_offset_part x in
    pr_bind (parse_unit_length c pc) (fun (df, ul) pc1 ->
    pr_bind (parse_uint16 c pc1) (fun v pc2 ->
    pr_bind (parse_uint16 c pc2) (fun pad pc3 ->
    pr_bind (parse_uint32 c pc3) (fun cuc pc4 ->
    pr_bind (parse_uint32 c pc4) (fun ltuc pc5 ->
    pr_bind (parse_uint32 c pc5) (fun ftuc pc6 ->
    pr_bind (parse_uint32 c pc6) (fun bc pc7 ->
    pr_bind (parse_uint32 c pc7) (fun nc pc8 ->
    pr_bind (parse_uint32 c pc8) (fun ats pc9 ->
    pr_bind (parse_uint32 c pc9) (fun augl pc10 ->
    pr_bind (parse_n_bytes augl pc10) (fun aug pc11 ->
    pr_bind (parse_replicate (n cuc) (parse_uintDwarfN c df) pc11) (fun cus pc12 ->
    pr_bind (parse_replicate (n ltuc) (parse_uintDwarfN c df) pc12) (fun ltus pc13 ->
    pr_bind (parse_replicate (n ftuc) (parse_uint64 c) pc13) (fun ftus pc14 ->
    pr_bind (parse_replicate (n bc) (parse_uint32 c) pc14) (fun buckets pc15 ->
    pr_bind (parse_replicate (if n bc = 0 then 0 else n nc) (parse_uint32 c) pc15) (fun hashes pc16 ->
    pr_bind (parse_replicate (n nc) (parse_uintDwarfN c df) pc16) (fun stroffs pc17 ->
    pr_bind (parse_replicate (n nc) (parse_uintDwarfN c df) pc17) (fun entoffs pc18 ->
    if n ats > sym_bs_length pc18.pc_bytes then PR_fail "name index abbreviations table runs past the section" pc else
    pr_bind (parse_restrict_length ats (parse_list parse_names_abbreviation) pc18) (fun abbrevs _ ->
      let pool_start = pc18.pc_offset + n ats in
      let end_off = pc1.pc_offset + n ul in
      if end_off < pool_start then PR_fail "name index length too short for its tables" pc else
      match pc_after pc pool_start with
      | Nothing -> PR_fail "name index abbreviations table runs past the section" pc
      | Just pcp ->
          match sym_takebytes (end_off - pool_start) pcp.pc_bytes with
          | Fail _ -> PR_fail "name index runs past the section" pc
          | Success pool ->
              let series (off: sym_natural) : (list names_entry * maybe string) =
                match sym_dropbytes (n off) pool with
                | Fail _ -> ([], Just ("entry offset " ^ pphex_sym off ^ " is beyond the entry pool"))
                | Success bs ->
                    match parse_list (parse_names_entry c df abbrevs) <| pc_bytes = bs; pc_offset = pool_start + n off |> with
                    | PR_success es _ -> (es, Nothing)
                    | PR_fail s pc' -> ([], Just (pp_parse_fail s pc'))
                    end
                end in
              let parsed = List.map series entoffs in
              match pc_after pc end_off with
              | Nothing -> PR_fail "name index runs past the section" pc
              | Just pc' ->
                  PR_success (Just <|
                    ni_offset = pc.pc_offset; ni_dwarf_format = df; ni_unit_length = ul; ni_version = v; ni_padding = pad;
                    ni_comp_unit_count = cuc; ni_local_type_unit_count = ltuc; ni_foreign_type_unit_count = ftuc;
                    ni_bucket_count = bc; ni_name_count = nc; ni_abbrev_table_size = ats; ni_augmentation = aug;
                    ni_comp_units = cus; ni_local_type_units = ltus; ni_foreign_type_units = ftus;
                    ni_buckets = buckets; ni_hashes = hashes; ni_string_offsets = stroffs; ni_entry_offsets = entoffs;
                    ni_abbreviations = abbrevs;
                    ni_entries = List.map (fun (es, _) -> es) parsed;
                    ni_entry_errors = List.mapMaybe (fun (_, e) -> e) parsed |>) pc'
              end
          end
      end)))))))))))))))))))

(* .debug_macro: a unit's header (version, flags, optional line offset and operands
   table) and its entries up to the 0 opcode *)
let parse_macro_opcode_operands_table : parser (list (natural * list natural)) =
  fun (pc: parse_context) ->
    pr_bind (parse_uint8 pc) (fun count pc1 ->
      parse_replicate (sym_natural_offset_part count)
        (fun (pc': parse_context) ->
          pr_bind (parse_uint8 pc') (fun opc pc2 ->
          pr_bind (parse_ULEB128 pc2) (fun nops pc3 ->
          pr_bind (parse_replicate (sym_natural_offset_part nops) parse_uint8 pc3) (fun forms pc4 ->
            PR_success (sym_natural_offset_part opc, List.map sym_natural_offset_part forms) pc4))))
        pc1)

let parse_macro_entry c (df: dwarf_format) (table: list (natural * list natural)) : parser (maybe macro_entry) =
  fun (pc: parse_context) ->
    pr_bind (parse_uint8 pc) (fun opc pc1 ->
      let o = sym_natural_offset_part opc in
      (* the line number, then a string, an offset or an index (separate helpers:
         a local let is not generalised) *)
      let line_and_string k = pr_bind (parse_ULEB128 pc1) (fun l pc2 -> pr_bind (parse_string pc2) (fun s pc3 -> PR_success (Just (k l s)) pc3)) in
      let line_and_offset k = pr_bind (parse_ULEB128 pc1) (fun l pc2 -> pr_bind (parse_uintDwarfN c df pc2) (fun x pc3 -> PR_success (Just (k l x)) pc3)) in
      let line_and_uleb k = pr_bind (parse_ULEB128 pc1) (fun l pc2 -> pr_bind (parse_ULEB128 pc2) (fun x pc3 -> PR_success (Just (k l x)) pc3)) in
      let offset_only k = pr_bind (parse_uintDwarfN c df pc1) (fun x pc2 -> PR_success (Just (k x)) pc2) in
      if o = 0 then PR_success Nothing pc1
      else if o = 1 then line_and_string (fun l s -> ME_define l s)
      else if o = 2 then line_and_string (fun l s -> ME_undef l s)
      else if o = 3 then line_and_uleb (fun l fi -> ME_start_file l fi)
      else if o = 4 then PR_success (Just ME_end_file) pc1
      else if o = 5 then line_and_offset (fun l x -> ME_define_strp l x)
      else if o = 6 then line_and_offset (fun l x -> ME_undef_strp l x)
      else if o = 7 then offset_only (fun x -> ME_import x)
      else if o = 8 then line_and_offset (fun l x -> ME_define_sup l x)
      else if o = 9 then line_and_offset (fun l x -> ME_undef_sup l x)
      else if o = 10 then offset_only (fun x -> ME_import_sup x)
      else if o = 11 then line_and_uleb (fun l i -> ME_define_strx l i)
      else if o = 12 then line_and_uleb (fun l i -> ME_undef_strx l i)
      else
        match List.lookup o table with
        | Just forms ->
            pr_bind (parse_parser_list (List.map (fun fm -> parser_of_attribute_form c (cuh_for_tables df) (sym_natural_const fm)) forms) pc1) (fun avs pc2 ->
              PR_success (Just (ME_other o avs)) pc2)
        | Nothing -> PR_fail ("unknown DW_MACRO opcode " ^ show o) pc
        end)

let parse_macro_unit c : parser (maybe macro_unit) =
  fun (pc: parse_context) ->
    if sym_bs_length pc.pc_bytes = 0 then PR_success Nothing pc else
    pr_bind (parse_uint16 c pc) (fun v pc1 ->
    pr_bind (parse_uint8 pc1) (fun flags pc2 ->
      let f = sym_natural_offset_part flags in
      let df = if f mod 2 = 1 then Dwarf64 else Dwarf32 in
      pr_bind ((if (f div 2) mod 2 = 1 then pr_map2 (fun x -> Just x) (parse_uintDwarfN c df) else pr_return Nothing) pc2) (fun mlo pc3 ->
      pr_bind ((if (f div 4) mod 2 = 1 then parse_macro_opcode_operands_table else pr_return []) pc3) (fun table pc4 ->
      pr_bind (parse_list (parse_macro_entry c df table) pc4) (fun entries pc5 ->
        PR_success (Just <| mu_offset = pc.pc_offset; mu_version = v; mu_flags = flags; mu_dwarf_format = df;
                            mu_debug_line_offset = mlo; mu_opcode_operands = table; mu_entries = entries |>) pc5)))))

let parse_dwarf c (secs: dwarf_sections) : dwarf =

  let debug_info_section_body = section_or_empty secs.sec_info in
  let debug_loc_section_body = section_or_empty secs.sec_loc in
  let debug_ranges_section_body = section_or_empty secs.sec_ranges in
  let debug_frame_section_body = section_or_empty secs.sec_frame in

  let pc_info = <|pc_bytes = debug_info_section_body; pc_offset = 0  |> in

  (* Claude: each section is parsed as far as it goes; a failure ends that
     section's list and is recorded in [d_diagnostics] instead of aborting
     the whole extraction, as readelf and objdump warn and carry on.  With no
     compilation unit at all there is no address size to parse the location,
     range and frame sections with, so they are left empty. *)
  let diag prefix m = match m with Nothing -> [] | Just msg -> [prefix ^ msg] end in
  let (units, cu_diag) =
    parse_list_tolerant (parse_unit c secs) pc_info in
  let compilation_units = compilation_units_of_units units in
  let type_units = type_units_of_units units in

  let (loc, ranges, fi, li, diags) =
    match compilation_units with
    | [] -> ([], [], [], [], diag "parse_compilation_units: " cu_diag)
    | cu :: _ ->
(* the DWARF4 spec doesn't seem to specify the address size used in the .debug_loc section, so we (hackishly) take it from the first compilation unit *)
      let (cuh_default : compilation_unit_header) = cu.cu_header in
      let pc_loc = <|pc_bytes = debug_loc_section_body; pc_offset = 0  |> in
      let (loc, loc_diag) = parse_list_tolerant (parse_location_list c cuh_default) pc_loc in
      let pc_ranges = <|pc_bytes = debug_ranges_section_body; pc_offset = 0  |> in
      let (range_lists, ranges_diag) = parse_list_tolerant (parse_range_list c cuh_default) pc_ranges in
      let ranges = List.concat range_lists in
      let pc_frame = <|pc_bytes = debug_frame_section_body; pc_offset = 0  |> in
      let (fi, frame_diag) =
        match parse_frame_info c cuh_default pc_frame with
        | PR_fail s pc' -> ([], Just (pp_parse_fail s pc'))
        | PR_success fi pc' -> (fi, Nothing)
        end in
      (* Claude: the line tables need each unit's context, so a dwarf record
         without them first *)
      let d0 =
        <|
        d_endianness = c.endianness;
        d_sections = secs;
        d_str = section_or_empty secs.sec_str;
        d_compilation_units = compilation_units;
        d_type_units = type_units;
        d_loc = loc;
        d_ranges = ranges;
        d_frame_info = fi;
        d_line_info = [];
        d_aranges = [];
        d_names = [];
        d_macro = [];
        d_diagnostics = [];
        |> in
      let li = parse_line_number_infos c d0 compilation_units in
      (loc, ranges, fi, li,
       diag "parse_compilation_units: " cu_diag ++ diag "parse_location_list: " loc_diag
       ++ diag "parse_range_list: " ranges_diag ++ diag "parse_frame_info: " frame_diag)
    end in

  (* Claude: the accelerator and macro sections, each parsed as far as it goes *)
  let (aranges, aranges_diag) = parse_list_tolerant (parse_aranges_set c) <| pc_bytes = section_or_empty secs.sec_aranges; pc_offset = 0 |> in
  let (names, names_diag) = parse_list_tolerant (parse_names_index c) <| pc_bytes = section_or_empty secs.sec_names; pc_offset = 0 |> in
  let (macro, macro_diag) = parse_list_tolerant (parse_macro_unit c) <| pc_bytes = section_or_empty secs.sec_macro; pc_offset = 0 |> in

   <|
   d_endianness = c.endianness;
   d_sections = secs;
   d_str = section_or_empty secs.sec_str;
   d_compilation_units = compilation_units;
   d_type_units = type_units;
   d_loc = loc;
   d_ranges = ranges;
   d_frame_info = fi;
   d_line_info = li;
   d_aranges = aranges;
   d_names = names;
   d_macro = macro;
   d_diagnostics = diags ++ diag ".debug_aranges: " aranges_diag ++ diag ".debug_names: " names_diag ++ diag ".debug_macro: " macro_diag;
  |>

val extract_section_body : elf_file -> relocation_interpreter reloc_target_data -> string -> bool -> p_context * sym_natural * sym_byte_sequence
let extract_section_body (f:elf_file) (ri:relocation_interpreter reloc_target_data) (section_name:string) (strict: bool) =
  let (en: Endianness.endianness) =
    match f with
    | ELF_File_32 f32 -> Elf_header.get_elf32_header_endianness f32.Elf_file.elf32_file_header
    | ELF_File_64 f64 -> Elf_header.get_elf64_header_endianness f64.Elf_file.elf64_file_header
    end in
  let (c: p_context) = <| endianness = en |> in
  match f with
  | ELF_File_32 f32 ->
      let sections =
        List.filter
          (fun x ->
            x.Elf_interpreted_section.elf32_section_name_as_string = section_name
          ) f32.elf32_file_interpreted_sections in
      match sections with
      | section :: rest ->
          (* Claude: several sections of the name (COMDAT .debug_macro groups in an
             object file, say): the first is used, as readelf shows it first *)
          if rest <> [] && strict then Assert_extra.failwith ("multiple " ^ section_name ^ " sections present") else
          let section_addr = if is_elf32_relocatable_file f32.elf32_file_header then
            sym_natural_section section_name
          else
            sym_natural_const section.Elf_interpreted_section.elf32_section_addr
          in
          let section_body = section.Elf_interpreted_section.elf32_section_body in
          (* let _ = my_debug4 (section_name ^ (": \n" ^ (Elf_interpreted_section.string_of_elf32_interpreted_section section ^ "\n"
           *                ^ "  body = " ^ ppbytes2 0 section_body ^ "\n"))) in *)
          let section_body = if is_elf32_relocatable_file f32.elf32_file_header then
            Assert_extra.failwith "Not implemented"
          else
            sym_bs_construct section_body Map.empty
          in
          (c,section_addr,section_body)
      | [] ->
          if strict then
            Assert_extra.failwith ("" ^ section_name ^ " section not present")
          else
            (c,0,sym_bs_empty)
      end


  | ELF_File_64 f64 ->
      let sections =
        List.filter
          (fun x ->
            x.Elf_interpreted_section.elf64_section_name_as_string = section_name
          ) f64.elf64_file_interpreted_sections in
      match sections with
      | section :: rest ->
          (* Claude: several sections of the name (COMDAT .debug_macro groups in an
             object file, say): the first is used, as readelf shows it first *)
          if rest <> [] && strict then Assert_extra.failwith ("multiple " ^ section_name ^ " sections present") else
          let section_addr = if is_elf64_relocatable_file f64.elf64_file_header then
            sym_natural_section section_name
          else
            sym_natural_const section.Elf_interpreted_section.elf64_section_addr
          in
          let section_body = section.Elf_interpreted_section.elf64_section_body in
          let _ = my_debug "extracted section body" in
          if rest <> [] then (c, section_addr, sym_bs_construct section_body Map.empty) else   (* Claude: relocations are found by name, ambiguous here *)
          match extract_elf64_relocations_for_section f64 ri section_name with
          | Success relocations ->
              let _ = my_debug "extracted relocations" in
              let section_body = construct_sym_byte_sequence section_body relocations in
              (c,section_addr,section_body)
          | Fail err -> Assert_extra.failwith ("failed extracting relocations: " ^ err)
          end
      | [] ->
          if strict then
            Assert_extra.failwith ("" ^ section_name ^ " section not present")
          else
            (c,0,sym_bs_empty)
      end
  end

let extract_section_body_without_relocations f section_name strict =
  let err_on_relocation ef symtab_map sidx rel = Assert_extra.failwith "Relocation found while extracting a section without relocations" in
  let (c, addr, body) = extract_section_body f err_on_relocation section_name strict in
  (c, addr, sym_bs_expect_const body)

val extract_dwarf : elf_file -> relocation_interpreter reloc_target_data -> maybe dwarf
(* Claude: whether the file has a section of the name *)
let has_section (f: elf_file) (section_name: string) : bool =
  match f with
  | ELF_File_32 f32 -> List.any (fun x -> x.Elf_interpreted_section.elf32_section_name_as_string = section_name) f32.elf32_file_interpreted_sections
  | ELF_File_64 f64 -> List.any (fun x -> x.Elf_interpreted_section.elf64_section_name_as_string = section_name) f64.elf64_file_interpreted_sections
  end

(* Claude: the (relocated) bytes of a section the file may lack *)
let extract_optional_section_body (f: elf_file) (ri: relocation_interpreter reloc_target_data) (section_name: string) : maybe sym_byte_sequence =
  if has_section f section_name then
    let (_, _, body) = extract_section_body f ri section_name false in Just body
  else Nothing

(* Claude: Nothing when the file has no .debug_info; the other sections may each be absent *)
let extract_dwarf f ri =
  let _ = my_debug "extract dwarf" in
  if not (has_section f ".debug_info") then Nothing else
  let (c, _, _) = extract_section_body f ri ".debug_info" true in
  let sec = extract_optional_section_body f ri in
  let secs =
    <|
    sec_info = sec ".debug_info";
    sec_abbrev = sec ".debug_abbrev";
    sec_str = sec ".debug_str";
    sec_str_offsets = sec ".debug_str_offsets";
    sec_addr = sec ".debug_addr";
    sec_line_str = sec ".debug_line_str";
    sec_loc = sec ".debug_loc";
    sec_ranges = sec ".debug_ranges";
    sec_loclists = sec ".debug_loclists";
    sec_rnglists = sec ".debug_rnglists";
    sec_aranges = sec ".debug_aranges";
    sec_names = sec ".debug_names";
    sec_macro = sec ".debug_macro";
    sec_frame = sec ".debug_frame";
    sec_line = sec ".debug_line";
    |> in
  let d = parse_dwarf c secs in
  Just d

val extract_text : elf_file -> relocation_interpreter reloc_target_data -> p_context * sym_natural * sym_byte_sequence  (* (p_context, elf32/64_section_addr, elf32/64_section_body) *)
let extract_text f ri = extract_section_body f ri ".text" true 


(** ************************************************************ *)
(** ****** location evaluation  ******************************** *)
(** ************************************************************ *)


(** pp of locations *)

val pp_simple_location : simple_location -> string
let pp_simple_location sl =
  match sl with
  | SL_memory_address n -> pphex_sym n
  | SL_register n -> "reg" ^ show n
  | SL_implicit bs -> "value: " ^ ppbytes bs
  | SL_empty -> "<empty>"
  end

val pp_composite_location_piece : composite_location_piece -> string
let pp_composite_location_piece clp =
  match clp with
  | CLP_piece n sl -> "piece (" ^ show n ^ ") " ^ pp_simple_location sl
  | CLP_bit_piece n1 n2 sl -> "bit_piece (" ^ show n1 ^ "," ^ show n2 ^ ") " ^ pp_simple_location sl
  end

val pp_single_location: single_location -> string
let pp_single_location sl =
  match sl with
  | SL_simple sl -> pp_simple_location sl
  | SL_composite clps -> "composite: " ^ String.concat ", " (List.map pp_composite_location_piece clps)
  end


(** evaluation of location expressions *)

(* cf dwarflist, btw: https://fedorahosted.org/elfutils/wiki/DwarfLint?format=txt *)

(*

location description ::=
| single location description
| location list

single location description ::=
| simple location description
| composite location description

simple location description ::=
| memory location description : non-empty dwarf expr, value is address of all or part of object in memory
| register location description : single DW_OP_regN or DW_OP_regx, naming a register in which all the object is
| implicit location description : single DW_OP_implicit_value or a non-empty dwarf expr ending in DW_OP_stack_value, giving the value of all/part of object
| empty location description : an empty dwarf expr, indicating a part or all of an object that is not represented

composite location description : a list of simple location descriptions, each followed by a DW_OP_piece or DW_OP_bitpiece

(the simple location description can be a register location description: https://www.mail-archive.com/dwarf-discuss@lists.dwarfstd.org/msg00271.html)
(contradicting "A register location description must stand alone as the entire description of an object or a piece of an object.")

location list entry : a list of address ranges (possibly overlapping), each with a single location description

Dwarf expressions can include data-dependent control flow choices
(though we don't see that in the examples?), so we can't statically
determine which kind of single location description or simple location
description we have.  We can distinguish:

- empty -> simple.empty
- DW_OP_regN/DW_OP_regx -> simple.register
- DW_OP_implicit_value -> simple.implicit
- any of those followed by DW_OP_piece or DW_OP_bitpiece, perhaps followed by more composite parts -> composite part :: composite

otherwise run to the end, or a DW_OP_stack_value at the end, or to
anything (except a DO_OP_regN/DW_OP_regx) followed by a
DW_OP_piece/DW_OP_bitpiece. Pfeh.


actually used in our examples (ignoring GNU extentions):

DW_OP_addr         literal
DW_OP_lit1         literal
DW_OP_const4u      literal

DW_OP_breg3 (r3)   read register value and add offset

DW_OP_and          bitwise and
DW_OP_plus         addition (mod whatever)

DW_OP_deref_size
DW_OP_fbreg        evaluate location description from DW_AT_frame_base attribute of the current function (which is DW_OP_call_frame_cfa in our examples) and add offset

DW_OP_implicit_value   the argument block is the actual value (not location) of the entity in question
DW_OP_stack_value      use the value at top of stack as the actual value (not location) of the entity in question

DW_OP_reg0 (r0))       read register value

DW_OP_call_frame_cfa   go off to 6.4 and pull info out of .debug_frame (possibly involving other location expressions)

*)



(** Claude: DWARF 5 typed stack support (section 2.5.1) *)

let vDW_ATE_complex_float : natural = 3
let vDW_ATE_float : natural = 4
let vDW_ATE_signed : natural = 5
let vDW_ATE_signed_char : natural = 6

(* the type an operand of a typed operation names: 0 is the generic type,
   otherwise the unit-relative offset of a DW_TAG_base_type DIE *)
let stack_type_of_offset (str: unit_context) (off: sym_natural) : maybe stack_type =
  if off = 0 then Just ST_generic else
  match Map.lookup (off + str.uc_cuh.cuh_offset) str.uc_index with
  | Just (_, die) ->
      if die.die_abbreviation_declaration.ad_tag <> tag_encode "DW_TAG_base_type" then Nothing else
      match (find_natural_attribute_value_of_die str.uc_c "DW_AT_byte_size" die, find_natural_attribute_value_of_die str.uc_c "DW_AT_encoding" die) with
      | (Just sz, Just enc) -> Just (ST_base <| bt_offset = off; bt_size = sym_natural_offset_part sz; bt_encoding = sym_natural_offset_part enc |>)
      | _ -> Nothing
      end
  | Nothing -> Nothing
  end

let stack_type_size (cuh: compilation_unit_header) (t: stack_type) : natural =
  match t with ST_generic -> sym_natural_offset_part cuh.cuh_address_size | ST_base bt -> bt.bt_size end

let stack_type_signed (t: stack_type) : bool =
  match t with ST_generic -> false | ST_base bt -> bt.bt_encoding = vDW_ATE_signed || bt.bt_encoding = vDW_ATE_signed_char end

let stack_type_integral (t: stack_type) : bool =
  match t with ST_generic -> true | ST_base bt -> not (bt.bt_encoding = vDW_ATE_float || bt.bt_encoding = vDW_ATE_complex_float) end

let same_stack_type (t1: stack_type) (t2: stack_type) : bool =
  match (t1, t2) with
  | (ST_generic, ST_generic) -> true
  | (ST_base b1, ST_base b2) -> b1.bt_offset = b2.bt_offset
  | _ -> false
  end

let pp_stack_type (t: stack_type) : string =
  match t with
  | ST_generic -> "generic"
  | ST_base bt -> "base type <" ^ pphex_sym bt.bt_offset ^ "> size " ^ show bt.bt_size ^ " encoding " ^ show bt.bt_encoding
  end

(* the arithmetic of a type: modulo 2^(8*size), the signed operations by its
   encoding; the generic type's arithmetic is the unit's, with div and the
   comparisons signed as before DWARF 5 *)
let ac_of_stack_type (ac: arithmetic_context) (t: stack_type) : arithmetic_context =
  match t with
  | ST_generic -> ac
  | ST_base bt ->
      let bits = 8 * bt.bt_size in
      let nbits = natFromNatural bits in
      <| ac_bitwidth = sym_natural_const bits;
         ac_half = symNaturalPow 2 (nbits - 1);
         ac_all = symNaturalPow 2 nbits;
         ac_max = symNaturalPow 2 nbits - 1;
         ac_signed = stack_type_signed t;
         ac_generic = false |>
  end

(* the value of a typed entry as an integer: signed base types by two's
   complement, the others (the generic type included, as gdb has it) unsigned *)
let stack_entry_integer (ac: arithmetic_context) (v: sym_natural) (t: stack_type) : sym_integer =
  let ac' = ac_of_stack_type ac t in
  if stack_type_signed t && v >= ac'.ac_half then symIntegerFromNatural v - symIntegerFromNatural ac'.ac_all else symIntegerFromNatural v

(* DW_OP_convert: the integer value re-represented in the target type, modulo its size *)
let convert_stack_entry (ac: arithmetic_context) (v: sym_natural) (t: stack_type) (t': stack_type) : sym_natural =
  let ac'' = ac_of_stack_type ac t' in
  partialSymNaturalFromInteger ((stack_entry_integer ac v t) mod (symIntegerFromNatural ac''.ac_all))

let initial_state =
  <|
  s_stack = [];
  s_value = SL_empty;
  s_location_pieces = [];
|>

(* Claude: the most operations one evaluation may execute; DW_OP_skip and DW_OP_bra
   can loop, and DWARF gives no bound, so this is our own limit *)
let evaluation_fuel : nat = 100000

(* the main location expression evaluation function *)

(* location expression evaluation is basically a recursive function
down a list of operations, maintaining an operation_stack (a list of
naturals representing machine-address-size words), the current
simple_location, and a list of any composite_location_piece's
accumulated so far *)



let arithmetic_context_of_cuh cuh =
  match sym_natural_expect_const cuh.cuh_address_size (*"arithmetic_context_of_cuh"*) with
  | 8 ->
      <|
      ac_bitwidth = 64;
      ac_half = symNaturalPow 2 63;  (* Claude: was 2^32; ac_half is the sign boundary, 2^(bitwidth-1) *)
      ac_all = symNaturalPow 2 64;
      ac_max = (symNaturalPow 2 64) - 1;
    ac_signed = true;   (* Claude: the generic type: div and the comparisons are signed *)
      ac_generic = true;
    |>
  | 4 ->
      <|
      ac_bitwidth = 32;
      ac_half = symNaturalPow 2 31;  (* Claude: was 2^16 *)
      ac_all = symNaturalPow 2 32;
      ac_max = (symNaturalPow 2 32) - 1;
    ac_signed = true;   (* Claude: the generic type: div and the comparisons are signed *)
      ac_generic = true;
    |>
  | _ -> Assert_extra.failwith "arithmetic_context_of_cuh given non-4/8 size"
  end

let find_cfa_table_row_for_pc (evaluated_frame_info: evaluated_frame_info) (pc: sym_natural) : cfa_table_row =
  match
    myfind
      (fun (fde,rows) -> pc >= fde.fde_initial_location_address && pc < fde.fde_initial_location_address + fde.fde_address_range)
      evaluated_frame_info
  with
  | Just (fde,rows) ->
      (* Claude: the rows of an FDE are in ascending address order and each holds
         until the next, so the row for pc is the last one at or before pc; the
         first such row (which is what searching forwards finds) is the FDE's
         initial row *)
      match myfind (fun row -> pc >= row.ctr_loc) (List.reverse rows) with
      | Just row -> row
      | Nothing -> Assert_extra.failwith "evaluate_cfa: no matching row"
      end
  | Nothing -> Assert_extra.failwith "evaluate_cfa: no fde encloding pc"
  end


let rec evaluate_operation_list (c:p_context) (str: unit_context) (evaluated_frame_info: evaluated_frame_info) (cuh: compilation_unit_header) (ac: arithmetic_context) (ev: evaluation_context) (mfbloc: maybe attribute_value) (pc: sym_natural) (all_ops: list operation) (fuel: nat) (s: state) (ops: list operation) : error single_location =
  (* Claude: [all_ops] is the whole expression and [ops] the operations still to run,
     a suffix of it; the branch operations continue from another suffix.  [fuel]
     bounds the number of operations executed. *)

  let push_memory_address v vs' = Success <| s with s_stack = (v, ST_generic) :: vs'; s_value = SL_memory_address v |>  in
  (* Claude: a typed push; the location a stack denotes (its top's value); and the
     type an operand of a typed operation names *)
  (* a typed top entry taken as the result (an address): DWARF 5 does not say how
     a base-type value becomes an address; gdb takes its bytes as an unsigned
     integer (dwarf_expr_context::fetch_address), so a signed value is not
     sign-extended, and that is followed here *)
  let address_of_entry v t = v in
  let push_typed v t vs' = Success <| s with s_stack = (v, t) :: vs'; s_value = SL_memory_address (address_of_entry v t) |>  in
  let value_of_stack (vs: operation_stack) : simple_location = match vs with [] -> SL_empty | (v',t')::_ -> SL_memory_address (address_of_entry v' t') end in
  let typed_type toff k =
    match stack_type_of_offset str toff with
    | Just t -> k t
    | Nothing -> Fail ("typed operation: no DW_TAG_base_type at unit offset " ^ pphex_sym toff)
    end in

  let push_memory_address_maybe (mv: maybe sym_natural) vs' (err:string) op =
    match mv with
    | Just v -> push_memory_address v vs'
    | Nothing -> Fail (err ^ pp_operation op)
    end in

  let bregxi r i =
    match ev.read_register r with
    | RRR_result v -> push_memory_address (partialSymNaturalFromInteger ((symIntegerFromNatural v+i) mod (symIntegerFromNatural ac.ac_all))) s.s_stack
    | RRR_not_currently_available -> Fail "RRR_not_currently_available"
    | RRR_bad_register_number -> Fail ("RRR_bad_register_number " ^ show r)
    end in

  let deref_size n =
    match s.s_stack with
    | (v,_)::vs' ->
        match ev.read_memory v n with
        | MRR_result v' -> push_memory_address v' vs'
        | MRR_not_currently_available -> Fail "MRR_not_currently_available"
        | MRR_bad_address -> Fail "MRR_bad_address"
        end
    | _ -> Fail "OpSem unary not given an element on stack"
    end in

  let expression_end : natural = List.foldl (fun acc o -> o.op_end) 0 all_ops in

  let continue_with (s': state) (ops'': list operation) : error single_location =
    evaluate_operation_list c str evaluated_frame_info cuh ac ev mfbloc pc all_ops (fuel - 1) s' ops'' in

  match ops with
  | [] ->
      if s.s_location_pieces = [] then
        if s.s_value = SL_empty && all_ops <> [] then
          (* Claude: a non-empty expression that leaves nothing on the stack has no
             result (gdb and lldb also fail) *)
          Fail "expression leaves an empty stack"
        else
          Success (SL_simple s.s_value)
      else if s.s_value = SL_empty then
        Success (SL_composite s.s_location_pieces)
      else
        (*  unclear what's supposed to happen in this case *)
        Fail "unfinished part of composite expression"

  | op::ops' ->
      if fuel = 0 then Fail ("evaluate_operation_list: more than " ^ show evaluation_fuel ^ " operations executed (a looping expression?)") else

      (* Claude: DW_OP_skip and DW_OP_bra: the operand is a byte offset from the end of
         the operation; the target must be the start of an operation (or the end of the
         expression) *)
      let branch (i: sym_integer) (s': state) : error single_location =
        let target = integerFromNatural op.op_end + sym_integer_expect_const i in
        if target < 0 then Fail ("branch before the start of the expression: " ^ pp_operation op)
        else
          let t = naturalFromInteger target in
          if t = expression_end then continue_with s' []
          else
            match List.dropWhile (fun o -> o.op_offset <> t) all_ops with
            | [] -> Fail ("branch target " ^ show t ^ " is not at an operation boundary: " ^ pp_operation op)
            | ops'' -> continue_with s' ops''
            end in

      match (op.op_semantics, op.op_argument_values) with
      | (OpSem_skip, [OAV_integer i]) -> branch i s
      | (OpSem_bra, [OAV_integer i]) ->
          match s.s_stack with
          | (v,_)::vs' ->
              let s' = <| s with s_stack = vs'; s_value = value_of_stack vs' |> in
              if v <> 0 then branch i s' else continue_with s' ops'
          | [] -> Fail "DW_OP_bra not given an element on stack"
          end
      | _ ->

      let es' =
        match (op.op_semantics, op.op_argument_values)  with
        | (OpSem_nop, []) ->
            Success s
        | (OpSem_lit, [OAV_natural n]) ->
            push_memory_address n s.s_stack
        | (OpSem_lit, [OAV_integer i]) ->
            push_memory_address (partialTwosComplementNaturalFromInteger i ac.ac_half (symIntegerFromNatural ac.ac_all)) s.s_stack
        | (OpSem_stack f, _) ->
            (* Claude: the stack-manipulation semantics take the operands themselves
               (DW_OP_pick and DW_OP_plus_uconst have one), so match any operand list *)
            (* Claude: with the arithmetic of the top entry's type (for DW_OP_plus_uconst) *)
            let ac' = match s.s_stack with (_,t)::_ -> ac_of_stack_type ac t | [] -> ac end in
            match f ac' s.s_stack op.op_argument_values with
            | Just stack' ->
                Success <| s with s_stack = stack'; s_value = value_of_stack stack' |>
            | Nothing -> Fail "OpSem_stack failed"
            end
        | (OpSem_not_supported, []) ->
            Fail ("OpSem_not_supported: " ^ pp_operation op)
        | (OpSem_binary f, []) ->
            (* Claude: DWARF 4 section 2.5.1.4: the binary operations apply to (former
               second entry, former top entry), so [f] takes the second entry first *)
            (* Claude: DWARF 5 section 2.5.1.4: the operands must have the same type,
               and the result has it, except that the comparisons (2.5.1.5) push a
               generic 0 or 1; the arithmetic is that type's *)
            match s.s_stack with
            | (top,t1)::(second,t2)::vs' ->
                if not (same_stack_type t1 t2) then Fail ("OpSem_binary: operands of different types (" ^ pp_stack_type t2 ^ ", " ^ pp_stack_type t1 ^ "): " ^ pp_operation op)
                else
                  let comparison = op.op_code >= vDW_OP_eq && op.op_code <= vDW_OP_ne in
                  match f (ac_of_stack_type ac t2) second top with
                  | Just v -> push_typed v (if comparison then ST_generic else t2) vs'
                  | Nothing -> Fail ("OpSem_binary error: " ^ pp_operation op)
                  end
            | _ -> Fail "OpSem binary not given two elements on stack"
            end
        | (OpSem_unary f, []) ->
            match s.s_stack with
            | (v1,t1)::vs' ->
                match f (ac_of_stack_type ac t1) v1 with
                | Just v -> push_typed v t1 vs'
                | Nothing -> Fail ("OpSem_unary error: " ^ pp_operation op)
                end
            | _ -> Fail "OpSem unary not given an element on stack"
            end
        | (OpSem_opcode_lit base, []) ->
            if op.op_code >= base && op.op_code < base + 32 then
              push_memory_address (op.op_code - base) s.s_stack
            else
              Fail "OpSem_opcode_lit opcode not within [base,base+32)"
        | (OpSem_reg, []) ->
            (* TODO: unclear whether this should push the register id or not *)
            let r = op.op_code - vDW_OP_reg0 in
            Success <| s with s_stack = (r, ST_generic) :: s.s_stack; s_value = SL_register r |>
        | (OpSem_reg, [OAV_natural r]) ->
            (* Claude: DW_OP_regx, the register number as a ULEB128 operand *)
            Success <| s with s_stack = (r, ST_generic) :: s.s_stack; s_value = SL_register r |>
        | (OpSem_breg, [OAV_integer i]) ->
            let r = op.op_code - vDW_OP_breg0 in
            bregxi r i
        | (OpSem_bregx, [OAV_natural r; OAV_integer i]) ->
            bregxi r i
        | (OpSem_deref, []) ->
            deref_size cuh.cuh_address_size
        | (OpSem_deref_size, [OAV_natural n]) ->
            deref_size n
        | (OpSem_fbreg, [OAV_integer i]) ->
            match mfbloc with
            | Just fbloc ->
                (*let _ = my_debug5 ("OpSem_fbreg (" ^ show i ^ ")\n") in*)
                match evaluate_location_description c str evaluated_frame_info  cuh ac ev (*mfbloc*)Nothing pc fbloc with
                (* what to do if the recursive call also uses fbreg?  for now assume that's not allowed *)
                | Success l ->
                    (* Claude: the frame base is "the address specified by the location
                       description in DW_AT_frame_base"; for a register location
                       (DW_OP_regN, as clang emits) that is the register's contents *)
                    let base : error sym_natural =
                      match l with
                      | SL_simple (SL_memory_address a) -> Success a
                      | SL_simple (SL_register r) ->
                          match ev.read_register r with
                          | RRR_result a -> Success a
                          | RRR_not_currently_available -> Fail "OpSem_fbreg: frame base register not currently available"
                          | RRR_bad_register_number -> Fail ("OpSem_fbreg: bad frame base register number " ^ show r)
                          end
                      | _ -> Fail "OpSem_fbreg got a non-address, non-register frame base"
                      end in
                    match base with
                    | Success a ->
                        let vi = ((symIntegerFromNatural a) + i) mod (symIntegerFromNatural ac.ac_all) in
                        let v = partialSymNaturalFromInteger vi in
                        push_memory_address v s.s_stack
                    | Fail e -> Fail e
                       (* "The DW_OP_fbreg operation provides a signed LEB128
                           offset from the address specified by the location
                           description in the DW_AT_frame_base attribute of the
                           current function. "
                          - so what to do if the location description returns a non-memory-address location?  *)
                    end
                | Fail e ->
                    Fail ("OpSem_fbreg failure: " ^ e)
                end
            | Nothing ->
                Fail "OpSem_fbreg: no frame base location description given"
            end

        | (OpSem_piece, [OAV_natural size_bytes]) ->
            let piece = CLP_piece size_bytes s.s_value in
            (* we allow a piece (or bit_piece) to be any simple_location, including implicit and stack values. Unclear if this is intended, esp. the latter *)
            let stack' = [] in
            let value' = SL_empty in
            Success <| s_stack = stack'; s_value = value'; s_location_pieces = s.s_location_pieces ++ [piece] |>
        | (OpSem_bit_piece, [OAV_natural size_bits; OAV_natural offset_bits]) ->
            let piece = CLP_bit_piece size_bits offset_bits s.s_value in
            let stack' = [] in
            let value' = SL_empty in
            Success <| s_stack = stack'; s_value = value'; s_location_pieces = s.s_location_pieces ++ [piece] |>
        | (OpSem_implicit_value, [OAV_block size bs]) ->
            let stack' = [] in
            let value' = SL_implicit bs in
            Success <| s with s_stack = stack'; s_value = value' |>
        | (OpSem_stack_value, []) ->
            (* "The DW_OP_stack_value operation terminates the expression." - does
               this refer to just the subexpression, ie allowing a stack value to be
               a piece of a composite location, or necessarily the whole expression?
               Why does DW_OP_stack_value have this clause while DW_OP_implicit_value
               does not? *)
            (* why doesn't DW_OP_stack_value have a size argument? *)
            match s.s_stack with
            | (v,t)::vs' ->
                let stack' = [] in
                (* Claude: the value's bytes are those of its type's size (the address size for the generic type) *)
                let value' = SL_implicit (bytes_of_sym_natural c.endianness (sym_natural_const (stack_type_size cuh t)) v) in
                Success <| s with s_stack = stack'; s_value = value' |>

            | _ -> Fail "OpSem_stack_value not given an element on stack"
            end
        | (OpSem_call_frame_cfa, []) ->
            let row = find_cfa_table_row_for_pc evaluated_frame_info pc in
            match row.ctr_cfa with
            | CR_undefined ->
                Assert_extra.failwith "evaluate_cfa of CR_undefined"
            | CR_register r i ->
                bregxi r i  (* same behaviour as an OpSem_bregx *)
            | CR_expression bs ->
                Assert_extra.failwith "CR_expression"
                (*TODO: fix result type - not this evaluate_location_description_bytes c str evaluated_frame_info cuh ac ev mfbloc pc bs*)
                  (* TODO: restrict allowed OpSem_* in that recursive call *)
            end
        (* Claude: the DWARF 5 operations *)
        | (OpSem_addrx, [OAV_natural i]) ->
            match addrx_address str i with
            | Just a -> push_memory_address a s.s_stack
            | Nothing -> Fail ("DW_OP_addrx: no address table entry for index " ^ pphex_sym i)
            end
        | (OpSem_constx, [OAV_natural i]) ->
            match addrx_address str i with
            | Just a -> push_memory_address a s.s_stack
            | Nothing -> Fail ("DW_OP_constx: no address table entry for index " ^ pphex_sym i)
            end
        | (OpSem_const_type, [OAV_natural toff; OAV_block n bs]) ->
            typed_type toff (fun t ->
              let ac' = ac_of_stack_type ac t in
              push_typed ((sym_natural_of_bytes c.endianness bs) mod ac'.ac_all) t s.s_stack)
        | (OpSem_regval_type, [OAV_natural r; OAV_natural toff]) ->
            typed_type toff (fun t ->
              match ev.read_register r with
              | RRR_result v -> let ac' = ac_of_stack_type ac t in push_typed (v mod ac'.ac_all) t s.s_stack
              | RRR_not_currently_available -> Fail "RRR_not_currently_available"
              | RRR_bad_register_number -> Fail ("RRR_bad_register_number " ^ show r)
              end)
        | (OpSem_deref_type, [OAV_natural n; OAV_natural toff]) ->
            typed_type toff (fun t ->
              match s.s_stack with
              | (a,ta)::vs' ->
                  if not (stack_type_integral ta) then Fail ("DW_OP_deref_type: address of a non-integral type: " ^ pp_operation op) else
                  match ev.read_memory a n with
                  | MRR_result v -> let ac' = ac_of_stack_type ac t in push_typed (v mod ac'.ac_all) t vs'
                  | MRR_not_currently_available -> Fail "MRR_not_currently_available"
                  | MRR_bad_address -> Fail "MRR_bad_address"
                  end
              | [] -> Fail "DW_OP_deref_type not given an element on stack"
              end)
        | (OpSem_convert, [OAV_natural toff]) ->
            typed_type toff (fun t' ->
              match s.s_stack with
              | (v,t)::vs' ->
                  if not (stack_type_integral t && stack_type_integral t') then Fail ("DW_OP_convert: floating-point base types are not supported: " ^ pp_operation op)
                  else push_typed (convert_stack_entry ac v t t') t' vs'
              | [] -> Fail "DW_OP_convert not given an element on stack"
              end)
        | (OpSem_reinterpret, [OAV_natural toff]) ->
            typed_type toff (fun t' ->
              match s.s_stack with
              | (v,t)::vs' ->
                  if stack_type_size cuh t <> stack_type_size cuh t' then Fail ("DW_OP_reinterpret: types of different sizes: " ^ pp_operation op)
                  else push_typed v t' vs'
              | [] -> Fail "DW_OP_reinterpret not given an element on stack"
              end)
        | (_, _) ->
            Fail ("bad OpSem invocation: op=" ^ pp_operation op ^ " arguments=" ^ String.concat "" (List.map pp_operation_argument_value op.op_argument_values))
        end
      in
      match es' with
      | Success s' -> continue_with s' ops'
      | Fail e -> Fail e
      end
      end
  end

and evaluate_location_description_bytes (c:p_context) (str: unit_context) (evaluated_frame_info: evaluated_frame_info) (cuh: compilation_unit_header) (ac: arithmetic_context) (ev: evaluation_context) (mfbloc: maybe attribute_value) (pc: sym_natural) (bs: sym_byte_sequence) : error single_location =
  let parse_context = <|pc_bytes = bs; pc_offset = 0  |> in
  match parse_operations c cuh parse_context with
  | PR_fail s pc' -> Fail ("evaluate_location_description_bytes: parse_operations fail: " ^ pp_parse_fail s pc')
  | PR_success ops pc' ->
      if sym_bs_length pc'.pc_bytes <> 0 then
        Fail "evaluate_location_description_bytes: extra non-parsed bytes"
      else
        evaluate_operation_list c str evaluated_frame_info  cuh ac ev mfbloc pc ops evaluation_fuel initial_state ops
  end

and evaluate_location_description (c:p_context) (str: unit_context) (evaluated_frame_info: evaluated_frame_info) (cuh: compilation_unit_header) (ac: arithmetic_context) (ev: evaluation_context) (mfbloc: maybe attribute_value) (pc: sym_natural) (loc:attribute_value) : error single_location =
  match loc with
  | AV_exprloc n bs ->
      evaluate_location_description_bytes c str evaluated_frame_info  cuh ac ev mfbloc pc bs
  | AV_block n bs ->
      evaluate_location_description_bytes c str evaluated_frame_info  cuh ac ev mfbloc pc bs
  | AV_sec_offset n ->
      (* Claude: a location list, DWARF 4 (.debug_loc) or 5 (.debug_loclists); its
         entries' offsets are relative to the unit's base address or to the list's
         own base address entries, which location_list_of_attribute_value applies *)
      match location_list_of_attribute_value str loc with
      | Just ranges ->
          match myfind (fun (lo,hi,_) -> pc >= lo && pc < hi) ranges with
          | Just (_,_,bs) ->
              evaluate_location_description_bytes c str evaluated_frame_info  cuh ac ev mfbloc pc bs
          | Nothing ->
              Fail "evaluate_location_description didn't find pc in location list ranges"
          end
      | Nothing -> Fail ("evaluate_location_description: location list not found: " ^ pp_attribute_value_plain loc)
      end
  | AV_loclistx i ->
      match location_list_of_attribute_value str loc with
      | Just ranges ->
          match myfind (fun (lo,hi,_) -> pc >= lo && pc < hi) ranges with
          | Just (_,_,bs) ->
              evaluate_location_description_bytes c str evaluated_frame_info  cuh ac ev mfbloc pc bs
          | Nothing ->
              Fail "evaluate_location_description didn't find pc in location list ranges"
          end
      | Nothing -> Fail ("evaluate_location_description: location list not found: " ^ pp_attribute_value_plain loc)
      end
  | _ -> Fail "evaluate_location_description av_location not understood"
  end





(** ************************************************************ *)
(** ****  evaluation of frame information ********************** *)
(** ************************************************************ *)

(** register maps *)

val rrp_update : register_rule_map -> cfa_register -> register_rule -> register_rule_map
let rrp_update rrp r rr = (r,rr)::rrp

val rrp_lookup : cfa_register -> register_rule_map -> register_rule
let rrp_lookup r rrp =
  match List.lookup r rrp with
  | Just rr -> rr
  | Nothing -> RR_undefined
  end

val rrp_empty : register_rule_map
let rrp_empty = []



(** pp of evaluated cfa information from .debug_frame *)
(* readelf --debug-dump=frames-interp test/a.out


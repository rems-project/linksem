    List.mapi (fun i -> fun pent ->
      let mapping =
        match get_elf64_section_to_segment_mapping hdr sht pent elf64_section_in_segment stbl with
          | Fail err   -> ["ERR: " ^ err]
          | Success mp -> intercalate " " mp
        end
      in
      let str =
        let temp = concatS mapping in
          if temp = "" then
            temp
          else
            temp ^ " "
      in
        concatS [
          "   " ^ hex_string_of_nat_pad2 i
        ; "     "
        ; str
        ]
    ) pht
  in
    (String.concat "\n" map)

val harness_string_of_elf32_program_headers : (natural -> string) -> (natural -> string) -> elf32_header -> elf32_program_header_table -> elf32_section_header_table -> string_table -> byte_sequence -> string
let {ocaml} harness_string_of_elf32_program_headers os proc hdr pht sht stbl bs0 =
  let pht_len = List.length pht in
    if pht_len = 0 then
      "\nThere are no program headers in this file."
    else
      unlines [
        ""
      ; "Elf file type is " ^ string_of_elf_file_type default_os_specific_print default_proc_specific_print (natural_of_elf32_half hdr.elf32_type)
      ; "Entry point " ^ "0x" ^ unsafe_hex_string_of_natural 1 (natural_of_elf32_addr hdr.elf32_entry)
      ; "There are " ^ show (List.length pht) ^ " program headers, starting at offset " ^ show hdr.elf32_phoff
      ; ""
      ; "Program Headers:"
      ; harness_string_of_elf32_pht os proc pht bs0
      ; ""
      ; " Section to Segment mapping:"
      ; "  Segment Sections..."
      ; harness_string_of_elf32_segment_section_mappings hdr pht sht stbl
      ]

val harness_string_of_elf64_program_headers : (natural -> string) -> (natural -> string) -> elf64_header -> elf64_program_header_table -> elf64_section_header_table -> string_table -> byte_sequence -> string
let {ocaml} harness_string_of_elf64_program_headers os proc hdr pht sht stbl bs0 =
  let pht_len = List.length pht in
    if pht_len = 0 then
      "\nThere are no program headers in this file."
    else
      unlines [
        ""
      ; "Elf file type is " ^ string_of_elf_file_type default_os_specific_print default_proc_specific_print (natural_of_elf64_half hdr.elf64_type)
      ; "Entry point " ^ "0x" ^ unsafe_hex_string_of_natural 1 (natural_of_elf64_addr hdr.elf64_entry)
      ; "There are " ^ show (List.length pht) ^ " program headers, starting at offset " ^ show hdr.elf64_phoff
      ; ""
      ; "Program Headers:"
      ; harness_string_of_elf64_pht os proc pht bs0
      ; ""
      ; " Section to Segment mapping:"
      ; "  Segment Sections..."
      ; harness_string_of_elf64_segment_section_mappings hdr pht sht stbl
      ]

(** Claude: the section-header output of this harness reproduces that of GNU
  * readelf in wide mode ([readelf -W -S]).  readelf's output changes between
  * binutils releases; the text and behaviour here track binutils 2.42
  * ([binutils/readelf.c], functions [process_section_headers],
  * [get_elf_section_flags] and [get_section_type_name]).  When comparing
  * against a different readelf, expect differences in the flag legend first.
  *)

(** Claude: [harness_sht_flag_legend mach osabi] is readelf's "Key to Flags"
  * footer.  The optional entries depend on the file's [e_machine] and
  * [e_ident[EI_OSABI]], exactly as in readelf 2.42.
  *)
val harness_sht_flag_legend : natural -> natural -> string
let {ocaml} harness_sht_flag_legend mach osabi =
  "\nKey to Flags:\n" ^
  "  W (write), A (alloc), X (execute), M (merge), S (strings), I (info),\n" ^
  "  L (link order), O (extra OS processing required), G (group), T (TLS),\n" ^
  "  C (compressed), x (unknown), o (OS specific), E (exclude),\n" ^
  "  " ^
  (if osabi = elf_osabi_gnu || osabi = elf_osabi_freebsd then "R (retain), " else "") ^
  (if osabi = elf_osabi_gnu || osabi = elf_osabi_freebsd || osabi = elf_osabi_none then "D (mbind), " else "") ^
  (if mach = elf_ma_x86_64 || mach = elf_ma_l10m || mach = elf_ma_k10m then "l (large), "
   else if mach = elf_ma_arm then "y (purecode), "
   else if mach = elf_ma_ppc then "v (VLE), "
   else "") ^
  "p (processor specific)"

(** Claude: [harness_string_of_proc_section_type mach t] names a section type in
  * the processor-specific range as readelf 2.42 does for the machines linksem
  * supports, falling back to readelf's [LOPROC+0x...] form.
  *)
val harness_string_of_proc_section_type : natural -> natural -> string
let {ocaml} harness_string_of_proc_section_type mach t =
  let d = t - sht_loproc in
    if mach = elf_ma_aarch64 && d = 3 then
      "AARCH64_ATTRIBUTES"
    else if mach = elf_ma_arm && d = 1 then
      "ARM_EXIDX"
    else if mach = elf_ma_arm && d = 2 then
      "ARM_PREEMPTMAP"
    else if mach = elf_ma_arm && d = 3 then
      "ARM_ATTRIBUTES"
    else if mach = elf_ma_arm && d = 4 then
      "ARM_DEBUGOVERLAY"
    else if mach = elf_ma_arm && d = 5 then
      "ARM_OVERLAYSECTION"
    else if (mach = elf_ma_x86_64 || mach = elf_ma_l10m || mach = elf_ma_k10m) && d = 1 then
      "X86_64_UNWIND"
    else if mach = elf_ma_riscv && d = 3 then
      "RISCV_ATTRIBUTES"
    else
      "LOPROC+" ^ unsafe_hex_string_of_natural_alternate d

(** Claude: [harness_string_of_user_section_type t] is readelf's [LOUSER+0x...]
  * form for section types in the user range.
  *)
val harness_string_of_user_section_type : natural -> string
let {ocaml} harness_string_of_user_section_type t =
  "LOUSER+" ^ unsafe_hex_string_of_natural_alternate (t - sht_louser)

(** Claude: [harness_string_of_section_type os proc usr t] wraps
  * [string_of_section_type] with the few spellings peculiar to readelf: the
  * long name for SYMTAB_SHNDX, the two old Sun types in the processor range,
  * and the [%08x: <unknown>] form for values outside every defined range.
  *)
val harness_string_of_section_type : (natural -> string) -> (natural -> string) -> (natural -> string) -> natural -> string
let {ocaml} harness_string_of_section_type os proc usr t =
  if t = sht_symtab_shndx then
    "SYMTAB SECTION INDICES"
  else if t = sht_loproc + 268435453 then (* 0x7ffffffd *)
    "AUXILIARY"
  else if t = sht_loproc + 268435455 then (* 0x7fffffff *)
    "FILTER"
  else if (t > sht_relr && t < sht_loos) || t > sht_hiuser then
    unsafe_hex_string_of_natural 8 t ^ ": <unknown>"
  else
    string_of_section_type os proc usr t

val harness_string_of_elf32_sht : natural -> natural -> (natural -> string) -> (natural -> string) -> (natural -> string) -> elf32_section_header_table -> string_table -> string
let {ocaml} harness_string_of_elf32_sht mach osabi os proc usr sht stbl =
  "  [Nr] Name              Type            Addr     Off    Size   ES Flg Lk Inf Al\n" ^
  unlines (List.mapi (fun i -> fun sec ->
    let is =
      let temp = show i in
        if stringLength temp = 1 then
          " " ^ temp
        else
          temp
    in
    let str = "  [" ^ is ^ "]" in
    let ((gap : string), name) =
      match String_table.get_string_at (natural_of_elf32_word sec.elf32_sh_name) stbl with
        | Fail err   -> ("", "ERR " ^ err)
        | Success nm ->
          if natural_of_elf32_word sec.elf32_sh_type = sht_null then
            let gap = List.foldr (^) " " (Missing_pervasives.replicate 17 " ") in
            (gap, "")
          else
            let glen = naturalFromNat (17 - String.stringLength nm) in
            let gap = List.foldr (^) " " (Missing_pervasives.replicate glen " ") in
              (gap, nm)
      end
    in
    let str = str ^ " " ^ name ^ gap in
    let typ = harness_string_of_section_type os proc usr (natural_of_elf32_word sec.elf32_sh_type) in
    let str = str ^ typ in
    let (gap, addr) =
      let mx  = naturalFromNat (15 - String.stringLength typ) in
      let gap = List.foldr (^) " " (Missing_pervasives.replicate mx " ") in
        (gap, unsafe_hex_string_of_natural 8 (natural_of_elf32_addr sec.elf32_sh_addr))
    in
    let str = str ^ gap ^ addr in
    let off = unsafe_hex_string_of_natural 6 (natural_of_elf32_off sec.elf32_sh_offset) in
    let str = str ^ " " ^ off in
    let size = unsafe_hex_string_of_natural 6 (natural_of_elf32_word sec.elf32_sh_size) in
    let str = str ^ " " ^ size in
    let es  = unsafe_hex_string_of_natural 2 (natural_of_elf32_word sec.elf32_sh_entsize) in
    let str = str ^ " " ^ es in
    let flg = string_of_section_flags mach osabi (natural_of_elf32_word sec.elf32_sh_flags) in
    let str = str ^ " " ^ flg in
    let (gap, lnk) =
      let l  = show (natural_of_elf32_word sec.elf32_sh_link) in
      let gp = naturalFromNat (2 - String.stringLength l) in
      let gp = List.foldr (^) " " (replicate gp " ") in
        (gp, l)
    in
    let str = str ^ gap ^ lnk in
    let (gap, info) =
      let i  = show (natural_of_elf32_word sec.elf32_sh_info) in
      let gp = naturalFromNat (3 - String.stringLength i) in
      let gp = List.foldr (^) " " (replicate gp " ") in
        (gp, i)
    in
    let str = str ^ gap ^ info in
    let (gap, align) =
      let a  = show (natural_of_elf32_word sec.elf32_sh_addralign) in
      let gp = naturalFromNat (2 - String.stringLength a) in
      let gp = List.foldr (^) " " (replicate gp " ") in
        (gp, a)
    in
    let str = str ^ gap ^ align in
      str) sht)

val harness_string_of_elf64_sht : natural -> natural -> (natural -> string) -> (natural -> string) -> (natural -> string) -> elf64_section_header_table -> string_table -> string
let {ocaml} harness_string_of_elf64_sht mach osabi os proc usr sht stbl =
  "  [Nr] Name              Type            Address          Off    Size   ES Flg Lk Inf Al\n" ^
  unlines (List.mapi (fun i -> fun sec ->
    let is =
      let temp = show i in
        if stringLength temp = 1 then
          " " ^ temp
        else
          temp
    in
    let str = "  [" ^ is ^ "]" in
    let ((gap : string), name) =
      match String_table.get_string_at (natural_of_elf64_word sec.elf64_sh_name) stbl with
        | Fail err   -> ("", "ERR " ^ err)
        | Success nm ->
          if natural_of_elf64_word sec.elf64_sh_type = sht_null then
            let gap = List.foldr (^) " " (Missing_pervasives.replicate 17 " ") in
            (gap, "")
          else
            let glen = naturalFromNat (17 - String.stringLength nm) in
            let gap = List.foldr (^) " " (Missing_pervasives.replicate glen " ") in
              (gap, nm)
      end
    in
    let str = str ^ " " ^ name ^ gap in
    let typ = harness_string_of_section_type os proc usr (natural_of_elf64_word sec.elf64_sh_type) in
    let str = str ^ typ in
    let (gap, addr) =
      let mx  = naturalFromNat (15 - String.stringLength typ) in
      let gap = List.foldr (^) " " (Missing_pervasives.replicate mx " ") in
        (gap, unsafe_hex_string_of_natural 16 (natural_of_elf64_addr sec.elf64_sh_addr))
    in
    let str = str ^ gap ^ addr in
    let off = unsafe_hex_string_of_natural 6 (natural_of_elf64_off sec.elf64_sh_offset) in
    let str = str ^ " " ^ off in
    let size = unsafe_hex_string_of_natural 6 (natural_of_elf64_xword sec.elf64_sh_size) in
    let str = str ^ " " ^ size in
    let es  = unsafe_hex_string_of_natural 2 (natural_of_elf64_xword sec.elf64_sh_entsize) in
    let str = str ^ " " ^ es in
    let flg = string_of_section_flags mach osabi (natural_of_elf64_xword sec.elf64_sh_flags) in
    let str = str ^ " " ^ flg in
    let (gap, lnk) =
      let l  = show (natural_of_elf64_word sec.elf64_sh_link) in
      let gp = naturalFromNat (2 - String.stringLength l) in
      let gp = List.foldr (^) " " (replicate gp " ") in
        (gp, l)
    in
    let str = str ^ gap ^ lnk in
    let (gap, info) =
      let i  = show (natural_of_elf64_word sec.elf64_sh_info) in
      let gp = naturalFromNat (3 - String.stringLength i) in
      let gp = List.foldr (^) " " (replicate gp " ") in
        (gp, i)
    in
    let str = str ^ gap ^ info in
    let (gap, align) =
      let a  = show (natural_of_elf64_xword sec.elf64_sh_addralign) in
      let gp = naturalFromNat (2 - String.stringLength a) in
      let gp = List.foldr (^) " " (replicate gp " ") in
        (gp, a)
    in
    let str = str ^ gap ^ align in
      str) sht)


val harness_string_of_elf32_section_headers : (natural -> string) -> (natural -> string) -> (natural -> string) -> elf32_header -> elf32_section_header_table -> string_table -> string
let {ocaml} harness_string_of_elf32_section_headers os proc usr hdr sht stbl =
  unlines [
    "There are " ^ show (List.length sht) ^ " section headers, starting at offset 0x" ^ unsafe_hex_string_of_natural 0 (natural_of_elf32_off hdr.elf32_shoff) ^ ":"
  ; ""
  ; "Section Headers:"
  ; harness_string_of_elf32_sht (natural_of_elf32_half hdr.elf32_machine) (get_elf32_osabi hdr) os proc usr sht stbl
  ] ^ harness_sht_flag_legend (natural_of_elf32_half hdr.elf32_machine) (get_elf32_osabi hdr)

val harness_string_of_elf64_section_headers : (natural -> string) -> (natural -> string) -> (natural -> string) -> elf64_header -> elf64_section_header_table -> string_table -> string
let {ocaml} harness_string_of_elf64_section_headers os proc usr hdr sht stbl =
  unlines [
    "There are " ^ show (List.length sht) ^ " section headers, starting at offset 0x" ^ unsafe_hex_string_of_natural 0 (natural_of_elf64_off hdr.elf64_shoff) ^ ":"
  ; ""
  ; "Section Headers:"
  ; harness_string_of_elf64_sht (natural_of_elf64_half hdr.elf64_machine) (get_elf64_osabi hdr) os proc usr sht stbl
  ] ^ harness_sht_flag_legend (natural_of_elf64_half hdr.elf64_machine) (get_elf64_osabi hdr)

val harness_string_of_elf32_reloc_entry : (natural -> string) -> Map.map natural elf32_section_header_table_entry ->
  Map.map natural elf32_symbol_table_entry -> string_table -> string_table -> elf32_relocation -> string
let {ocaml} harness_string_of_elf32_reloc_entry os sht symtab stbl sechdr_stbl rel =
  let off  = natural_of_elf32_addr rel.elf32_r_offset in
  let inf  = natural_of_elf32_word rel.elf32_r_info in
  let typ  = os 0 in (* FIXME *) (* Claude: readelf -W does not truncate the type name *)
  let typs =
    let len = naturalFromNat (22 - String.stringLength typ) in
      concatS (replicate len " ")
  in
  let idx  = 0 in (* FIXME *)
    match Map.lookup idx symtab with
      | Nothing  -> "harness_string_of_elf32_reloc_entry: Nothing returned"
      | Just sym ->
        let (nm, value, symtyp, secthdr)  =
          match Map.lookup idx symtab with
            | Nothing  -> (stn_undef, 0, 0, 0)
            | Just sym -> (natural_of_elf32_word sym.elf32_st_name,
                natural_of_elf32_addr sym.elf32_st_value, get_elf32_symbol_type sym,
                  natural_of_elf32_half sym.elf32_st_shndx)
          end
        in
          if symtyp = stt_section then
            let vlu = " " ^ unsafe_hex_string_of_natural 8 value in
            let nm =
              match Map.lookup secthdr sht with
                | Nothing   -> "XXX"
                | Just shdr ->
                  match String_table.get_string_at (natural_of_elf32_word shdr.elf32_sh_name) sechdr_stbl with
                    | Fail    f -> f
                    | Success n -> n
                 end
              end
            in
              concatS [
                unsafe_hex_string_of_natural 8 off
              ; "  "
              ; unsafe_hex_string_of_natural 8 inf
              ; " "
              ; typ
              ; typs
              ; vlu
              ; "   "
              ; nm
              ]
            else if nm = stn_undef then
              concatS [
                unsafe_hex_string_of_natural 8 off
              ; "  "
              ; unsafe_hex_string_of_natural 8 inf
              ; " "
              ; typ
              ; typs
              ]
            else
              let vlu = " " ^ unsafe_hex_string_of_natural 8 (natural_of_elf32_addr sym.elf32_st_value) in
              let nm =
                match String_table.get_string_at nm stbl with
                  | Fail    f -> f
                  | Success n -> n
                end
              in
                concatS [
                  unsafe_hex_string_of_natural 8 off
                ; "  "
                ; unsafe_hex_string_of_natural 8 inf
                ; " "
                ; typ
                ; typs
                ; vlu
                ; "   "
                ; nm
                ]
    end

val harness_string_of_elf64_reloc_a_entry : (natural -> string) -> Map.map natural elf64_symbol_table_entry ->
  Map.map natural elf64_section_header_table_entry -> string_table -> string_table -> elf64_relocation_a -> string
let {ocaml} harness_string_of_elf64_reloc_a_entry os symtab sht stbl sechdr_stbl rel =
  let off    = natural_of_elf64_addr  rel.elf64_ra_offset in
  let inf    = natural_of_elf64_xword rel.elf64_ra_info in
  let add    = integer_of_elf64_sxword rel.elf64_ra_addend in
  let (typ, sym) = parse_elf64_relocation_info rel.elf64_ra_info in
  (* Claude: readelf -W prints the type name in full, padded to 22 columns
   * (its "%-22s"); it does not truncate it. *)
  let typ    = os typ in
  let typs   =
    let len = naturalFromNat (22 - String.stringLength typ) in
      concatS (replicate len " ")
  in
  let idx  = sym in
  let (nm, value, symtyp, secthdr)  =
    match Map.lookup idx symtab with
      | Nothing  -> (stn_undef, 0, 0, 0)
      | Just sym -> (natural_of_elf64_word sym.elf64_st_name,
        natural_of_elf64_addr sym.elf64_st_value, get_elf64_symbol_type sym,
          natural_of_elf64_half sym.elf64_st_shndx)
    end
  in
    if symtyp = stt_section then
      let vlu = " " ^ unsafe_hex_string_of_natural 16 value in
      let nm =
        match Map.lookup secthdr sht with
          | Nothing   -> "XXX"
          | Just shdr ->
            match String_table.get_string_at (natural_of_elf64_word shdr.elf64_sh_name) sechdr_stbl with
              | Fail    f -> f
              | Success n -> n
            end
        end
      in
        concatS [
          unsafe_hex_string_of_natural 16 off
        ; "  "
        ; unsafe_hex_string_of_natural 16 inf
        ; " "
        ; typ
        ; typs
        ; vlu
        ; " "
        ; nm
        ; " + "
        ; hex_string_of_big_int_no_padding' add
        ]
    else if nm = stn_undef then
      concatS [
        unsafe_hex_string_of_natural 16 off
      ; "  "
      ; unsafe_hex_string_of_natural 16 inf
      ; " "
      ; typ
      ; typs
      ; "                    "
      ; hex_string_of_big_int_no_padding' add
      ]
    else
      let vlu = " " ^ unsafe_hex_string_of_natural 16 value in
      let nm =
        match String_table.get_string_at nm stbl with
          | Fail    f -> f
          | Success n -> n
        end
      in
        concatS [
          unsafe_hex_string_of_natural 16 off
        ; "  "
        ; unsafe_hex_string_of_natural 16 inf
        ; " "
        ; typ
        ; typs
        ; vlu
        ; " "
        ; nm
        ; " + "
        ; hex_string_of_big_int_no_padding' add
        ]

val harness_string_of_elf32_relocs' : endianness -> (natural -> string) -> elf32_file -> elf32_section_header_table ->
  elf32_section_header_table -> string_table -> byte_sequence -> string
let {ocaml} harness_string_of_elf32_relocs' endian os f1 sht_relocs sht shdr bs0 =
  (* Claude: index the section header table once, and parse each symbol table
   * that any relocation section links to exactly once (as an indexed map), so
   * that the work is linear in the number of sections and relocations.  The
   * previous version re-parsed the linked symbol table for every relocation
   * section and searched it linearly for every relocation. *)
  let sht = index_map sht in
  let symtabs =
    List.foldl (fun acc ent ->
      acc >>= fun symtabs ->
      let lnk = natural_of_elf32_word ent.elf32_sh_link in
        match Map.lookup lnk symtabs with
          | Just _  -> return symtabs
          | Nothing ->
            (* Claude: the names of the symbols in a symbol table live in the
             * string table that the symbol table's section header links to.
             * (The previous version used [get_elf32_file_symbol_string_table],
             * which concatenates every STRTAB section of the file; when
             * .shstrtab precedes .strtab, as in objects produced by ld -r, every
             * name was read from the wrong offset.) *)
            (match Map.lookup lnk sht with
              | Just sh -> return (natural_of_elf32_word sh.elf32_sh_link)
              | Nothing -> fail "harness_string_of_elf32_relocs': symbol table section not found"
            end) >>= fun strlnk ->
            Elf_file.get_elf32_string_table_by_index f1 strlnk >>= fun strtab ->
            Elf_file.get_elf32_symbol_table_by_index f1 lnk >>= fun symtab ->
            return (Map.insert lnk (index_map symtab, strtab) symtabs)
        end)
      (return (Map.empty : Map.map natural (Map.map natural elf32_symbol_table_entry * string_table))) sht_relocs
  in
  let rels =
    symtabs >>= fun symtabs ->
    mapM (fun ent ->
      let off = natural_of_elf32_off  ent.elf32_sh_offset in
      let siz = natural_of_elf32_word ent.elf32_sh_size in
      let lnk = natural_of_elf32_word ent.elf32_sh_link in
        Byte_sequence.offset_and_cut off siz bs0 >>= fun rels ->
        Elf_relocation.read_elf32_relocation_section' endian rels >>= fun sect ->
        (match Map.lookup lnk symtabs with
          | Just symtab_strtab -> return symtab_strtab
          | Nothing            -> fail "harness_string_of_elf32_relocs': symbol table not found"
        end) >>= fun (symtab, strtab) ->
        return (sect, ent, symtab, strtab)
    ) sht_relocs
  >>=
    mapM (fun (rels, ent, symtab, strtab) ->
      let nm  = natural_of_elf32_word ent.elf32_sh_name in
      let off = unsafe_hex_string_of_natural 0 (natural_of_elf32_off ent.elf32_sh_offset) in
      let len = show (List.length rels) ^ " " ^ entries_word (List.length rels) in
      String_table.get_string_at nm shdr >>= fun nm ->
      let hdr = "Relocation section '" ^ nm ^ "' at offset 0x" ^ off ^ " contains " ^ len ^ ":\n" in
      let ttl = " Offset     Info    Type                Sym. Value  Symbol's Name\n" in
      let body = (String.concat "\n" (List.map (harness_string_of_elf32_reloc_entry os sht symtab strtab shdr) rels)) in
      return (hdr ^ ttl ^ body))
  in
    match rels with
      | Fail err -> err
      | Success s -> (String.concat "\n\n" s)
    end

val harness_string_of_elf64_relocs' : endianness -> (natural -> string) -> elf64_file ->
  elf64_section_header_table -> elf64_section_header_table ->
  string_table -> byte_sequence -> string
let {ocaml} harness_string_of_elf64_relocs' endian os f1 reloc_sht sht shdr bs0 =
  (* Claude: index the section header table once, and parse each symbol table
   * that any relocation section links to exactly once (as an indexed map), so
   * that the work is linear in the number of sections and relocations.  The
   * previous version re-parsed the linked symbol table for every relocation
   * section and searched it linearly for every relocation. *)
  let sht = index_map sht in
  let symtabs =
    List.foldl (fun acc ent ->
      acc >>= fun symtabs ->
      let lnk = natural_of_elf64_word ent.elf64_sh_link in
        match Map.lookup lnk symtabs with
          | Just _  -> return symtabs
          | Nothing ->
            (* Claude: the names of the symbols in a symbol table live in the
             * string table that the symbol table's section header links to.
             * (The previous version used [get_elf64_file_symbol_string_table],
             * which concatenates every STRTAB section of the file; when
             * .shstrtab precedes .strtab, as in objects produced by ld -r, every
             * name was read from the wrong offset.) *)
            (match Map.lookup lnk sht with
              | Just sh -> return (natural_of_elf64_word sh.elf64_sh_link)
              | Nothing -> fail "harness_string_of_elf64_relocs': symbol table section not found"
            end) >>= fun strlnk ->
            Elf_file.get_elf64_string_table_by_index f1 strlnk >>= fun strtab ->
            Elf_file.get_elf64_symbol_table_by_index f1 lnk >>= fun symtab ->
            return (Map.insert lnk (index_map symtab, strtab) symtabs)
        end)
      (return (Map.empty : Map.map natural (Map.map natural elf64_symbol_table_entry * string_table))) reloc_sht
  in
  let rels =
    symtabs >>= fun symtabs ->
    mapM (fun ent ->
      let off = natural_of_elf64_off  ent.elf64_sh_offset in
      let siz = natural_of_elf64_xword ent.elf64_sh_size in
      let lnk = natural_of_elf64_word ent.elf64_sh_link in
        Byte_sequence.offset_and_cut off siz bs0 >>= fun rels ->
        Elf_relocation.read_elf64_relocation_a_section' endian rels >>= fun sect ->
        (match Map.lookup lnk symtabs with
          | Just symtab_strtab -> return symtab_strtab
          | Nothing            -> fail "harness_string_of_elf64_relocs': symbol table not found"
        end) >>= fun (symtab, strtab) ->
        return (sect, ent, symtab, strtab)
    ) reloc_sht
  >>=
    mapM (fun (rels, ent, symtab, strtab) ->
      let nm  = natural_of_elf64_word ent.elf64_sh_name in
      let off = unsafe_hex_string_of_natural 0 (natural_of_elf64_off ent.elf64_sh_offset) in
      let len = show (List.length rels) ^ " " ^ entries_word (List.length rels) in
      String_table.get_string_at nm shdr >>= fun nm ->
      let hdr = "Relocation section '" ^ nm ^ "' at offset 0x" ^ off ^ " contains " ^ len ^ ":\n" in
      let ttl = "    Offset             Info             Type               Symbol's Value  Symbol's Name + Addend\n" in
      let body = (String.concat "\n" (List.map (harness_string_of_elf64_reloc_a_entry os symtab sht strtab shdr) rels)) in
      return (hdr ^ ttl ^ body))
  in
    match rels with
      | Fail err -> err
      | Success s -> (String.concat "\n\n" s)
    end

val harness_string_of_elf32_relocs : elf32_file -> (natural -> string) -> byte_sequence -> string
let {ocaml} harness_string_of_elf32_relocs f1 os bs0 =
  let hdr       = f1.elf32_file_header in
  let sht       = f1.elf32_file_section_header_table in
  let endian    = get_elf32_header_endianness hdr in
  let rel_secs  = List.filter (fun x ->
    x.elf32_sh_type = elf32_word_of_natural sht_rel) sht in
  if List.length rel_secs = 0 then
    "\nThere are no relocations in this file."
  else
    match get_elf32_string_table_by_index f1 (natural_of_elf32_half hdr.elf32_shstrndx) with
      | Fail err     -> err
      | Success shdr -> "\n" ^ harness_string_of_elf32_relocs' endian os f1 rel_secs sht shdr bs0
    end

val harness_string_of_elf64_relocs : elf64_file -> (natural -> string) -> byte_sequence -> string
let {ocaml} harness_string_of_elf64_relocs f1 os bs0 =
  let hdr       = f1.elf64_file_header in
  let sht       = f1.elf64_file_section_header_table in
  let endian    = get_elf64_header_endianness hdr in
  let rel_secs  = List.filter (fun x ->
    x.elf64_sh_type = elf64_word_of_natural sht_rela) sht in
  if List.length rel_secs = 0 then
    "\nThere are no relocations in this file."
  else
    match get_elf64_string_table_by_index f1 (natural_of_elf64_half hdr.elf64_shstrndx) with
      | Fail err     -> err
      | Success shdr -> "\n" ^ harness_string_of_elf64_relocs' endian os f1 rel_secs sht shdr bs0
    end

(** Claude: symbol table dump in the layout of [readelf -W -s] (binutils 2.42,
  * [print_symbol] in binutils/readelf.c).  Field widths are readelf's:
  * ["%6d: "] index, the value in full hex, ["%5d"] size, [" %-7s"] type,
  * [" %-6s"] binding, [" %-7s"] visibility, an optional [" [other] "], [" %4s "]
  * section index, then the name and, for .dynsym entries, the symbol version.
  *)

val rjust : nat -> string -> string
let {ocaml} rjust w s =
  let l = String.stringLength s in
    if l < w then String.concat "" (replicate (naturalFromNat (w - l)) " ") ^ s else s

val ljust : nat -> string -> string
let {ocaml} ljust w s =
  let l = String.stringLength s in
    if l < w then s ^ String.concat "" (replicate (naturalFromNat (w - l)) " ") else s

(** Claude: symbol type name as readelf spells it for the machines and OSABIs
  * linksem knows about ([get_symbol_type]).  [10] in the OS range is IFUNC on
  * GNU and FreeBSD systems; ARM's processor-specific [13] is THUMB_FUNC.
  *)
val harness_string_of_symbol_type : natural -> natural -> natural -> string
let {ocaml} harness_string_of_symbol_type mach osabi t =
  if t = stt_notype then "NOTYPE"
  else if t = stt_object then "OBJECT"
  else if t = stt_func then "FUNC"
  else if t = stt_section then "SECTION"
  else if t = stt_file then "FILE"
  else if t = stt_common then "COMMON"
  else if t = stt_tls then "TLS"
  else if t = 8 then "RELC"
  else if t = 9 then "SRELC"
  else if t >= stt_loproc && t <= stt_hiproc then
    if mach = elf_ma_arm && t = 13 then "THUMB_FUNC"
    else "<processor specific>: " ^ show t
  else if t >= stt_loos && t <= stt_hios then
    if t = 10 && (osabi = elf_osabi_gnu || osabi = elf_osabi_freebsd) then "IFUNC"
    else "<OS specific>: " ^ show t
  else
    "<unknown>: " ^ show t

(** Claude: symbol binding name as readelf spells it ([get_symbol_binding]);
  * [10] in the OS range is UNIQUE on GNU systems.
  *)
val harness_string_of_symbol_binding : natural -> natural -> string
let {ocaml} harness_string_of_symbol_binding osabi b =
  if b = stb_local then "LOCAL"
  else if b = stb_global then "GLOBAL"
  else if b = stb_weak then "WEAK"
  else if b >= stb_loproc && b <= stb_hiproc then "<processor specific>: " ^ show b
  else if b >= stb_loos && b <= stb_hios then
    if b = 10 && osabi = elf_osabi_gnu then "UNIQUE"
    else "<OS specific>: " ^ show b
  else
    "<unknown>: " ^ show b

val harness_string_of_symbol_visibility : natural -> string
let {ocaml} harness_string_of_symbol_visibility v =
  if v = stv_default then "DEFAULT"
  else if v = stv_internal then "INTERNAL"
  else if v = stv_hidden then "HIDDEN"
  else if v = stv_protected then "PROTECTED"
  else "<unknown>"

(** Claude: readelf's rendering of the bits of [st_other] beyond the visibility
  * ([get_symbol_other]).  Only the AArch64 VARIANT_PCS bit is named here; the
  * MIPS, PPC64, RISC-V, Alpha and IA-64 names are not reproduced.
  *)
(** Claude: readelf's ["%5d"] for a symbol size falls back to ["0x%x"] when the
  * value has more than five digits ([print_vma] with [DEC_5]).
  *)
val harness_string_of_symbol_size : natural -> string
let {ocaml} harness_string_of_symbol_size n =
  if n <= 99999 then rjust 5 (show n) else "0x" ^ unsafe_hex_string_of_natural 0 n

val harness_string_of_symbol_other : natural -> natural -> string
let {ocaml} harness_string_of_symbol_other mach other =
  if mach = elf_ma_ppc64 && natural_land other 31 = 0 then
    (* PPC64 local entry offset, STO_PPC64_LOCAL_MASK = 0xe0 *)
    let v = other / 32 in
      if v <= 6 then
        (* readelf decodes 2..6 as 1 << v, i.e. 4, 8, 16, 32, 64 *)
        let v = if v = 2 then 4 else if v = 3 then 8 else if v = 4 then 16
                else if v = 5 then 32 else if v = 6 then 64 else v in
          "<localentry>: " ^ show v
      else
        "<other>: " ^ unsafe_hex_string_of_natural 0 other
  else if mach = elf_ma_aarch64 && natural_land other 128 <> 0 then
    let rest = other - 128 in
      if rest = 0 then "VARIANT_PCS"
      else "VARIANT_PCS | " ^ unsafe_hex_string_of_natural 0 rest
  else
    "<other>: " ^ unsafe_hex_string_of_natural 0 other

(** Claude: [harness_string_of_symbol_ndx mach nsections ndx] is readelf's text
  * for a symbol's section index ([printable_section_name_from_index]) together
  * with whether it is a is_special (non-section) index.
  *)
val harness_string_of_symbol_ndx : natural -> natural -> natural -> (string * bool)
let {ocaml} harness_string_of_symbol_ndx mach nsections ndx =
  if ndx = shn_undef then ("UND", true)
  else if ndx = shn_abs then ("ABS", true)
  else if ndx = shn_common then ("COM", true)
  else if (mach = elf_ma_x86_64 || mach = elf_ma_l10m || mach = elf_ma_k10m) && ndx = shn_loproc + 2 then
    ("LARGE_COM", true)
  else if ndx < nsections then (show ndx, false)
  else if ndx >= shn_loproc && ndx <= shn_hiproc then ("PRC[0x" ^ unsafe_hex_string_of_natural 4 ndx ^ "]", true)
  else if ndx >= shn_loos && ndx <= shn_hios then ("OS [0x" ^ unsafe_hex_string_of_natural 4 ndx ^ "]", true)
  else if ndx >= shn_loreserve then ("RSV[0x" ^ unsafe_hex_string_of_natural 4 ndx ^ "]", true)
  else if nsections <> 0 then ("BAD[0x" ^ unsafe_hex_string_of_natural 0 ndx ^ "]", true)
  else ("<section 0x" ^ unsafe_hex_string_of_natural 0 ndx ^ ">", true)

(** Claude: the GNU symbol version information needed to annotate .dynsym
  * entries: the .gnu.version entries indexed by symbol number, the version
  * definitions, the version requirements, and the largest definition index.
  *)
type harness_symbol_versions =
  maybe (Map.map natural gnu_ext_interpreted_versym_entry * list gnu_ext_interpreted_verdef * list gnu_ext_interpreted_vernaux * natural)

(** Claude: [harness_symbol_version_suffix versions symidx shndx name] is the
  * ["@VER"], ["@@VER"] or ["@VER (n)"] suffix readelf appends to a dynamic
  * symbol's name, following [get_symbol_version_string]: a hidden version is
  * written with one "@", a public definition with "@@", and a required
  * (undefined) version with the requirement's index in parentheses.
  *)
val harness_symbol_version_suffix : harness_symbol_versions -> natural -> natural -> string -> string
let {ocaml} harness_symbol_version_suffix versions symidx shndx name =
  match versions with
    | Nothing -> ""
    | Just (entries, verdefs, vernauxs, max_vd_ndx) ->
      match Map.lookup symidx entries with
        | Nothing -> ""
        | Just entry ->
          let value  = entry.gnu_ext_interpreted_versym_entry_value in
          let hidden = entry.gnu_ext_interpreted_versym_entry_hidden in
          let raw    = if hidden then value + 32768 else value in
          if (not hidden) && value = 0 then ""
          else
            let from_verdef =
              if shndx <> shn_undef && raw <> 32769 && verdefs <> [] then
                match List.find (fun vd -> vd.gnu_ext_interpreted_verdef_ndx = value) verdefs with
                  | Just vd ->
                    if vd.gnu_ext_interpreted_verdef_ndx = 1 && vd.gnu_ext_interpreted_verdef_flags = 1 then
                      Just ""   (* the base version: readelf prints nothing *)
                    else if vd.gnu_ext_interpreted_verdef_name <> name then
                      Just ((if hidden then "@" else "@@") ^ vd.gnu_ext_interpreted_verdef_name)
                    else
                      Nothing
                  | Nothing -> Nothing
                end
              else
                Nothing
            in
            match from_verdef with
              | Just suffix -> suffix
              | Nothing ->
                match List.find (fun va -> va.gnu_ext_interpreted_vernaux_other = raw) vernauxs with
                  | Just va ->
                    "@" ^ va.gnu_ext_interpreted_vernaux_name ^ " (" ^ show va.gnu_ext_interpreted_vernaux_other ^ ")"
                  | Nothing ->
                    if vernauxs <> [] && (max_vd_ndx <> 0 || value <> 1) && value > max_vd_ndx then
                      (if hidden then "@" else "@@") ^ "<corrupt>"
                    else
                      ""
                end
            end
      end
  end

(** Claude: [harness_symbol_versions_of_elf64_file f1 bs0 ...] reads the GNU
  * version tables of a dynamically linked file, using the same dynamic-section
  * interpreters as the --dynamic dump.  Any failure (no .dynamic section, no
  * DT_VERSYM, ...) simply yields no version information.
  *)
val harness_symbol_versions_of_elf64_file : elf64_file -> byte_sequence -> (natural -> bool) ->
  (natural -> error tag_correspondence) -> (natural -> error tag_correspondence) ->
  (elf64_dyn -> string_table -> error elf64_dyn_value) ->
  (elf64_dyn -> string_table -> error elf64_dyn_value) -> harness_symbol_versions
let {ocaml} harness_symbol_versions_of_elf64_file f1 bs0 os_additional_ranges os_tag proc_tag os_dyn proc_dyn =
  let endian = get_elf64_header_endianness f1.elf64_file_header in
  let sht    = f1.elf64_file_section_header_table in
  let shared_object = is_elf64_shared_object_file f1.elf64_file_header in
  let res =
    obtain_elf64_dynamic_section_contents f1 os_additional_ranges os_tag proc_tag bs0 >>= fun dyns ->
    get_string_table_of_elf64_dyn_section endian dyns sht bs0 >>= fun stbl ->
    mapM (fun dyn ->
      let tag = naturalFromInteger (integer_of_elf64_sxword dyn.elf64_dyn_tag) in
      get_value_of_elf64_dyn shared_object dyn os_additional_ranges os_dyn proc_dyn stbl >>= fun v ->
      return (tag, v)) dyns >>= fun dyns ->
    obtain_gnu_ext_elf64_interpreted_versym_table f1 dyns
  in
    match res with
      | Success (Just tbl) ->
        let entries = index_map tbl.gnu_ext_interpreted_versym_table_entries in
        let verdefs = tbl.gnu_ext_interpreted_versym_table_verdef in
        let max_vd_ndx = List.foldl (fun m vd ->
          let n = vd.gnu_ext_interpreted_verdef_ndx in if n > m then n else m) 0 verdefs in
          Just (entries, verdefs, tbl.gnu_ext_interpreted_versym_table_verneed, max_vd_ndx)
      | _ -> Nothing
    end

(** Claude: the name of a symbol: for an unnamed section symbol readelf prints
  * the name of the section it refers to.
  *)
val harness_symbol_name : (natural -> maybe string) -> string_table -> natural -> natural -> bool -> natural -> string
let {ocaml} harness_symbol_name section_name strtab st_name symtyp is_special ndx =
  if symtyp = stt_section && (not is_special) && st_name = 0 then
    match section_name ndx with
      | Just n  -> n
      | Nothing -> ""
    end
  else
    match String_table.get_string_at st_name strtab with
      | Fail _    -> "<corrupt>"
      | Success s -> s
    end

val harness_string_of_elf32_symbol_table_entry : natural -> natural -> natural -> (natural -> maybe string) ->
  nat -> string_table -> elf32_symbol_table_entry -> string
let {ocaml} harness_string_of_elf32_symbol_table_entry mach osabi nsections section_name num stbl ent =
  let symtyp = get_elf32_symbol_type ent in
  let other  = natural_of_unsigned_char ent.elf32_st_other in
  let vis    = natural_land other 3 in
  let shndx  = natural_of_elf32_half ent.elf32_st_shndx in
  let (ndx, is_special) = harness_string_of_symbol_ndx mach nsections shndx in
  let nm = harness_symbol_name section_name stbl (natural_of_elf32_word ent.elf32_st_name) symtyp is_special shndx in
    concatS [
      rjust 6 (show num) ^ ": "
    ; unsafe_hex_string_of_natural 8 (natural_of_elf32_addr ent.elf32_st_value)
    ; " " ^ harness_string_of_symbol_size (natural_of_elf32_word ent.elf32_st_size)
    ; " " ^ ljust 7 (harness_string_of_symbol_type mach osabi symtyp)
    ; " " ^ ljust 6 (harness_string_of_symbol_binding osabi (get_elf32_symbol_binding ent))
    ; " " ^ ljust 7 (harness_string_of_symbol_visibility vis)
    ; (if other - vis <> 0 then " [" ^ harness_string_of_symbol_other mach (other - vis) ^ "] " else "")
    ; " " ^ rjust 4 ndx ^ " "
    ; nm
    ]

val harness_string_of_elf64_symbol_table_entry : natural -> natural -> natural -> (natural -> maybe string) ->
  harness_symbol_versions -> nat -> string_table -> elf64_symbol_table_entry -> string
let {ocaml} harness_string_of_elf64_symbol_table_entry mach osabi nsections section_name versions num stbl ent =
  let symtyp = get_elf64_symbol_type ent in
  let other  = natural_of_unsigned_char ent.elf64_st_other in
  let vis    = natural_land other 3 in
  let shndx  = natural_of_elf64_half ent.elf64_st_shndx in
  let (ndx, is_special) = harness_string_of_symbol_ndx mach nsections shndx in
  let nm = harness_symbol_name section_name stbl (natural_of_elf64_word ent.elf64_st_name) symtyp is_special shndx in
    concatS [
      rjust 6 (show num) ^ ": "
    ; unsafe_hex_string_of_natural 16 (natural_of_elf64_addr ent.elf64_st_value)
    ; " " ^ harness_string_of_symbol_size (natural_of_elf64_xword ent.elf64_st_size)
    ; " " ^ ljust 7 (harness_string_of_symbol_type mach osabi symtyp)
    ; " " ^ ljust 6 (harness_string_of_symbol_binding osabi (get_elf64_symbol_binding ent))
    ; " " ^ ljust 7 (harness_string_of_symbol_visibility vis)
    ; (if other - vis <> 0 then " [" ^ harness_string_of_symbol_other mach (other - vis) ^ "] " else "")
    ; " " ^ rjust 4 ndx ^ " "
    ; nm
    ; harness_symbol_version_suffix versions (naturalFromNat num) shndx nm
    ]

(** Claude: [section_name_lookup shtmap shdr] names section [ndx] via the
  * section header string table, for section symbols.
  *)
val harness_elf32_section_name : Map.map natural elf32_section_header_table_entry -> string_table -> natural -> maybe string
let {ocaml} harness_elf32_section_name shtmap shdr ndx =
  match Map.lookup ndx shtmap with
    | Nothing -> Nothing
    | Just sh ->
      match String_table.get_string_at (natural_of_elf32_word sh.elf32_sh_name) shdr with
        | Fail _    -> Nothing
        | Success n -> Just n
      end
  end

val harness_elf64_section_name : Map.map natural elf64_section_header_table_entry -> string_table -> natural -> maybe string
let {ocaml} harness_elf64_section_name shtmap shdr ndx =
  match Map.lookup ndx shtmap with
    | Nothing -> Nothing
    | Just sh ->
      match String_table.get_string_at (natural_of_elf64_word sh.elf64_sh_name) shdr with
        | Fail _    -> Nothing
        | Success n -> Just n
      end
  end

val harness_string_of_elf32_syms' : endianness -> elf32_file -> elf32_section_header_table -> elf32_section_header_table -> string_table -> byte_sequence -> string
let {ocaml} harness_string_of_elf32_syms' endian f1 filtered_sht sht shdr bs0 =
  let hdr   = f1.elf32_file_header in
  let mach  = natural_of_elf32_half hdr.elf32_machine in
  let osabi = get_elf32_osabi hdr in
  let nsections = naturalFromNat (List.length sht) in
  let section_name = harness_elf32_section_name (index_map sht) shdr in
  let rels =
    mapM (fun ent ->
      let off = natural_of_elf32_off  ent.elf32_sh_offset in
      let siz = natural_of_elf32_word ent.elf32_sh_size in
      let lnk = natural_of_elf32_word ent.elf32_sh_link in
        Byte_sequence.offset_and_cut off siz bs0 >>= fun syms ->
        Elf_symbol_table.read_elf32_symbol_table endian syms >>= fun sect ->
        Elf_file.get_elf32_string_table_by_index f1 lnk >>= fun strtab ->
        return (sect, ent, strtab)
    ) filtered_sht >>= fun sects ->
    mapM (fun (syms, ent, strtab) ->
      let nm  = natural_of_elf32_word ent.elf32_sh_name in
      let len = show (List.length syms) ^ " " ^ entries_word (List.length syms) in
      String_table.get_string_at nm shdr >>= fun nm ->
      let hdr = "Symbol table '" ^ nm ^ "' contains " ^ len ^ ":\n" in
      let ttl = "   Num:    Value  Size Type    Bind   Vis      Ndx Name\n" in
      let body = String.concat "\n" (List.mapi (fun n ->
        harness_string_of_elf32_symbol_table_entry mach osabi nsections section_name n strtab) syms)
      in
      return (hdr ^ ttl ^ body)) sects
  in
    match rels with
      | Fail err -> err
      | Success s -> String.concat "\n\n" s
    end

val harness_string_of_elf32_syms : elf32_file -> byte_sequence -> string
let {ocaml} harness_string_of_elf32_syms f1 bs0 =
  let hdr = f1.elf32_file_header in
  let sht = f1.elf32_file_section_header_table in
  let endian = get_elf32_header_endianness hdr in
  let sym_secs = List.filter (fun x ->
    x.elf32_sh_type = elf32_word_of_natural sht_dynsym ||
    x.elf32_sh_type = elf32_word_of_natural sht_symtab) sht
  in
  if List.length sym_secs = 0 then
    "\nThere are no symbols in this file."
  else
    match get_elf32_string_table_by_index f1 (natural_of_elf32_half hdr.elf32_shstrndx) with
      | Fail err     -> err
      | Success shdr -> "\n" ^ harness_string_of_elf32_syms' endian f1 sym_secs sht shdr bs0
    end

val harness_string_of_elf64_syms' : endianness -> elf64_file -> elf64_section_header_table -> elf64_section_header_table -> string_table -> harness_symbol_versions -> byte_sequence -> string
let {ocaml} harness_string_of_elf64_syms' endian f1 filtered_sht sht shdr versions bs0 =
  let hdr   = f1.elf64_file_header in
  let mach  = natural_of_elf64_half hdr.elf64_machine in
  let osabi = get_elf64_osabi hdr in
  let nsections = naturalFromNat (List.length sht) in
  let section_name = harness_elf64_section_name (index_map sht) shdr in
  let rels =
    mapM (fun ent ->
      let off = natural_of_elf64_off  ent.elf64_sh_offset in
      let siz = natural_of_elf64_xword ent.elf64_sh_size in
      let lnk = natural_of_elf64_word ent.elf64_sh_link in
      let typ = natural_of_elf64_word ent.elf64_sh_type in
        Byte_sequence.offset_and_cut off siz bs0 >>= fun syms ->
        Elf_symbol_table.read_elf64_symbol_table endian syms >>= fun sect ->
        Elf_file.get_elf64_string_table_by_index f1 lnk >>= fun strtab ->
        return (sect, ent, strtab, typ)
    ) filtered_sht >>= fun sects ->
    mapM (fun (syms, ent, strtab, typ) ->
      let nm  = natural_of_elf64_word ent.elf64_sh_name in
      let len = show (List.length syms) ^ " " ^ entries_word (List.length syms) in
      (* Claude: readelf annotates versions only in .dynsym *)
      let versions = if typ = sht_dynsym then versions else Nothing in
      String_table.get_string_at nm shdr >>= fun nm ->
      let hdr = "Symbol table '" ^ nm ^ "' contains " ^ len ^ ":\n" in
      let ttl = "   Num:    Value          Size Type    Bind   Vis      Ndx Name\n" in
      let body = String.concat "\n" (List.mapi (fun n ->
        harness_string_of_elf64_symbol_table_entry mach osabi nsections section_name versions n strtab) syms)
      in
      return (hdr ^ ttl ^ body)) sects
  in
    match rels with
      | Fail err -> err
      | Success s -> String.concat "\n\n" s
    end

val harness_string_of_elf64_syms : elf64_file -> byte_sequence -> (natural -> bool) ->
  (natural -> error tag_correspondence) -> (natural -> error tag_correspondence) ->
  (elf64_dyn -> string_table -> error elf64_dyn_value) ->
  (elf64_dyn -> string_table -> error elf64_dyn_value) -> string
let {ocaml} harness_string_of_elf64_syms f1 bs0 os_additional_ranges os_tag proc_tag os_dyn proc_dyn =
  let hdr = f1.elf64_file_header in
  let sht = f1.elf64_file_section_header_table in
  let endian = get_elf64_header_endianness hdr in
  let sym_secs = List.filter (fun x ->
    x.elf64_sh_type = elf64_word_of_natural sht_dynsym ||
    x.elf64_sh_type = elf64_word_of_natural sht_symtab) sht
  in
  if List.length sym_secs = 0 then
    "\nThere are no symbols in this file."
  else
    let has_dynsym = List.any (fun x -> x.elf64_sh_type = elf64_word_of_natural sht_dynsym) sht in
    let versions =
      if has_dynsym then
        harness_symbol_versions_of_elf64_file f1 bs0 os_additional_ranges os_tag proc_tag os_dyn proc_dyn
      else
        Nothing
    in
    match get_elf64_string_table_by_index f1 (natural_of_elf64_half hdr.elf64_shstrndx) with
      | Fail err     -> err
      | Success shdr -> "\n" ^ harness_string_of_elf64_syms' endian f1 sym_secs sht shdr versions bs0
    end


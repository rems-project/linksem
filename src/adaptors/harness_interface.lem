(** Claude: [concatS ss] concatenates a list of strings.  It must be linear in
  * the total length: the relocation and symbol dumps join hundreds of
  * thousands of lines, and the previous left fold with [^] (which copies both
  * operands) made that quadratic, taking minutes on large objects.
  *)
val concatS : list string -> string
let concatS ss = String.concat "" ss

(** Claude: [index_map xs] indexes a list by position so that entries can be
  * found with [Map.lookup] in logarithmic time rather than with the linear
  * [List.index].  Used for symbol tables and section header tables that are
  * consulted once per relocation.
  *)
val index_map : forall 'a. list 'a -> Map.map natural 'a
let index_map xs =
  Map.fromList (List.mapi (fun i -> fun x -> (naturalFromNat i, x)) xs)

(** Claude: [entries_word n] is "entry" or "entries" as readelf chooses it for a
  * table of [n] entries.
  *)
val entries_word : nat -> string
let entries_word n =
  if n = 1 then "entry" else "entries"

(** Claude: [there_are n noun] is readelf's "There is 1 <noun>" or "There are
  * N <noun>s" for the preambles of the program and section header dumps. *)
val there_are : nat -> string -> string
let there_are n noun =
  if n = 1 then "There is 1 " ^ noun else "There are " ^ show n ^ " " ^ noun ^ "s"

(** Claude: the "Section Headers:" title, singular for one section header. *)
(** Claude: what readelf [-s] prints for a file with no symbol table: nothing
  * when the file has section headers, and a note that the dynamic symbol
  * information (which readelf would otherwise reconstruct from the segments)
  * is unavailable when it has none, as in a core file. *)
val no_symbols_message : nat -> string
let no_symbols_message nsections =
  if nsections = 0 then "\nDynamic symbol information is not available for displaying symbols." else ""

val section_headers_title : nat -> string
let section_headers_title n =
  if n = 1 then "Section Header:" else "Section Headers:"

val harness_string_of_elf32_file_header : elf32_header -> string
let {ocaml} harness_string_of_elf32_file_header hdr =
  unlines [
    "ELF Header:"
  ; "  Magic:" ^ "   "                           ^ unsafe_hex_string_of_uc_list (hdr.elf32_ident)
  ; "  Class:" ^ "                             " ^ string_of_elf_file_class (get_elf32_file_class hdr)
  ; "  Data:" ^ "                              " ^ string_of_elf_data_encoding (get_elf32_data_encoding hdr)
  ; "  Version:" ^ "                           " ^ string_of_elf_version_number (get_elf32_version_number hdr)
  ; "  OS/ABI:" ^ "                            " ^ string_of_elf_osabi_version (const "Architecture defined") (get_elf32_osabi hdr)
  ; "  ABI Version:" ^ "                       " ^ show (get_elf32_abi_version hdr)
  ; "  Type:" ^ "                              " ^ string_of_elf_file_type default_os_specific_print default_proc_specific_print (natural_of_elf32_half hdr.elf32_type)
  ; "  Machine:" ^ "                           " ^ string_of_elf_machine_architecture (natural_of_elf32_half hdr.elf32_machine)
  ; "  Version:" ^ "                           " ^ "0x" ^ unsafe_hex_string_of_natural 1 (natural_of_elf32_word hdr.elf32_version)
  ; "  Entry point address:" ^ "               " ^ "0x" ^ unsafe_hex_string_of_natural 1 (natural_of_elf32_addr hdr.elf32_entry)
  ; "  Start of program headers:" ^ "          " ^ show hdr.elf32_phoff ^ " (bytes into file)"
  ; "  Start of section headers:" ^ "          " ^ show hdr.elf32_shoff ^ " (bytes into file)"
  ; "  Flags:" ^ "                             " ^ "0x" ^ unsafe_hex_string_of_natural 1 (natural_of_elf32_word hdr.elf32_flags)
  ; "  Size of this header:" ^ "               " ^ show hdr.elf32_ehsize ^ " (bytes)"
  ; "  Size of program headers:" ^ "           " ^ show hdr.elf32_phentsize ^ " (bytes)"
  ; "  Number of program headers:" ^ "         " ^ show hdr.elf32_phnum
  ; "  Size of section headers:" ^ "           " ^ show hdr.elf32_shentsize ^ " (bytes)"
  ; "  Number of section headers:" ^ "         " ^ show hdr.elf32_shnum
  ; "  Section header string table index:" ^ " " ^ show hdr.elf32_shstrndx
  ]


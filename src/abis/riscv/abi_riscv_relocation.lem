val string_of_riscv_relocation_type : natural -> string
let string_of_riscv_relocation_type rel_type =
  match List.lookup rel_type riscv_relocation_type_names with
    | Just name -> name
    | Nothing   -> string_of_unrecognized_relocation_type rel_type
  end

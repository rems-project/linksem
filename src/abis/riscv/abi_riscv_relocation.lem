    (21, "R_RISCV_TLS_GOT_HI20");
    (22, "R_RISCV_TLS_GD_HI20");
    (23, "R_RISCV_PCREL_HI20");
    (24, "R_RISCV_PCREL_LO12_I");
    (25, "R_RISCV_PCREL_LO12_S");
    (26, "R_RISCV_HI20");
    (27, "R_RISCV_LO12_I");
    (28, "R_RISCV_LO12_S");
    (29, "R_RISCV_TPREL_HI20");
    (30, "R_RISCV_TPREL_LO12_I");
    (31, "R_RISCV_TPREL_LO12_S");
    (32, "R_RISCV_TPREL_ADD");
    (33, "R_RISCV_ADD8");
    (34, "R_RISCV_ADD16");

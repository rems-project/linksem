(** Claude: the relocation type names as readelf prints them (checked against
  * readelf on a generated object carrying every type), and the printer that
  * uses them with readelf's "unrecognized: N" for anything else. *)
val riscv_relocation_type_names : list (natural * string)
let riscv_relocation_type_names = [
    (0, "R_RISCV_NONE");
    (1, "R_RISCV_32");
    (2, "R_RISCV_64");
    (3, "R_RISCV_RELATIVE");
    (4, "R_RISCV_COPY");
    (5, "R_RISCV_JUMP_SLOT");
    (6, "R_RISCV_TLS_DTPMOD32");
    (7, "R_RISCV_TLS_DTPMOD64");
    (8, "R_RISCV_TLS_DTPREL32");
    (9, "R_RISCV_TLS_DTPREL64");
    (10, "R_RISCV_TLS_TPREL32");
    (11, "R_RISCV_TLS_TPREL64");
    (16, "R_RISCV_BRANCH");
    (17, "R_RISCV_JAL");

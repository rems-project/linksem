let r_ppc64_addr32 : natural = 1
let r_ppc64_addr24 : natural = 2
let r_ppc64_addr16 : natural = 3
let r_ppc64_addr16_lo : natural = 4
let r_ppc64_addr16_hi : natural = 5
let r_ppc64_addr16_ha : natural = 6

open import Num
open import Maybe

open import Error

open import Abi_utilities

open import Elf_types_native_uint
open import Elf_symbol_table
open import Elf_symbolic


type relocation_description 'res 'tar =
  <| rel_desc_operation : (relocation_operator_expression 'res)
   ; rel_desc_range     : maybe (integer * integer)
   ; rel_desc_mask      : (natural * natural)
   ; rel_desc_target    : 'tar
   |>

   

let rec eval_op_exp op: error symbolic_expression =
  match op with
    | Lift x -> return x
    | Plus (x, y) ->
        eval_op_exp x >>= fun a ->
        eval_op_exp y >>= fun b ->
        return (BinOp (a, Add, b))
    | Minus (x, y) ->
        eval_op_exp x >>= fun a ->
        eval_op_exp y >>= fun b ->
        return (BinOp (a, Sub, b))
    | Apply(Page, x) ->
        eval_op_exp x >>= fun a ->
        return (BinOp (a, And, UnOp (Not, Const 4095 (*0xFFF*))))
    | _ -> fail "Not supported"
  end


let eval_relocation desc =
  let (hi, lo) = desc.rel_desc_mask in
  
  eval_op_exp desc.rel_desc_operation >>= fun value ->
    match desc.rel_desc_range with
    | Just (min, max) -> return (AssertRange(value, min, max))
    | Nothing -> return value
    end
  >>= fun value ->
    return <| arel_value = Mask(value, hi, lo) ; arel_target = desc.rel_desc_target |>

